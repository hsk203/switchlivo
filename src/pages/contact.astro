---
import PageHeader from "@/components/PageHeader.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

const entry = (await getEntry(
  "contact",
  "-index"
)) as CollectionEntry<"contact">;
const { contact_form_action } = config.params;
const contact = entry.data;
const page_data = {
  ...contact,
  content: entry.body,
};
---

<Base
  title={contact.title}
  meta_title={contact.meta_title}
  description={contact.description}
  image={contact.image}
>
  <section class="page-hero pb-6 pt-16">
    <div class="container">
      <PageHeader page_data={page_data} />
    </div>
  </section>

  <section class="section pt-0">
    <div class="container">
      <div class="row">
        <div class="mb-10 text-center md:col-6 md:order-2 md:mb-0 md:pt-9">
          <div class="contact-img relative inline-flex pb-5 pl-5">
            <Image
              src="/images/contact-img.png"
              height={544}
              width={500}
              alt=""
            />
            <Image
              class="absolute bottom-0 left-0 -z-[1] h-14 w-14"
              src="/images/shape-2.png"
              alt=""
              height={56}
              width={56}
            />
          </div>
        </div>
        <div class="md:col-6 md:order-1">
          <form
            id="inquiry-form"
            class="lg:max-w-[484px]"
            action="/api/contact"
            method="POST"
          >
            <div class="form-group mb-5">
              <label class="form-label" for="name">Full Name</label>
              <input
                class="form-control"
                type="text"
                id="name"
                name="name"
                placeholder="Your Full Name"
                required
              />
            </div>
            <div class="form-group mb-5">
              <label class="form-label" for="company">Company</label>
              <input
                class="form-control"
                type="text"
                id="company"
                name="company"
                placeholder="Your Company (optional)"
              />
            </div>
            <div class="form-group mb-5">
              <label class="form-label" for="email">Email Address</label>
              <input
                class="form-control"
                type="email"
                id="email"
                name="email"
                placeholder="Your Email Address"
                required
              />
            </div>
            <div class="form-group mb-5">
              <label class="form-label" for="country">Country</label>
              <input
                class="form-control"
                type="text"
                id="country"
                name="country"
                placeholder="Your Country (optional)"
              />
            </div>
            <div class="form-group mb-5">
              <label class="form-label" for="reason">Reason / Purpose</label>
              <select name="reason" id="reason" class="form-select" required>
                <option value="">Select reason / purpose</option>
                <option value="product-inquiry">Product Inquiry</option>
                <option value="oem-odm">OEM &amp; ODM Cooperation</option>
                <option value="distributor">Become a Distributor</option>
                <option value="technical-support">Technical Support</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="form-group mb-5">
              <label class="form-label" for="message">Message</label>
              <textarea
                class="form-control"
                id="message"
                name="message"
                cols="30"
                rows="6"
                placeholder="Tell us what you need…"
                required></textarea>
            </div>

            <!-- Honeypot: hidden from humans, bots may fill it -->
            <div
              aria-hidden="true"
              style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;"
            >
              <label>Company URL</label>
              <input
                type="text"
                name="company_url"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <input type="hidden" id="renderedAt" name="renderedAt" value="0" />

            <div
              class="cf-turnstile mb-5"
              data-sitekey="0x4AAAAAAFeqY4W78ECxRn0K"
              data-theme="light"
            ></div>

            <input
              class="btn btn-primary block w-full"
              type="submit"
              value="Send Message"
            />
            <p id="form-status" class="mt-4 text-sm" role="status"></p>
          </form>

          <noscript>
            <p class="mt-3 text-sm text-gray-500">
              Please enable JavaScript to use the contact form (spam protection
              requires it).
            </p>
          </noscript>

          <script
            is:inline
            src="https://challenges.cloudflare.com/turnstile/v0/api.js"
            async
            defer></script>
          <script is:inline>
            (function () {
              var form = document.getElementById("inquiry-form");
              if (!form) return;
              var rendered = document.getElementById("renderedAt");
              if (rendered) rendered.value = String(Date.now());
              var status = document.getElementById("form-status");
              function val(n) {
                var el = form.querySelector('[name="' + n + '"]');
                return el ? el.value : "";
              }
              form.addEventListener("submit", function (e) {
                e.preventDefault();
                var btn = form.querySelector(
                  'button[type="submit"], input[type="submit"]'
                );
                if (btn) btn.disabled = true;
                if (status) {
                  status.textContent = "Sending…";
                  status.className = "mt-4 text-sm text-gray-500";
                }
                var data = {
                  name: val("name"),
                  company: val("company"),
                  email: val("email"),
                  country: val("country"),
                  reason: val("reason"),
                  message: val("message"),
                  renderedAt: rendered ? rendered.value : "0",
                  "cf-turnstile-response": val("cf-turnstile-response"),
                  company_url: val("company_url"),
                };
                fetch("/api/contact", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify(data),
                })
                  .then(function (r) {
                    return r.json().then(function (j) {
                      return { ok: r.ok, j: j };
                    });
                  })
                  .then(function (res) {
                    if (res.ok && res.j && res.j.success) {
                      if (status) {
                        status.textContent =
                          "Thank you! Your message has been received.";
                        status.className = "mt-4 text-sm text-green-600";
                      }
                      form.reset();
                      if (window.turnstile) window.turnstile.reset();
                      if (rendered) rendered.value = String(Date.now());
                    } else {
                      if (status) {
                        status.textContent =
                          (res.j && res.j.msg) ||
                          "Something went wrong. Please try again.";
                        status.className = "mt-4 text-sm text-red-600";
                      }
                    }
                  })
                  .catch(function () {
                    if (status) {
                      status.textContent =
                        "Network error. Please try again.";
                      status.className = "mt-4 text-sm text-red-600";
                    }
                  })
                  .finally(function () {
                    if (btn) btn.disabled = false;
                  });
              });
            })();
          </script>
        </div>
      </div>
    </div>
  </section>
</Base>
