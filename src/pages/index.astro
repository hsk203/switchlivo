---
import Base from "@/layouts/Base.astro";
import Banner from "@/layouts/components/Banner.astro";
import SolutionPlatform from "@/layouts/components/SolutionPlatform.astro";
import Ecosystem from "@/layouts/components/Ecosystem.astro";
import HomeEcosystemIntro from "@/layouts/components/home/HomeEcosystemIntro.astro";
import HomeOemOdm from "@/layouts/components/home/HomeOemOdm.astro";
import HomeTrustStrip from "@/layouts/components/home/HomeTrustStrip.astro";
import HomeProductShowcase from "@/layouts/components/home/HomeProductShowcase.astro";
import HomeApplications from "@/layouts/components/home/HomeApplications.astro";
import HomeWhy from "@/layouts/components/home/HomeWhy.astro";
import HomeProcess from "@/layouts/components/home/HomeProcess.astro";
import HomeProofCta from "@/layouts/components/home/HomeProofCta.astro";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

const homepage = (await getEntry(
  "homepage",
  "-index"
)) as CollectionEntry<"homepage">;
const { banner } = homepage.data;
---

<Base
  title="Switchlivo — Smart Home, Smart Hotel & Smart Lighting OEM/ODM Manufacturer"
  showFooterIntro={false}
>
  <Banner banner={banner} />
  <SolutionPlatform />
  <Ecosystem />
  <HomeEcosystemIntro />
  <HomeOemOdm />
  <HomeTrustStrip />
  <HomeProductShowcase />
  <HomeApplications />
  <HomeWhy />
  <HomeProcess />
  <HomeProofCta />
</Base>
