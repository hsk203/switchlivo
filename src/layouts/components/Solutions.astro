---
// Solutions page content — visual language faithfully mirrors the hongyan
// case.html design: full-bleed photo hero slider (huge white title + translucent
// accent button + arrows), a floating pain-phrase cloud on a dark photo,
// center-product-with-side-annotations subsystem layout, square-corner
// interaction cards, and a flush tab bar with full-bleed room scenes.
// Accent = brand orange #FE6019 (hongyan uses green #009d85).
import config from "@/config/config.json";

const { email, phone } = config.params;
const phonePretty = "+852 6419 0941";

const slides = [
  { img: "/images/solutions/photos/hero.jpg" },
  { img: "/images/solutions/photos/kitchen.jpg" },
  { img: "/images/solutions/photos/bedroom.jpg" },
];

// pain cloud — sizes & opacities alternate like hongyan's s2 phrase wall
const pains = [
  { t: "Protocols that don't talk to each other", c: "px" },
  { t: "Long customization lead times", c: "p1" },
  { t: "Inconsistent quality between batches", c: "p2" },
  { t: "No firmware or OTA support after shipment", c: "p4" },
  { t: "Certification gaps blocking market entry", c: "p1" },
  { t: "High MOQs that lock out smaller brands", c: "p3" },
  { t: "After-sales burden falling on your team", c: "p1" },
  { t: "Look-alike panels, uneven performance", c: "p5" },
  { t: "No white-label or ODM service", c: "p2" },
  { t: "Slow, hard-to-reach supplier support", c: "p3" },
  { t: "Unclear roadmap for Matter & new standards", c: "p6" },
  { t: "Energy data you can't act on", c: "p1" },
];

const subsystemsLeft = [
  {
    h: "Security Monitoring",
    p: "Video surveillance with whole-home arming; intrusion and anomaly alerts with one-touch emergency call.",
  },
  {
    h: "Healthy Environment",
    p: "Temperature, humidity, PM2.5 and VOC link AC, fresh air, purifiers and floor heating to optimize the indoors.",
  },
  {
    h: "Energy Management",
    p: "Household energy monitoring with remote appliance control for a safer, clearer power bill.",
  },
  {
    h: "Smart Lighting",
    p: "Remote and voice control, stepless dimming and color tuning, scene management, adaptive brightness.",
  },
];
const subsystemsRight = [
  {
    h: "AV & Entertainment",
    p: "One-touch movie mode: curtains close, lights fade with the TV — a private cinema at home.",
  },
  {
    h: "Smart Water",
    p: "Central purification, antibacterial lines, safe drinking and smart leak protection for every scene.",
  },
  {
    h: "Home Management",
    p: "Health, energy and environment management systems that quietly lift everyday living.",
  },
  {
    h: "Central Management Hub",
    p: "One integrated smart central control connecting and commanding every subsystem in the home.",
  },
];

const interactions = [
  {
    h: "Near Interaction",
    p: "Smart panels as the control terminal — keys and touch run whole-home scenes like wake, sleep, host and away, plus single-device control at close range.",
    icon: "M4 7h16M4 12h16M4 17h10",
  },
  {
    h: "Mid Interaction",
    p: "Voice panels and assistant speakers link into precise mid-range voice control of lights, curtains and appliances across the home.",
    icon: "M12 3a3 3 0 0 0-3 3v5a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zM5 11a7 7 0 0 0 14 0M12 18v3",
  },
  {
    h: "Far Interaction",
    p: "Away from home, manage every system from the phone app — locks, AC, lights — receive alerts, make video calls, and check home status in real time.",
    icon: "M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM11 18h2",
  },
];

const scenarios = [
  {
    key: "entry",
    tab: "Smart Entryway",
    tabIcon: "M6 21V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v17M4 21h16M15 12h.01",
    title: "Walk in, leave the stress at the door —\nenjoy the warmth of home.",
    chips: [
      { label: "Home Mode", text: "Smart lock senses the door opening: lights on, security disarmed, fresh air and AC start" },
      { label: "Away Mode", text: "One tap switches off all lights and appliances, auto-arms security, closes the windows" },
      { label: "Video Intercom", text: "Central screen connects to the door station — see visitors, talk, and grant access" },
      { label: "Home Services", text: "Cleaning bookings, maintenance visits and parcel access, all from the entry panel" },
    ],
  },
  {
    key: "kitchen",
    tab: "Smart Kitchen",
    tabIcon: "M4 10h16M6 10V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3M3 10v2a5 5 0 0 0 5 5h8a5 5 0 0 0 5-5v-2M9 20h6",
    title: "Hidden risks removed —\ncooking becomes a pleasure.",
    chips: [
      { label: "Voice Interaction", text: "Lights, hood and appliances respond without touching anything" },
      { label: "Life Services", text: "Fresh grocery ordering and ready-meal delivery via the panel" },
      { label: "Smart Water", text: "Purified, monitored water for cooking and drinking" },
      { label: "Leak & Smoke", text: "Water-leak and smoke detection with instant phone alerts" },
    ],
  },
  {
    key: "dining",
    tab: "Smart Dining",
    tabIcon: "M7 3v6a2 2 0 0 0 4 0V3M9 11v10M17 3c-1.5 2-1.5 5 0 7v11",
    title: "Warm, romantic scenes —\nan elegant dinner at home.",
    chips: [
      { label: "Voice Interaction", text: "Scenes change hands-free while you host" },
      { label: "Smart Lighting", text: "Dinner, party and candlelight presets in one tap" },
      { label: "Comfort Environment", text: "Air quality and climate auto-tuned to the room, linked with fresh air and AC" },
    ],
  },
  {
    key: "living",
    tab: "Smart Living Room",
    tabIcon: "M5 11V8a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v3M4 11a2 2 0 0 1 2 2v2h12v-2a2 2 0 1 1 4 0v5H2v-5a2 2 0 0 1 2-2zM6 20v1M18 20v1",
    title: "Voice, touch and phone —\na living room that responds.",
    chips: [
      { label: "AI Hosting", text: "Guest scene welcomes visitors with light, music and climate" },
      { label: "Cozy AV", text: "Movie mode: curtains close, lights fade as the TV starts" },
      { label: "Healthy Environment", text: "Air and temperature tuned to the moment" },
      { label: "Energy Management", text: "Standby power trimmed intelligently, comfort untouched" },
    ],
  },
  {
    key: "bedroom",
    tab: "Smart Bedroom",
    tabIcon: "M3 18v-7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v7M3 14h18M7 9V6h10v3",
    title: "One tap to sleep, one tap to rise —\na good night built into the walls.",
    chips: [
      { label: "Sleep Mode", text: "Curtains and lights close, security arms, energy shifts to night duty" },
      { label: "Morning Mode", text: "Curtains open, security disarms, the day's weather plays softly" },
      { label: "Human-centric Light", text: "A warm wake-up glow instead of a blaring alarm" },
      { label: "Safety Management", text: "Security and climate stay on guard through the night" },
    ],
  },
  {
    key: "bathroom",
    tab: "Smart Bathroom",
    tabIcon: "M4 12h16v2a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5v-2zM6 12V5a2 2 0 0 1 4 0M8 21l-1 1M17 21l1 1",
    title: "From grooming to comfort —\na brand-new bathing experience.",
    chips: [
      { label: "Voice Control", text: "Lights, mirror and ventilation respond hands-free" },
      { label: "Safety Protection", text: "Leak, humidity and overheating watched around the clock" },
      { label: "Remote Control", text: "Pre-heat the bathroom before you're even home" },
      { label: "Healthy Living", text: "Fresh air and comfort managed automatically" },
    ],
  },
];
---

<section class="hy" id="solutions">
  <!-- HERO SLIDER (full-bleed) -->
  <div class="hy-hero">
    {
      slides.map((s, i) => (
        <div class:list={["hy-slide", i === 0 && "on"]}>
          <div class="hy-slide-bg" style={`background-image:url('${s.img}')`} />
          <div class="hy-slide-shade" />
        </div>
      ))
    }
    <div class="hy-hero-main">
      <h1 class="hy-hero-title">Whole-Home Smart Solutions</h1>
      <a href="/contact" class="hy-hero-btn">Customize Now</a>
    </div>
    <button class="hy-arrow prev" type="button" aria-label="Previous slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button class="hy-arrow next" type="button" aria-label="Next slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 5l7 7-7 7" /></svg>
    </button>
    <div class="hy-dots">
      {slides.map((_, i) => <span class:list={["hy-dot", i === 0 && "on"]} data-dot={i} />)}
    </div>
  </div>

  <!-- PAIN CLOUD (full-bleed dark photo) -->
  <div class="hy-pain">
    <div class="hy-pain-shade" />
    <div class="hy-wrap">
      <div class="hy-pain-cloud">
        {pains.map((p) => <span class:list={["p", p.c]}>{p.t}</span>)}
      </div>
      <div class="hy-pain-note">
        <p>
          Sound familiar? <a href="/contact">Talk to our OEM &amp; ODM team</a> —
          {email} · {phonePretty}
        </p>
      </div>
    </div>
  </div>

  <!-- SUBSYSTEMS: center product + side annotations (light) -->
  <div class="hy-sys">
    <div class="hy-wrap">
      <h2 class="hy-tit hy-tit--lg">Eight Systems, One Ecosystem</h2>
      <p class="hy-tit-sub">
        Smart panels as the control terminal — every subsystem interoperates,
        and every piece can be customized for your brand.
      </p>
      <div class="hy-sys-grid">
        <div class="hy-sys-col hy-sys-col--l">
          {
            subsystemsLeft.map((it) => (
              <div class="hy-sys-item">
                <div class="txt1">
                  <div class="h">{it.h}</div>
                  <div class="p">{it.p}</div>
                </div>
              </div>
            ))
          }
        </div>
        <div class="hy-sys-center">
          <span class="hy-ring hy-ring--1" aria-hidden="true" />
          <span class="hy-ring hy-ring--2" aria-hidden="true" />
          <img
            src="https://cdn.switchlivo.com/products/x10-1-gang-smart-light-switch.webp?v=2"
            alt="Switchlivo smart panel"
            loading="lazy"
          />
        </div>
        <div class="hy-sys-col hy-sys-col--r">
          {
            subsystemsRight.map((it) => (
              <div class="hy-sys-item">
                <div class="txt1">
                  <div class="h">{it.h}</div>
                  <div class="p">{it.p}</div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- INTERACTION: square-corner cards, image top / text below -->
  <div class="hy-inter">
    <div class="hy-wrap">
      <h2 class="hy-tit">Immersive Multi-Mode Interaction</h2>
      <div class="hy-inter-grid">
        {
          interactions.map((t) => (
            <div class="hy-inter-card">
              <div class="pic">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d={t.icon} />
                </svg>
              </div>
              <div class="txt">
                <div class="h">{t.h}</div>
                <div class="p">{t.p}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- SCENARIOS: flush tab bar + full-bleed scene -->
  <div class="hy-scn">
    <div class="hy-wrap">
      <h2 class="hy-tit">Whole-Home Scenarios</h2>
    </div>

    <div class="hy-tabs" role="tablist" aria-label="Room scenarios">
      {
        scenarios.map((s, i) => (
          <button
            type="button"
            class:list={["hy-tab", i === 0 && "on"]}
            data-tab={s.key}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d={s.tabIcon} />
            </svg>
            <span>{s.tab}</span>
          </button>
        ))
      }
    </div>

    <div class="hy-panels">
      {
        scenarios.map((s, i) => (
          <article
            class:list={["hy-panel", i === 0 && "on"]}
            data-panel={s.key}
            role="tabpanel"
          >
            <div
              class="hy-panel-bg"
              style={`background-image:url('/images/solutions/photos/${s.key}.jpg')`}
              aria-hidden="true"
            />
            <div class="hy-panel-shade" aria-hidden="true" />
            <div class="hy-wrap">
              <div class="hy-panel-content">
                <span class="hy-panel-eyebrow">/ Smart Home /</span>
                <h3 class="hy-panel-title">
                  {s.title.split("\n").map((line, j) => (
                    <>
                      {j > 0 && <br />}
                      {line}
                    </>
                  ))}
                </h3>
                <ul class="hy-chips">
                  {s.chips.map((c) => (
                    <li>
                      <span class="tag">{c.label}</span>
                      <span class="tx">{c.text}</span>
                    </li>
                  ))}
                </ul>
                <div class="hy-tier-pills">
                  <span>Essential</span>
                  <span>Pro</span>
                </div>
              </div>
            </div>
            <a class="hy-panel-cta" href="/products">
              <span class="ic">▶</span> Explore Products
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hy {
    --acc: #fe6019;
    --acc-soft: rgba(254, 96, 25, 0.85);
    background: #fff;
  }
  .hy-wrap {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 30px;
  }

  /* ---------- HERO SLIDER ---------- */
  .hy-hero {
    position: relative;
    height: clamp(520px, 74vh, 780px);
    overflow: hidden;
    background: #101418;
  }
  .hy-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .hy-slide.on {
    opacity: 1;
  }
  .hy-slide-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .hy-slide-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 13, 17, 0.16), rgba(10, 13, 17, 0.3));
  }
  .hy-hero-main {
    position: absolute;
    left: 50%;
    top: 53%;
    transform: translate(-50%, -50%);
    z-index: 3;
    display: flex;
    align-items: center;
    flex-direction: column;
    text-align: center;
    width: 100%;
    padding: 0 20px;
  }
  .hy-hero-title {
    font-size: clamp(38px, 6.6vw, 80px);
    font-weight: 700;
    color: #fff;
    text-shadow: 2px 4px 7.6px rgba(84, 88, 97, 0.5);
    margin: 0 0 56px;
    line-height: 1.15;
  }
  .hy-hero-btn {
    font-size: 18px;
    color: #fff;
    text-decoration: none;
    border-radius: 10px;
    padding: 16px 56px;
    background: var(--acc-soft);
    transition: background 0.25s ease, transform 0.25s ease;
  }
  .hy-hero-btn:hover {
    background: var(--acc);
    color: #fff;
    transform: translateY(-2px);
  }
  .hy-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }
  .hy-arrow:hover {
    background: rgba(255, 255, 255, 0.34);
  }
  .hy-arrow svg {
    width: 22px;
    height: 22px;
  }
  .hy-arrow.prev {
    left: 34px;
  }
  .hy-arrow.next {
    right: 34px;
  }
  .hy-dots {
    position: absolute;
    left: 50%;
    bottom: 26px;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    gap: 10px;
  }
  .hy-dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .hy-dot.on {
    width: 28px;
    background: var(--acc);
  }

  /* ---------- PAIN CLOUD ---------- */
  .hy-pain {
    position: relative;
    overflow: hidden;
    background: url("/images/solutions/photos/living.jpg") center / cover no-repeat;
    padding: 120px 0 100px;
  }
  .hy-pain-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 13, 17, 0.88), rgba(10, 13, 17, 0.8));
  }
  .hy-pain .hy-wrap {
    z-index: 1;
  }
  .hy-pain-cloud {
    max-width: 1150px;
    margin: 0 auto;
    text-align: justify;
    line-height: 1.9;
  }
  .hy-pain-cloud .p {
    display: inline-block;
    color: #fff;
    margin: 0 34px 24px 0;
    white-space: nowrap;
  }
  .hy-pain-cloud .px { font-size: 34px; color: rgba(255, 255, 255, 0.95); }
  .hy-pain-cloud .p1 { font-size: 24px; color: rgba(255, 255, 255, 0.55); }
  .hy-pain-cloud .p2 { font-size: 24px; color: rgba(255, 255, 255, 0.35); }
  .hy-pain-cloud .p3 { font-size: 24px; color: rgba(255, 255, 255, 0.22); }
  .hy-pain-cloud .p4 { font-size: 48px; color: #f6f8fc; font-weight: 700; }
  .hy-pain-cloud .p5 { font-size: 34px; color: #f6f8fc; }
  .hy-pain-cloud .p6 { font-size: 38px; color: #f6f8fc; }
  .hy-pain-note {
    margin-top: 64px;
    text-align: center;
  }
  .hy-pain-note p {
    margin: 0;
    color: rgba(255, 255, 255, 0.75);
    font-size: 16px;
  }
  .hy-pain-note a {
    color: #ffb347;
    font-weight: 600;
  }

  /* ---------- SECTION TITLES ---------- */
  .hy-tit {
    font-size: 36px;
    color: #222;
    line-height: 46px;
    text-align: center;
    margin: 0 0 45px;
  }
  .hy-tit--lg {
    font-size: 42px;
    line-height: 52px;
    padding-top: 90px;
    margin-bottom: 20px;
  }
  .hy-tit-sub {
    text-align: center;
    color: #555;
    font-size: 17px;
    line-height: 28px;
    margin: 0 auto 70px;
    max-width: 760px;
  }

  /* ---------- SUBSYSTEMS ---------- */
  .hy-sys {
    background:
      radial-gradient(ellipse 62% 55% at 50% 52%, rgba(254, 96, 25, 0.07), transparent 70%),
      linear-gradient(180deg, #fbf6f2 0%, #f7ede5 100%);
    padding-bottom: 100px;
  }
  .hy-sys-grid {
    display: grid;
    grid-template-columns: 1fr 460px 1fr;
    gap: 44px;
    align-items: center;
  }
  .hy-sys-col--l {
    text-align: right;
  }
  .hy-sys-item {
    margin-bottom: 46px;
  }
  .hy-sys-item .h {
    font-size: 22px;
    color: #222;
    font-weight: 700;
    margin-bottom: 10px;
    transition: color 0.25s ease;
  }
  .hy-sys-item:hover .h {
    color: var(--acc);
  }
  .hy-sys-item .p {
    font-size: 15px;
    color: #555;
    line-height: 1.75;
  }
  .hy-sys-center {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 420px;
  }
  .hy-sys-center::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 430px;
    height: 430px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(254, 96, 25, 0.14) 0%, rgba(254, 96, 25, 0.05) 55%, transparent 72%);
  }
  .hy-sys-center img {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 340px;
    mix-blend-mode: multiply;
  }
  .hy-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    border: 1px dashed rgba(254, 96, 25, 0.35);
    border-radius: 50%;
  }
  .hy-ring--1 {
    width: 380px;
    height: 380px;
  }
  .hy-ring--2 {
    width: 500px;
    height: 500px;
    border-color: rgba(254, 96, 25, 0.18);
  }

  /* ---------- INTERACTION ---------- */
  .hy-inter {
    padding: 90px 0 100px;
  }
  .hy-inter-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  .hy-inter-card {
    border: 1px solid #ececec;
    background: #fff;
  }
  .hy-inter-card .pic {
    aspect-ratio: 4 / 3;
    background: #f6f6f6;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--acc);
    overflow: hidden;
  }
  .hy-inter-card .pic svg {
    width: 84px;
    height: 84px;
    transition: transform 0.3s ease;
  }
  .hy-inter-card:hover .pic svg {
    transform: scale(1.12);
  }
  .hy-inter-card .txt {
    padding: 26px 24px 30px;
  }
  .hy-inter-card .h {
    font-size: 24px;
    color: #222;
    margin-bottom: 14px;
    transition: color 0.25s ease;
  }
  .hy-inter-card:hover .h {
    color: var(--acc);
  }
  .hy-inter-card .p {
    font-size: 15px;
    color: #555;
    line-height: 1.9;
    margin: 0;
  }

  /* ---------- SCENARIOS ---------- */
  .hy-scn .hy-wrap .hy-tit {
    padding-top: 90px;
    margin-bottom: 40px;
  }
  .hy-tabs {
    display: flex;
    width: 100%;
    border-top: 1px solid #eee;
    background: #fff;
  }
  .hy-tab {
    flex: 1 1 0;
    min-height: 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #fff;
    border: 0;
    border-right: 1px solid #f0f0f0;
    color: #666;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 12px 8px;
  }
  .hy-tab:last-child {
    border-right: 0;
  }
  .hy-tab svg {
    width: 30px;
    height: 30px;
  }
  .hy-tab:hover {
    color: var(--acc);
  }
  .hy-tab.on {
    background: var(--acc);
    color: #fff;
  }
