---
const applications = [
  { no: "01", title: "Smart Home", desc: "Bring lighting, curtains, climate and everyday routines together through a consistent wall-control experience.", img: "/images/solutions/residential.webp", alt: "Contemporary residential smart home interior", tags: ["Whole-home control", "Room scenes", "Retrofit & new build"] },
  { no: "02", title: "Smart Hotel", desc: "Create intuitive guest-room controls for lighting, climate, curtains and hospitality functions across room types.", img: "/images/solutions/hotel.webp", alt: "Contemporary hotel room with integrated wall controls", tags: ["Guest-room control", "DND & housekeeping", "Room standardization"] },
  { no: "03", title: "Commercial & Office", desc: "Simplify shared-space operation with coordinated lighting and scene control for offices and meeting rooms.", img: "/images/solutions/office.webp", alt: "Modern commercial office interior", tags: ["Meeting scenes", "Shared spaces", "Centralized operation"] },
];
const systems = [
  ["Smart Lighting", "Switching, dimming and scene control for comfortable, flexible spaces."],
  ["Climate Control", "Coordinate compatible air-conditioning and comfort devices from the wall."],
  ["Curtains & Shading", "Bring compatible curtain motors into daily routines and room scenes."],
  ["Hotel Functions", "Support guest-room functions such as DND and housekeeping where configured."],
  ["Security & Sensors", "Connect supported sensors and security devices for clearer status and alerts."],
  ["Centralized Control", "Combine supported functions in one consistent panel experience."],
];
const roomImageSrc = (key, width = 1600) => `/images/solutions/room-${key}-${width}-v3.webp`;
const roomImageSrcset = (key) => [960, 1280, 1600, 2200].map((width) => `${roomImageSrc(key, width)} ${width}w`).join(", ");
const rooms = [
  { key: "living", label: "Living Room", title: "A more considered way to live.", img: roomImageSrc("living"), srcset: roomImageSrcset("living"), points: ["Set the mood with lighting scenes", "Coordinate curtains and climate", "Keep everyday controls close at hand"] },
  { key: "bedroom", label: "Bedroom", title: "Comfort, from one bedside touch.", img: roomImageSrc("bedroom"), srcset: roomImageSrcset("bedroom"), points: ["Create sleep and wake-up routines", "Control bedside and ambient lighting", "Simplify daily operation"] },
  { key: "hotel", label: "Hotel Room", title: "A consistent guest-room experience.", img: roomImageSrc("hotel"), srcset: roomImageSrcset("hotel"), points: ["Organize controls by room type", "Make key guest functions intuitive", "Support a cohesive room specification"] },
  { key: "office", label: "Office", title: "Spaces that respond to the workday.", img: roomImageSrc("office"), srcset: roomImageSrcset("office"), points: ["Set meeting and presentation scenes", "Simplify shared-space lighting", "Keep controls clear for every user"] },
];
---
<section class="solutions-page">
  <section class="sol-hero">
    <div class="sol-hero-image">
      <img
        src="/images/solutions/hero-smart-switch-1600-v2.webp"
        srcset="/images/solutions/hero-smart-switch-960-v2.webp 960w, /images/solutions/hero-smart-switch-1280-v2.webp 1280w, /images/solutions/hero-smart-switch-1600-v2.webp 1600w, /images/solutions/hero-smart-switch-2688-v2.webp 2688w"
        sizes="100vw"
        width="2688"
        height="1152"
        alt="A 3.5-inch touchscreen smart switch with two white modules mounted on a warm stone wall"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="sol-hero-image-shade"></div>
    </div>
    <div class="sol-container sol-hero-content">
      <span class="sol-eyebrow">SWITCHLIVO SOLUTIONS</span>
      <h1>Smart Control.<br /><em>Thoughtfully Connected.</em></h1>
      <p>Smart switch panel solutions for residential, hospitality and commercial spaces — designed to bring everyday controls together in one refined interface.</p>
      <div class="sol-actions"><a class="sol-btn" href="/contact">Discuss Your Project <span>↗</span></a><a class="sol-text-link" href="#applications">Explore Applications <span>↓</span></a></div>
    </div>
    <div class="sol-hero-note"><span>01 / 03</span><span>SMART SWITCH PANEL APPLICATIONS</span></div>
  </section>

  <section class="sol-intro sol-container">
    <div><span class="sol-kicker">ONE PLATFORM, MANY SPACES</span><h2>Control that fits<br />the way spaces work.</h2></div>
    <div class="sol-intro-copy"><p>Every project has different users, room types and operating needs. SwitchLivo brings key functions to the wall, helping create a simpler and more consistent control experience.</p><p>From a private residence to a hotel room or shared workspace, start with the application and configure the panel experience around the project.</p></div>
  </section>

  <section id="applications" class="sol-applications">
    <div class="sol-container">
      <div class="sol-section-head"><div><span class="sol-kicker">APPLICATIONS</span><h2>Solutions for real spaces.</h2></div><p>Explore how smart switch panels can support different environments and project requirements.</p></div>
      <div class="sol-app-grid">
        {applications.map((a) => <article class="sol-app-card"><div class="sol-app-image"><img src={a.img} alt={a.alt} loading="lazy" /><span class="sol-app-number">{a.no}</span></div><div class="sol-app-body"><h3>{a.title}</h3><p>{a.desc}</p><div class="sol-tags">{a.tags.map((tag) => <span>{tag}</span>)}</div><a href="/contact" class="sol-card-link">Discuss this application <b>↗</b></a></div></article>)}
      </div>
    </div>
  </section>

  <section class="sol-systems">
    <div class="sol-container">
      <div class="sol-section-head sol-light-head"><div><span class="sol-kicker">CONNECTED FUNCTIONS</span><h2>Key functions, one<br />clear interface.</h2></div><p>Build a coherent control experience by bringing compatible devices and functions together through the smart switch panel.</p></div>
      <div class="sol-system-layout">
        <div class="sol-system-list">{systems.map((s,i) => <article class="sol-system-item"><span>0{i+1}</span><div><h3>{s[0]}</h3><p>{s[1]}</p></div></article>)}</div>
        <div class="sol-panel-visual"><img src="/images/solutions/switch-panel.webp" alt="Illustrative smart touch panel interface" loading="lazy" /><div class="sol-panel-caption"><span>WALL CONTROL</span><strong>One touchpoint for everyday functions.</strong></div></div>
      </div>
      <p class="sol-disclaimer">Available functions depend on the selected panel model, supported protocols and compatible devices. Confirm the configuration with our team before specification.</p>
    </div>
  </section>

  <section class="sol-rooms">
    <div class="sol-container"><div class="sol-section-head"><div><span class="sol-kicker">ROOM-BY-ROOM EXPERIENCE</span><h2>Designed around the room.</h2></div><p>Explore typical control priorities across key spaces. Actual functions can be tailored to the selected model and project design.</p></div></div>
    <div class="sol-room-tabs" role="tablist" aria-label="Room applications">{rooms.map((r,i)=><button type="button" class:list={["sol-room-tab",i===0 && "active"]} data-room={r.key} role="tab" aria-selected={i===0 ? "true":"false"}>{r.label}</button>)}</div>
    {rooms.map((r, i) => (
      <div class:list={["sol-room-panel", i === 0 && "active"]} data-room-panel={r.key}>
        <img
          src={i === 0 ? r.img : undefined}
          srcset={i === 0 ? r.srcset : undefined}
          sizes="100vw"
          width="2200"
          height="943"
          data-src={i === 0 ? undefined : r.img}
          data-srcset={i === 0 ? undefined : r.srcset}
          alt={r.label + " interior designed for intuitive smart control"}
          loading="lazy"
          fetchpriority="auto"
          decoding="async"
        />
        <div class="sol-room-shade"></div>
        <div class="sol-container sol-room-content">
          <span class="sol-kicker">ROOM APPLICATION / 0{i + 1}</span>
          <h3>{r.title}</h3>
          <ul>{r.points.map((point) => <li>{point}</li>)}</ul>
          <a href="/contact" class="sol-btn">Plan This Space <span>↗</span></a>
        </div>
      </div>
    ))}
  </section>

  <section class="sol-partners">
    <div class="sol-container sol-partner-grid"><div><span class="sol-kicker">FOR DISTRIBUTORS & PROJECT PARTNERS</span><h2>Make the solution<br />work for your market.</h2><p>Discuss product selection, branding and project requirements with our team. We can review the intended application and help identify a suitable panel configuration.</p><a href="/contact" class="sol-btn">Talk to SwitchLivo <span>↗</span></a></div><div class="sol-partner-points"><article><span>01</span><div><h3>OEM / ODM Enquiries</h3><p>Discuss logo, interface language and packaging requirements.</p></div></article><article><span>02</span><div><h3>Samples & Evaluation</h3><p>Review the selected model and compatibility before a larger order.</p></div></article><article><span>03</span><div><h3>Project Coordination</h3><p>Share room schedules and functional requirements for discussion.</p></div></article></div></div>
  </section>
</section>

<style>
.solutions-page{--navy:#111b24;--orange:#e96b3a;--ink:#18232c;--muted:#69737b;--cream:#f5f3ef;color:var(--ink)}.sol-container{width:min(1180px,calc(100% - 48px));margin-inline:auto}.sol-hero{height:min(740px,78vh);min-height:570px;position:relative;overflow:hidden;background:#111b24;color:#fff}.sol-hero-image{position:absolute;inset:0;z-index:0;overflow:hidden}.sol-hero-image img{width:100%;height:100%;display:block;object-fit:cover;object-position:74% 52%;filter:none;opacity:1}.sol-hero-image-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(48,57,61,.66) 0%,rgba(48,57,61,.46) 43%,rgba(48,57,61,.18) 100%)}.sol-hero-content{position:relative;z-index:1;padding-top:clamp(125px,17vh,190px);max-width:1180px}.sol-hero-content>p{max-width:530px}.sol-hero h1{max-width:660px}.sol-eyebrow,.sol-kicker{font-size:11px;font-weight:800;letter-spacing:.19em;color:var(--orange)}.sol-hero h1{font-size:clamp(44px,6.5vw,78px);line-height:1.04;letter-spacing:-.045em;margin:22px 0;max-width:820px;color:#fff}.sol-hero h1 em{font-style:normal;color:#f0a17f}.sol-hero-content>p{max-width:590px;color:rgba(255,255,255,.82);font-size:17px;line-height:1.8}.sol-actions{display:flex;align-items:center;gap:28px;margin-top:34px}.sol-btn{display:inline-flex;align-items:center;gap:25px;background:var(--orange);color:white!important;text-decoration:none;padding:15px 22px;font-size:13px;font-weight:750;letter-spacing:.02em;transition:transform .2s,background .2s}.sol-btn:hover{background:#d85d30;transform:translateY(-2px)}.sol-btn span{font-size:18px}.sol-text-link{color:white;text-decoration:none;font-size:13px}.sol-text-link span{color:#f0a17f;margin-left:8px}.sol-hero-note{position:absolute;bottom:28px;left:max(24px,calc((100% - 1180px)/2));right:max(24px,calc((100% - 1180px)/2));display:flex;justify-content:space-between;border-top:1px solid #ffffff55;padding-top:13px;color:#ffffffb8;font-size:10px;letter-spacing:.16em}.sol-intro{display:grid;grid-template-columns:1fr 1fr;gap:80px;padding-block:105px}.sol-intro h2,.sol-section-head h2,.sol-partners h2{font-size:clamp(34px,4.4vw,52px);line-height:1.12;letter-spacing:-.035em;margin:15px 0 0}.sol-intro-copy{padding-top:16px;max-width:550px}.sol-intro-copy p,.sol-section-head>p,.sol-partners p{color:var(--muted);font-size:15px;line-height:1.85}.sol-applications{background:var(--cream);padding:88px 0 100px}.sol-section-head{display:flex;justify-content:space-between;align-items:end;gap:45px;margin-bottom:42px}.sol-section-head>p{max-width:390px;margin:0 0 5px}.sol-app-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.sol-app-card{background:white;min-width:0}.sol-app-image{height:245px;position:relative;overflow:hidden;background:#ddd}.sol-app-image img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.sol-app-card:hover .sol-app-image img{transform:scale(1.04)}.sol-app-number{position:absolute;left:18px;top:18px;background:var(--orange);color:#fff;padding:8px 11px;font-size:11px;letter-spacing:.1em}.sol-app-body{padding:25px 25px 26px}.sol-app-body h3{font-size:24px;margin:0 0 12px}.sol-app-body>p{color:var(--muted);font-size:14px;line-height:1.75;min-height:74px;margin:0}.sol-tags{display:flex;flex-wrap:wrap;gap:7px;margin:20px 0 24px}.sol-tags span{font-size:10px;color:#53606a;background:#f2f2ef;padding:7px 9px}.sol-card-link{display:flex;justify-content:space-between;border-top:1px solid #e8e8e5;padding-top:16px;color:var(--ink);font-size:12px;font-weight:750;text-decoration:none}.sol-card-link b{color:var(--orange);font-size:17px}.sol-systems{background:var(--cream);color:var(--ink);padding:100px 0 70px}.sol-light-head h2{color:var(--ink)}.sol-light-head>p{color:var(--muted)}.sol-system-layout{display:grid;grid-template-columns:1.1fr .9fr;gap:65px;align-items:center}.sol-system-list{display:grid;grid-template-columns:1fr 1fr;column-gap:32px}.sol-system-item{display:flex;gap:15px;padding:22px 0;border-top:1px solid #dedfd9}.sol-system-item>span{font-size:11px;color:var(--orange);padding-top:4px}.sol-system-item h3{font-size:16px;margin:0 0 8px;color:var(--ink)}.sol-system-item p{font-size:12px;line-height:1.7;color:var(--muted);margin:0}.sol-panel-visual{position:relative;max-width:420px;margin:auto;padding:18px;background:#fff;border:1px solid #e8e5df;box-shadow:0 18px 48px rgba(24,35,44,.08)}.sol-panel-visual img{width:100%;display:block}.sol-panel-caption{position:absolute;bottom:24px;left:24px;right:24px;background:#111b24e8;padding:16px 18px;display:flex;flex-direction:column;gap:6px}.sol-panel-caption span{font-size:9px;letter-spacing:.16em;color:var(--orange)}.sol-panel-caption strong{font-size:14px;color:#fff}.sol-disclaimer{font-size:11px;color:#77828a;line-height:1.6;margin:28px 0 0}.sol-rooms{padding:100px 0 0}.sol-room-tabs{display:flex;justify-content:center;flex-wrap:nowrap;gap:4px;width:max-content;max-width:calc(100% - 36px);margin:30px auto 26px;padding:5px;background:#f4f2ee;border:1px solid #e6e2dc;border-radius:999px;overflow-x:auto;scrollbar-width:none;scroll-snap-type:x proximity}.sol-room-tabs::-webkit-scrollbar{display:none}.sol-room-tab{flex:0 0 auto;border:0;border-radius:999px;background:transparent;padding:12px 22px;color:#68727a;font-size:13px;font-weight:700;cursor:pointer;white-space:nowrap;scroll-snap-align:start;transition:background .2s,color .2s,box-shadow .2s}.sol-room-tab:hover{background:#fff;color:var(--ink)}.sol-room-tab.active{background:var(--orange);color:#fff;box-shadow:0 5px 14px rgba(233,107,58,.2)}.sol-room-tab:focus-visible{outline:2px solid var(--orange);outline-offset:3px}.sol-room-panel{display:none;position:relative;min-height:560px;overflow:hidden;color:white}.sol-room-panel.active{display:block}.sol-room-panel>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:none;opacity:1;transform:none}.sol-room-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(38,48,53,.42) 0%,rgba(38,48,53,.22) 48%,rgba(38,48,53,0) 82%);backdrop-filter:none}.sol-room-content{position:relative;padding-top:82px;padding-bottom:75px}.sol-room-content h3{font-size:clamp(32px,4vw,48px);max-width:560px;line-height:1.15;margin:17px 0 25px;color:#fff}.sol-room-content ul{list-style:none;padding:0;margin:0 0 30px}.sol-room-content li{padding:10px 0 10px 22px;position:relative;color:#ffffffdc;font-size:14px}.sol-room-content li:before{content:"";position:absolute;left:0;top:18px;width:7px;height:7px;background:var(--orange);border-radius:50%}.sol-partners{background:var(--cream);padding:100px 0}.sol-partner-grid{display:grid;grid-template-columns:1fr .9fr;gap:90px;align-items:center}.sol-partners h2{margin-bottom:20px}.sol-partners p{max-width:500px;margin-bottom:28px}.sol-partner-points article{display:flex;gap:22px;padding:23px 0;border-bottom:1px solid #dcdedb}.sol-partner-points article:first-child{border-top:1px solid #dcdedb}.sol-partner-points article>span{font-size:12px;color:var(--orange);padding-top:4px}.sol-partner-points h3{font-size:17px;margin:0 0 6px}.sol-partner-points p{font-size:13px;margin:0}
@media(max-width:800px){.sol-container{width:min(100% - 36px,620px)}.sol-hero{min-height:570px;height:75vh}.sol-hero-content{padding-top:130px}.sol-intro,.sol-partner-grid{grid-template-columns:1fr;gap:24px;padding-block:72px}.sol-section-head{display:block}.sol-section-head>p{margin-top:18px}.sol-app-grid{grid-template-columns:1fr}.sol-app-image{height:260px}.sol-app-body>p{min-height:0}.sol-systems{padding:72px 0 50px}.sol-system-layout{grid-template-columns:1fr;gap:25px}.sol-system-list{column-gap:18px}.sol-panel-visual{max-width:330px}.sol-rooms{padding-top:72px}.sol-room-tabs{justify-content:flex-start;width:calc(100% - 36px);max-width:620px;margin:24px auto 20px}.sol-room-tab{padding:12px 16px;font-size:12px}.sol-room-panel{min-height:540px}.sol-room-panel>img{object-position:68% center}.sol-room-shade{background:linear-gradient(90deg,rgba(38,48,53,.48),rgba(38,48,53,.28) 72%,rgba(38,48,53,.08))}.sol-room-content{padding-top:65px}.sol-partners{padding:72px 0}.sol-partner-grid{padding-block:0;gap:35px}}
@media(max-width:800px){.sol-hero-image img{object-position:87% center}.sol-hero-image-shade{background:linear-gradient(90deg,rgba(48,57,61,.64),rgba(48,57,61,.32))}.sol-hero-content{padding-top:105px}.sol-hero-content>p{max-width:460px}}\n@media(max-width:480px){.sol-hero{min-height:700px;height:780px}.sol-hero h1{font-size:43px}.sol-hero-content>p{font-size:15px;max-width:95%}.sol-actions{align-items:flex-start;flex-direction:column;gap:18px}.sol-hero-image img{object-position:60% center}.sol-hero-image-shade{background:linear-gradient(90deg,rgba(12,22,30,.84),rgba(12,22,30,.52))}.sol-hero-note{font-size:8px}.sol-system-list{grid-template-columns:1fr}.sol-room-content h3{font-size:34px}.sol-room-panel{min-height:570px}}
@media(prefers-reduced-motion:reduce){.sol-app-image img,.sol-btn{transition:none}}
</style>
<script>
document.addEventListener("astro:page-load", () => {
  document.querySelectorAll(".solutions-page").forEach((root) => {
    const tabs = root.querySelectorAll(".sol-room-tab");
    const panels = root.querySelectorAll(".sol-room-panel");
    const activateTab = (selectedTab) => {
      const key = selectedTab.dataset.room;
      tabs.forEach((item) => {
        item.classList.toggle("active", item === selectedTab);
        item.setAttribute("aria-selected", item === selectedTab ? "true" : "false");
      });
      panels.forEach((panel) => {
        const isActive = panel.dataset.roomPanel === key;
        panel.classList.toggle("active", isActive);
        if (isActive) {
          const image = panel.querySelector("img");
          if (image && !image.getAttribute("src") && image.dataset.src) {
            const src = image.dataset.src;
            const srcset = image.dataset.srcset;
            if (srcset) image.setAttribute("srcset", srcset);
            image.setAttribute("sizes", "100vw");
            image.fetchPriority = "high";
            image.loading = "eager";
            image.src = src;
            image.removeAttribute("data-src");
            image.removeAttribute("data-srcset");
          }
        }
      });
    };
    tabs.forEach((tab) => {
      tab.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "mouse") activateTab(tab);
      });
      tab.addEventListener("focus", () => activateTab(tab));
      tab.addEventListener("click", () => activateTab(tab));
    });
  });
});
</script>
