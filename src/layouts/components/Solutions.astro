---
// Switchlivo Solutions page — rebuilt from the hongyan case-page layout,
// with two sections deliberately removed per the owner's brief:
//  - NO project-cases block (no real-estate project gallery)
//  - NO immersive multi-mode interaction block (no near/mid/far cards)
// Remaining structure: full-bleed hero slider, pain-phrase cloud,
// panel-centred subsystem layout, room-scenario tabs, distributor strip.
// Images: hero slides are Unsplash (free licence, no Cloudflare R2 involved);
// scenario panels reuse the site's own public/ images, which Cloudflare
// Pages serves directly from the repo. To host the hero images in-repo
// later, download them into public/images/solutions/photos/ and swap the
// three URLs below for local paths — no other change needed.
const slides = [
  {
    img: "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?q=80&w=2000&auto=format&fit=crop",
    alt: "Modern living room",
  },
  {
    img: "https://images.unsplash.com/photo-1556911220-bff31c812dba?q=80&w=2000&auto=format&fit=crop",
    alt: "Modern kitchen",
  },
  {
    img: "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?q=80&w=2000&auto=format&fit=crop",
    alt: "Hotel-style bedroom",
  },
];

const pains = [
  "Protocols that don't talk to each other",
  "Long customization lead times",
  "Inconsistent quality between batches",
  "No firmware or OTA support after shipment",
  "Certification gaps blocking market entry",
  "High MOQs that lock out smaller brands",
  "After-sales burden falling on your team",
  "Look-alike panels, uneven performance",
];

const systemsLeft = [
  {
    h: "Smart Lighting",
    p: "Dimming, colour temperature and scenes from one panel — no extra wall clutter, no app-only control.",
  },
  {
    h: "Climate & Comfort",
    p: "AC, fresh air and floor heating linked to the panel, so one scene sets temperature and light together.",
  },
  {
    h: "Energy Management",
    p: "Panel-level energy view for homes and hotels, cutting standby waste without changing guest habits.",
  },
  {
    h: "Security & Access",
    p: "Arm, disarm and door status from the entry panel, with alerts pushed to the phone app.",
  },
];
const systemsRight = [
  {
    h: "Curtains & Shading",
    p: "Curtain motors join the same scene: movie mode closes curtains and dims lights in one tap.",
  },
  {
    h: "Hotel Room Control",
    p: "Guest-room panels for light, climate, curtains and Do Not Disturb — one standard panel per room type.",
  },
  {
    h: "Office & Meeting",
    p: "Meeting-room scenes for presentation, discussion and away — set from the wall, not a remote hunt.",
  },
  {
    h: "Central Panel Hub",
    p: "The switch panel is the hub: one glass panel commands every subsystem, with the app as backup.",
  },
];

const scenarios = [
  {
    key: "entry",
    tab: "Entryway",
    title: "Walk in, and the home is already ready.",
    img: "/images/solutions/photos/entry.jpg",
    chips: [
      { label: "Home Mode", text: "Lights on, security disarmed, fresh air and AC start from the entry panel." },
      { label: "Away Mode", text: "One tap switches off lights and appliances and arms security." },
      { label: "Guest Access", text: "Door status and intercom on the panel — see and talk before opening." },
    ],
  },
  {
    key: "kitchen",
    tab: "Kitchen",
    title: "Hands busy? The panel still listens to one tap.",
    img: "/images/solutions/photos/kitchen.jpg",
    chips: [
      { label: "Scene Control", text: "Cooking, cleaning and dining presets for light and ventilation." },
      { label: "Safety First", text: "Smoke and leak alerts shown on the panel and pushed to the phone." },
      { label: "Easy Clean", text: "Flat glass panel, no gaps for grease — wipe clean in seconds." },
    ],
  },
  {
    key: "dining",
    tab: "Dining",
    title: "One scene, the right light for the table.",
    img: "/images/solutions/photos/dining.jpg",
    chips: [
      { label: "Dinner Scene", text: "Warm dimmed light, curtains closed, music-ready in one tap." },
      { label: "Party Scene", text: "Brighter, livelier presets for hosting, still from one panel." },
      { label: "Comfort", text: "Climate and air follow the room, not a separate remote." },
    ],
  },
  {
    key: "living",
    tab: "Living Room",
    title: "Touch the wall, and the room responds.",
    img: "/images/solutions/photos/living.jpg",
    chips: [
      { label: "Movie Mode", text: "Curtains close, lights fade, TV scene ready — one panel." },
      { label: "Host Mode", text: "Welcome light, music and climate for guests, set in advance." },
      { label: "Energy Saving", text: "Standby power trimmed automatically, comfort untouched." },
    ],
  },
  {
    key: "bedroom",
    tab: "Bedroom",
    title: "One tap to sleep, one tap to rise.",
    img: "/images/solutions/photos/bedroom.jpg",
    chips: [
      { label: "Sleep Mode", text: "Curtains and lights close, security arms, night-duty energy." },
      { label: "Morning Mode", text: "Curtains open gently, lights warm up, the day starts softly." },
      { label: "Hotel Ready", text: "Same panel logic for hotel rooms: sleep, wake, DND, housekeeping." },
    ],
  },
  {
    key: "bathroom",
    tab: "Bathroom",
    title: "Comfort and safety, handled quietly.",
    img: "https://images.unsplash.com/photo-1620626011761-996317b8d101?q=80&w=2000&auto=format&fit=crop",
    chips: [
      { label: "Ventilation", text: "Humidity-linked fan control, no manual switching." },
      { label: "Safety Watch", text: "Leak and overheating monitoring around the clock." },
      { label: "Warm Start", text: "Pre-heat and mirror defog before you step in." },
    ],
  },
];
---

<section class="sl">
  <!-- HERO SLIDER -->
  <div class="sl-hero">
    {
      slides.map((s, i) => (
        <div class:list={["sl-slide", i === 0 && "on"]}>
          <div class="sl-slide-bg" style={`background-image:url('${s.img}')`} role="img" aria-label={s.alt} />
          <div class="sl-slide-shade" />
        </div>
      ))
    }
    <div class="sl-hero-main">
      <h1 class="sl-hero-title">Smart Switch Panel Solutions</h1>
      <p class="sl-hero-sub">One glass panel for home, hotel and office — lighting, climate, curtains and security, built for distributors and projects.</p>
      <a href="/contact" class="sl-hero-btn">Request a Quote</a>
    </div>
    <button class="sl-arrow prev" type="button" aria-label="Previous slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button class="sl-arrow next" type="button" aria-label="Next slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 5l7 7-7 7" /></svg>
    </button>
    <div class="sl-dots">
      {slides.map((_, i) => <span class:list={["sl-dot", i === 0 && "on"]} data-dot={i} />)}
    </div>
  </div>

  <!-- PAIN CLOUD -->
  <div class="sl-pain">
    <div class="sl-pain-shade" />
    <div class="sl-wrap">
      <h2 class="sl-pain-title">If any of these sound familiar, the panel is the problem — not your project.</h2>
      <div class="sl-pain-cloud">
        {pains.map((t) => <span class="p">{t}</span>)}
      </div>
    </div>
  </div>

  <!-- SUBSYSTEMS: panel in the centre -->
  <div class="sl-sys">
    <div class="sl-wrap">
      <h2 class="sl-tit">Eight Systems, One Panel</h2>
      <p class="sl-sub">Everything runs through the switch panel on the wall. The phone app is a backup, not a requirement.</p>
      <div class="sl-sys-grid">
        <div class="sl-sys-col">
          {systemsLeft.map((s) => (
            <div class="sl-sys-item">
              <h3>{s.h}</h3>
              <p>{s.p}</p>
            </div>
          ))}
        </div>
        <div class="sl-sys-center" aria-label="Smart switch panel">
          <div class="sl-panel">
            <div class="sl-panel-top"><span>21:30</span><span>26°C</span></div>
            <div class="sl-panel-btns">
              <span>Lighting</span><span>Climate</span><span>Curtains</span><span>Scene</span>
            </div>
            <div class="sl-panel-foot">Switchlivo · Glass Touch Panel</div>
          </div>
        </div>
        <div class="sl-sys-col">
          {systemsRight.map((s) => (
            <div class="sl-sys-item">
              <h3>{s.h}</h3>
              <p>{s.p}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- ROOM SCENARIOS -->
  <div class="sl-scen">
    <div class="sl-wrap">
      <h2 class="sl-tit">Room by Room, One Panel Logic</h2>
    </div>
    <div class="sl-tabs" role="tablist">
      {scenarios.map((s, i) => (
        <button class:list={["sl-tab", i === 0 && "on"]} data-tab={s.key} role="tab" aria-selected={i === 0 ? "true" : "false"} type="button">{s.tab}</button>
      ))}
    </div>
    {scenarios.map((s, i) => (
      <div class:list={["sl-panel-scene", i === 0 && "on"]} data-panel={s.key}>
        <div class="sl-panel-bg" style={`background-image:url('${s.img}')`} />
        <div class="sl-panel-shade" />
        <div class="sl-wrap sl-panel-content">
          <h3 class="sl-panel-title">{s.title}</h3>
          <ul class="sl-chips">
            {s.chips.map((c) => (
              <li><span class="tag">{c.label}</span><span class="tx">{c.text}</span></li>
            ))}
          </ul>
          <a class="sl-panel-cta" href="/contact">Ask about this scenario <span class="ic">→</span></a>
        </div>
      </div>
    ))}
  </div>

  <!-- DISTRIBUTOR STRIP -->
  <div class="sl-strip">
    <div class="sl-wrap sl-strip-grid">
      <div>
        <h2 class="sl-tit" style="text-align:left;margin-bottom:12px">For Distributors &amp; Projects</h2>
        <p class="sl-sub" style="text-align:left;margin:0">Same panel platform across home, hotel and office projects — with your branding, your language and your market's voltage and frequency options. Confirm the exact model's certification for your market before ordering.</p>
      </div>
      <ul class="sl-strip-list">
        <li><strong>OEM / ODM</strong><span>Your logo, UI language and packaging</span></li>
        <li><strong>Sample first</strong><span>Test one panel before a bulk order</span></li>
        <li><strong>Project support</strong><span>Room-type panel lists and scene presets</span></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .sl { --acc: #fe6019; --ink: #111827; --mut: #5b6470; }
  .sl-wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .sl-hero { position: relative; height: clamp(480px, 78vh, 680px); overflow: hidden; color: #fff; }
  .sl-slide { position: absolute; inset: 0; opacity: 0; transition: opacity 0.6s ease; }
  .sl-slide.on { opacity: 1; }
  .sl-slide-bg { position: absolute; inset: 0; background-size: cover; background-position: center; }
  .sl-slide-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,13,17,0.72), rgba(10,13,17,0.25) 60%, rgba(10,13,17,0.1)); }
  .sl-hero-main { position: relative; z-index: 2; max-width: 1200px; margin: 0 auto; padding: 150px 24px 0; }
  .sl-hero-title { font-size: clamp(38px, 6vw, 68px); font-weight: 800; line-height: 1.1; margin: 0 0 16px; max-width: 760px; }
  .sl-hero-sub { font-size: 17px; line-height: 1.6; color: rgba(255,255,255,0.88); max-width: 620px; margin: 0 0 28px; }
  .sl-hero-btn { display: inline-block; background: var(--acc); color: #fff; font-weight: 700; padding: 13px 30px; border-radius: 4px; text-decoration: none; }
  .sl-arrow { position: absolute; z-index: 3; top: 50%; transform: translateY(-50%); width: 48px; height: 48px; border: 1px solid rgba(255,255,255,0.6); background: rgba(0,0,0,0.25); color: #fff; border-radius: 50%; cursor: pointer; }
  .sl-arrow svg { width: 22px; height: 22px; margin: 0 auto; display: block; }
  .sl-arrow.prev { left: 22px; } .sl-arrow.next { right: 22px; }
  .sl-dots { position: absolute; z-index: 3; left: 50%; bottom: 26px; transform: translateX(-50%); display: flex; gap: 10px; }
  .sl-dot { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.5); cursor: pointer; }
  .sl-dot.on { background: var(--acc); }
  .sl-pain { position: relative; background: #101418; color: #fff; padding: 72px 0; overflow: hidden; }
  .sl-pain-shade { position: absolute; inset: 0; background: radial-gradient(600px 300px at 20% 0%, rgba(254,96,25,0.25), transparent 70%); }
  .sl-pain-title { position: relative; font-size: clamp(22px, 3vw, 32px); font-weight: 700; max-width: 760px; margin: 0 0 28px; line-height: 1.4; }
  .sl-pain-cloud { position: relative; display: flex; flex-wrap: wrap; gap: 12px; }
  .sl-pain-cloud .p { border: 1px solid rgba(255,255,255,0.28); border-radius: 999px; padding: 9px 18px; font-size: 14px; color: rgba(255,255,255,0.85); }
  .sl-tit { text-align: center; font-size: clamp(26px, 3.5vw, 38px); font-weight: 800; color: var(--ink); margin: 0 0 12px; }
  .sl-sub { text-align: center; color: var(--mut); font-size: 16px; line-height: 1.65; max-width: 720px; margin: 0 auto 44px; }
  .sl-sys { padding: 84px 0; background: #faf8f6; }
  .sl-sys-grid { display: grid; grid-template-columns: 1fr 340px 1fr; gap: 40px; align-items: center; }
  .sl-sys-item { margin-bottom: 30px; }
  .sl-sys-item h3 { font-size: 18px; margin: 0 0 6px; color: var(--ink); }
  .sl-sys-item p { font-size: 14.5px; line-height: 1.65; color: var(--mut); margin: 0; }
  .sl-sys-center { display: flex; justify-content: center; }
  .sl-panel { width: 280px; background: #0e1216; border-radius: 16px; padding: 22px; color: #fff; box-shadow: 0 24px 60px rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.12); }
  .sl-panel-top { display: flex; justify-content: space-between; font-size: 22px; font-weight: 700; margin-bottom: 22px; }
  .sl-panel-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .sl-panel-btns span { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.14); border-radius: 8px; padding: 16px 8px; text-align: center; font-size: 13px; }
  .sl-panel-foot { margin-top: 20px; text-align: center; font-size: 12px; color: rgba(255,255,255,0.55); letter-spacing: 0.08em; }
  .sl-scen { padding: 84px 0 0; }
  .sl-tabs { display: flex; justify-content: center; flex-wrap: wrap; gap: 0; border-top: 1px solid #eee; border-bottom: 1px solid #eee; margin-top: 20px; }
  .sl-tab { background: #fff; border: 0; border-right: 1px solid #eee; padding: 16px 26px; font-size: 15px; font-weight: 600; color: #666; cursor: pointer; }
  .sl-tab.on { background: var(--acc); color: #fff; }
  .sl-panel-scene { display: none; position: relative; height: clamp(520px, 75vh, 700px); overflow: hidden; color: #fff; }
  .sl-panel-scene.on { display: block; }
  .sl-panel-bg { position: absolute; inset: 0; background-size: cover; background-position: center; }
  .sl-panel-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,13,17,0.84) 0%, rgba(10,13,17,0.68) 48%, rgba(10,13,17,0.42) 100%); }
  .sl-panel-content { position: relative; z-index: 1; padding-top: 68px; max-width: 1200px; }
  .sl-panel-title { font-size: 30px; font-weight: 700; line-height: 1.4; max-width: 560px; margin: 0 0 28px; color: #fff; text-shadow: 0 2px 12px rgba(0,0,0,0.45); }
  .sl-chips { list-style: none; padding: 20px 20px 6px; margin: 0; max-width: 560px; background: rgba(10,13,17,0.48); backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,0.16); border-radius: 12px; }
  .sl-chips li { display: flex; gap: 12px; margin-bottom: 15px; align-items: flex-start; }
  .sl-chips .tag { flex: 0 0 auto; background: var(--acc); color: #fff; font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 3px; white-space: nowrap; }
  .sl-chips .tx { color: rgba(255,255,255,0.82); font-size: 14px; line-height: 1.65; }
  .sl-panel-cta { display: inline-flex; margin-top: 22px; color: #fff; background: var(--acc); padding: 12px 24px; border-radius: 999px; text-decoration: none; font-size: 14px; font-weight: 700; }
  .sl-strip { padding: 64px 0; background: #fff; }
  .sl-strip-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: center; }
  .sl-strip-list { list-style: none; padding: 0; margin: 0; }
  .sl-strip-list li { display: flex; flex-direction: column; border-left: 3px solid var(--acc); padding-left: 14px; margin-bottom: 18px; }
  .sl-strip-list strong { color: var(--ink); } .sl-strip-list span { color: var(--mut); font-size: 14px; }
  @media (max-width: 900px) {
    .sl-sys-grid { grid-template-columns: 1fr; } .sl-sys-center { order: -1; }
    .sl-strip-grid { grid-template-columns: 1fr; } .sl-hero-main { padding-top: 110px; }
    .sl-panel-scene { height: auto; min-height: 560px; } .sl-panel-cta { right: 20px; bottom: 20px; }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector(".sl");
    if (!root) return;
    const slides = root.querySelectorAll(".sl-slide");
    const dots = root.querySelectorAll(".sl-dot");
    let cur = 0, timer = null;
    const show = (idx) => {
      cur = (idx + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle("on", i === cur));
      dots.forEach((d, i) => d.classList.toggle("on", i === cur));
    };
    const restart = () => { if (timer) clearInterval(timer); timer = setInterval(() => show(cur + 1), 5500); };
    root.querySelector(".sl-arrow.prev")?.addEventListener("click", () => { show(cur - 1); restart(); });
    root.querySelector(".sl-arrow.next")?.addEventListener("click", () => { show(cur + 1); restart(); });
    dots.forEach((d) => d.addEventListener("click", () => { show(Number(d.dataset.dot)); restart(); }));
    if (slides.length > 1) restart();
    const tabs = root.querySelectorAll(".sl-tab");
    const panels = root.querySelectorAll(".sl-panel-scene");
    const activate = (tab) => {
      const key = tab.getAttribute("data-tab");
      tabs.forEach((t) => { t.classList.remove("on"); t.setAttribute("aria-selected", "false"); });
      panels.forEach((p) => p.classList.remove("on"));
      tab.classList.add("on"); tab.setAttribute("aria-selected", "true");
      root.querySelector(`.sl-panel-scene[data-panel="${key}"]`)?.classList.add("on");
    };
    tabs.forEach((tab) => { tab.addEventListener("mouseenter", () => activate(tab)); tab.addEventListener("click", () => activate(tab)); });
  });
</script>
