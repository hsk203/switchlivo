---

<section class="sol" id="solutions">
  <!-- HERO -->
  <div class="sol-hero">
    <div class="sol-hero-pattern" aria-hidden="true"></div>
    <div class="container">
      <div class="sol-hero-inner" data-reveal>
        <span class="sol-eyebrow">Solutions</span>
        <h2 class="sol-hero-title">Smart Solutions for Every Connected Space</h2>
        <p class="sol-hero-sub">
          From smart homes to smart hotels and commercial buildings, Switchlivo
          delivers a complete, customizable ecosystem — engineered, manufactured,
          and supported as your OEM &amp; ODM partner.
        </p>
        <div class="sol-hero-cta">
          <a href="/products" class="btn btn-primary">Explore Products</a>
          <a href="/contact" class="btn btn-ghost">Ask For Catalog</a>
        </div>
      </div>
    </div>
  </div>

  <!-- SUBSYSTEM GRID -->
  <div class="container">
    <div class="sol-head" data-reveal>
      <span class="sol-eyebrow sol-eyebrow--center">Subsystems</span>
      <h3 class="sol-h3">Subsystems That Power Every Space</h3>
      <p class="sol-lead">
        Every solution is composed from interoperable subsystems — specify exactly
        what each project needs.
      </p>
    </div>
    <div class="sol-grid sol-grid-4">
      {
        subsystems.map((c) => (
          <div class="sol-card" data-reveal>
            <span class="sol-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d={c.icon} />
              </svg>
            </span>
            <h4 class="sol-card-title">{c.name}</h4>
            <p class="sol-card-desc">{c.desc}</p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- INTERACTION TIERS -->
  <div class="sol-interaction-wrap">
    <div class="container">
      <div class="sol-head" data-reveal>
        <span class="sol-eyebrow sol-eyebrow--center">Interaction</span>
        <h3 class="sol-h3">Control Your Way — Near, Mid, and Far</h3>
        <p class="sol-lead">
          One ecosystem, three interaction ranges: local at the wall, voice across
          the room, and remote from anywhere.
        </p>
      </div>
      <div class="sol-interaction">
        {
          interactions.map((t) => (
            <div class="sol-tier" data-reveal>
              <span class="sol-tier-badge">{t.tier}</span>
              <span class="sol-card-icon sol-card-icon--lg">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={t.icon} />
                </svg>
              </span>
              <h4 class="sol-card-title">{t.name}</h4>
              <p class="sol-card-desc">{t.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ROOM SCENARIOS -->
  <div class="container">
    <div class="sol-head" data-reveal>
      <span class="sol-eyebrow sol-eyebrow--center">Scenarios</span>
      <h3 class="sol-h3">Whole-Home Scenarios, Room by Room</h3>
      <p class="sol-lead">
        See how Switchlivo brings comfort, security, and efficiency to the rooms
        people use every day.
      </p>
    </div>

    <div class="sol-scenarios">
      {
        scenarios.map((s, i) => (
          <div class:list={["sol-scenario", i % 2 === 1 && "sol-scenario--reverse"]} data-reveal>
            <div class="sol-scenario-media">
              <img
                src={`/images/solutions/scenario-${s.key}.svg`}
                alt={s.eyebrow}
                width="800"
                height="600"
                loading="lazy"
              />
            </div>
            <div class="sol-scenario-text">
              <span class="sol-eyebrow">{s.eyebrow}</span>
              <h4 class="sol-scenario-title">{s.title}</h4>
              <p class="sol-scenario-desc">{s.desc}</p>
              <ul class="sol-points">
                {s.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- INDUSTRY VERTICALS -->
  <div class="container">
    <div class="sol-head" data-reveal>
      <span class="sol-eyebrow sol-eyebrow--center">By Industry</span>
      <h3 class="sol-h3">Solutions Built for Every Segment</h3>
      <p class="sol-lead">
        One platform, adapted to the needs of hotels, residences, offices,
        buildings, and lighting projects.
      </p>
    </div>
    <div class="sol-grid sol-grid-3">
      {
        industries.map((it) => (
          <div class="sol-card" data-reveal>
            <span class="sol-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d={it.icon} />
              </svg>
            </span>
            <h4 class="sol-card-title">{it.name}</h4>
            <p class="sol-card-desc">{it.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* HERO */
  .sol-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #1a202c 0%, #2a1d12 55%, #3a1f0c 100%);
    color: #fff;
    padding: 5rem 0 5.5rem;
  }
  .sol-hero-pattern {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 78% 22%, rgba(254, 96, 25, 0.28), transparent 42%),
      radial-gradient(circle at 12% 88%, rgba(255, 179, 71, 0.16), transparent 45%);
    pointer-events: none;
  }
  .sol-hero-inner {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .sol-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ffb347;
    margin-bottom: 0.9rem;
  }
  .sol-eyebrow--center {
    display: block;
  }
  .sol-hero-title {
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.12;
    margin-bottom: 1.2rem;
    color: #fff;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.25);
  }
  .sol-hero-sub {
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.82);
    margin-bottom: 2rem;
  }
  .sol-hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.7rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.98rem;
    transition: all 0.25s ease;
    text-decoration: none;
  }
  .btn-primary {
    background: linear-gradient(90deg, #fe6019, #ff8a3d);
    color: #fff;
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(254, 96, 25, 0.4);
  }
  .btn-ghost {
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    color: #fff;
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
  }

  /* HEADINGS */
  .sol-head {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 2.8rem;
    padding-top: 4.5rem;
  }
  .sol-h3 {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 800;
    color: #222;
    margin-bottom: 0.8rem;
  }
  .sol-lead {
    color: #888;
    font-size: 1.02rem;
    line-height: 1.7;
  }

  /* GRID + CARDS */
  .sol-grid {
    display: grid;
    gap: 1.5rem;
  }
  .sol-grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .sol-grid-4 {
    grid-template-columns: repeat(4, 1fr);
  }
  .sol-card {
    background: #fff;
    border: 1px solid #ebebeb;
    border-radius: 18px;
    padding: 2rem 1.6rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .sol-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(26, 32, 44, 0.1);
    border-color: rgba(254, 96, 25, 0.4);
  }
  .sol-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgba(254, 96, 25, 0.1);
    color: #fe6019;
    margin-bottom: 1.1rem;
  }
  .sol-card-icon svg {
    width: 26px;
    height: 26px;
  }
  .sol-card-icon--lg {
    width: 60px;
    height: 60px;
    margin-bottom: 1.3rem;
  }
  .sol-card-icon--lg svg {
    width: 30px;
    height: 30px;
  }
  .sol-card-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #222;
    margin-bottom: 0.5rem;
  }
  .sol-card-desc {
    color: #777;
    font-size: 0.96rem;
    line-height: 1.65;
  }

  /* INTERACTION TIERS */
  .sol-interaction-wrap {
    margin-top: 4.5rem;
    background: #faf7f3;
    padding: 1rem 0 4.5rem;
  }
  .sol-interaction {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .sol-tier {
    background: #fff;
    border: 1px solid #ebebeb;
    border-radius: 18px;
    padding: 2.2rem 1.8rem;
    text-align: center;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .sol-tier:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(26, 32, 44, 0.1);
  }
  .sol-tier-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fe6019;
    background: rgba(254, 96, 25, 0.1);
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    margin-bottom: 1.2rem;
  }
  .sol-tier .sol-card-icon {
    margin-left: auto;
    margin-right: auto;
  }

  /* SCENARIOS */
  .sol-scenarios {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .sol-scenario {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2.5rem;
  }
  .sol-scenario--reverse .sol-scenario-media {
    order: 2;
  }
  .sol-scenario-media {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(26, 32, 44, 0.1);
    background: #fff;
  }
  .sol-scenario-media img {
    display: block;
    width: 100%;
    height: auto;
  }
  .sol-scenario-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #222;
    margin: 0.6rem 0 0.9rem;
  }
  .sol-scenario-desc {
    color: #777;
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 1.1rem;
  }
  .sol-points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem 1.2rem;
  }
  .sol-points li {
    position: relative;
    padding-left: 1.6rem;
    color: #444;
    font-size: 0.96rem;
  }
  .sol-points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #fe6019;
  }

  /* REVEAL */
  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 1024px) {
    .sol-grid-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 900px) {
    .sol-grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
    .sol-interaction {
      grid-template-columns: 1fr;
    }
    .sol-scenario {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .sol-scenario--reverse .sol-scenario-media {
      order: 0;
    }
  }
  @media (max-width: 560px) {
    .sol-grid-3,
    .sol-grid-4 {
      grid-template-columns: 1fr;
    }
    .sol-points {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const els = document.querySelectorAll(".sol [data-reveal]");
    if (!els.length) return;
    if (!("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("is-visible"));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("is-visible");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    els.forEach((el) => io.observe(el));
  });
</script>
