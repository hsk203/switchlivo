<script>
  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector(".hy");
    if (!root) return;

    // ----- hero slider -----
    const slides = root.querySelectorAll(".hy-slide");
    const dots = root.querySelectorAll(".hy-dot");
    let cur = 0;
    let timer = null;
    const show = (idx) => {
      cur = (idx + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle("on", i === cur));
      dots.forEach((d, i) => d.classList.toggle("on", i === cur));
    };
    const restart = () => {
      if (timer) clearInterval(timer);
      timer = setInterval(() => show(cur + 1), 5500);
    };
    root.querySelector(".hy-arrow.prev")?.addEventListener("click", () => { show(cur - 1); restart(); });
    root.querySelector(".hy-arrow.next")?.addEventListener("click", () => { show(cur + 1); restart(); });
    dots.forEach((d) =>
      d.addEventListener("click", () => { show(Number(d.dataset.dot)); restart(); })
    );
    if (slides.length > 1) restart();

    // ----- scenario tabs -----
    const tabs = root.querySelectorAll(".hy-tab");
    const panels = root.querySelectorAll(".hy-panel");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const key = tab.getAttribute("data-tab");
        tabs.forEach((t) => {
          t.classList.remove("on");
          t.setAttribute("aria-selected", "false");
        });
        panels.forEach((p) => p.classList.remove("on"));
        tab.classList.add("on");
        tab.setAttribute("aria-selected", "true");
        root.querySelector(`.hy-panel[data-panel="${key}"]`)?.classList.add("on");
      });
    });
  });
</script>
