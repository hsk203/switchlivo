---
import { cdnImage } from "@/lib/cdnImage";
import config from "@/config/config.json";

// Hero — one concrete headline, one real room photo, one real product.
// The banner title/content in src/content/homepage/-index.md is superseded:
// it was generic ecosystem copy ("Connect, Control, and Build Your Smart Home").
// WhatsApp number + message still live in src/config/config.json → params.whatsapp
const wa = config.params.whatsapp;
const waHref = `https://wa.me/${wa.number}?text=${encodeURIComponent(wa.message)}`;
---

<section class="hero">
  <div class="hero-shell">
    <div class="hero-copy">
      <span class="hero-kicker">SMART SWITCH PANELS · OEM / ODM</span>
      <h1 class="hero-title">Smart switch panels, made in our own factory.</h1>
      <p class="hero-sub">
        Touch switches, scene switches, fan controls, modular sockets and
        thermostats — 322+ models across 12 categories, manufactured in
        Shunde, Foshan, China, and branded for your market.
      </p>
      <div class="hero-actions">
        <a class="hero-btn hero-btn-primary" href="/contact">Get a Quotation</a>
        {
          wa.enable && (
            <a
              class="hero-btn hero-btn-ghost"
              href={waHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
              </svg>
              Chat on WhatsApp
            </a>
          )
        }
      </div>
      <p class="hero-note">OEM &amp; ODM · 322+ models · Quotation within 24 hours</p>
    </div>

    <div class="hero-visual">
      <img
        class="hero-photo"
        src="/images/solutions/photos/living.jpg"
        alt="Living room with Switchlivo smart switch panels on the wall"
        width="1920"
        height="1281"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <a class="hero-product" href="/products/x10-3-gang-smart-light-switch">
        <img
          src={cdnImage("https://cdn.switchlivo.com/products/x10-3-gang-smart-light-switch.webp")}
          alt="X10 3-Gang Smart Light Switch — Switchlivo smart switch panel"
          width="300"
          height="300"
          loading="eager"
          decoding="async"
        />
        <span>
          <strong>X10 3-Gang Smart Light Switch</strong>
          <small>Touch · 3 gang · Tuya / Zigbee / Matter</small>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(48px, 6vw, 88px) 0 clamp(64px, 7vw, 96px);
    background: #fff;
    color: #1a202c;
  }
  .hero-shell {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(40px, 5vw, 72px);
    align-items: center;
  }
  .hero-kicker {
    display: block;
    color: #b84311;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }
  /* Headings use the theme's primary sans (Poppins), not the serif
     secondary — one family for headings and body on this page. */
  .hero-title {
    margin: 18px 0 0;
    color: #1a202c;
    font-family: var(--font-primary);
    font-size: clamp(38px, 4.6vw, 58px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .hero-sub {
    max-width: 520px;
    margin: 22px 0 0;
    color: #4b5563;
    font-size: 16px;
    line-height: 1.75;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
  }
  /* Button system for the whole page: one solid orange primary,
     one neutral dark outline. No gradients, no green, no pink. */
  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    border-radius: 10px;
    padding: 14px 26px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .hero-btn-primary {
    background: #fe6019;
    border: 1px solid #fe6019;
    color: #fff;
  }
  .hero-btn-primary:hover {
    background: #e8540f;
    border-color: #e8540f;
    transform: translateY(-2px);
  }
  .hero-btn-ghost {
    background: transparent;
    border: 1px solid #1a202c;
    color: #1a202c;
  }
  .hero-btn-ghost:hover {
    border-color: #fe6019;
    color: #fe6019;
    transform: translateY(-2px);
  }
  .hero-btn:focus-visible {
    outline: 2px solid #fe6019;
    outline-offset: 3px;
  }
  .wa-icon {
    display: block;
    width: 19px;
    height: 19px;
    flex: none;
  }
  .hero-note {
    margin: 22px 0 0;
    color: #6b7280;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .hero-visual {
    position: relative;
  }
  .hero-photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3.4;
    object-fit: cover;
    border-radius: 16px;
  }
  .hero-product {
    position: absolute;
    left: -18px;
    bottom: -18px;
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 340px;
    border: 1px solid #e8e5df;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 16px 40px rgba(24, 35, 44, 0.14);
    padding: 12px 16px 12px 12px;
    color: #1a202c;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .hero-product:hover {
    transform: translateY(-3px);
    box-shadow: 0 22px 48px rgba(24, 35, 44, 0.18);
  }
  .hero-product:focus-visible {
    outline: 2px solid #fe6019;
    outline-offset: 3px;
  }
  .hero-product img {
    display: block;
    width: 64px;
    height: 64px;
    flex: none;
    object-fit: contain;
    background: #f4f2ee;
    border-radius: 8px;
  }
  .hero-product span {
    display: block;
    min-width: 0;
  }
  .hero-product strong {
    display: block;
    font-size: 13.5px;
    font-weight: 750;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }
  .hero-product small {
    display: block;
    margin-top: 3px;
    color: #6b7280;
    font-size: 11.5px;
    font-weight: 600;
  }
  @media (max-width: 960px) {
    .hero-shell {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .hero-sub {
      max-width: 640px;
    }
    .hero-product {
      left: 12px;
      bottom: 12px;
    }
  }
  @media (max-width: 520px) {
    .hero-product {
      position: static;
      max-width: none;
      margin-top: 14px;
      box-shadow: 0 8px 24px rgba(24, 35, 44, 0.1);
    }
    .hero-photo {
      aspect-ratio: 4 / 3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-btn,
    .hero-product {
      transition: none;
    }
    .hero-btn:hover,
    .hero-product:hover {
      transform: none;
    }
  }
</style>
