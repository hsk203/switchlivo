---
import type { CollectionEntry } from "astro:content";
import { modelFromSlug } from "@/lib/productModel";

interface Props {
  product: CollectionEntry<"products">;
}
const { product } = Astro.props;
const d = product.data;
const url = `/products/${product.id}/`;
const regions = d.region.join(",");
const protocols = d.protocol.join(",");
const series = d.series ?? "";
const model = modelFromSlug(product.id);
---

<article
  class="product-card reveal group rounded-xl border border-border bg-white p-4 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg"
  data-category={d.category}
  data-region={regions}
  data-protocol={protocols}
  data-series={series}
  data-title={d.title}
  data-model={model}
>
  <a href={url} class="product-item block">
    <!-- bonke: .tag 角标位 -->
    <div class="img relative mb-4 flex aspect-square w-full items-center justify-center overflow-hidden rounded-lg bg-body">
      {
        series && (
          <div class="tag absolute left-3 top-3 z-10 rounded-full bg-text-dark/85 px-2.5 py-1 text-[11px] font-semibold tracking-wide text-white shadow-sm backdrop-blur-sm">
            {series}
          </div>
        )
      }
      <img
        src={d.featuredImage}
        alt={d.title}
        loading="lazy"
        width="600"
        height="600"
        class="h-full w-full object-contain p-3 transition duration-500 group-hover:scale-105 [filter:drop-shadow(0_10px_18px_rgba(254,96,25,0.18))]"
      />
    </div>

    <!-- bonke: .info = 标题 + 型号 -->
    <div class="info">
      <h3
        class="title mb-1 line-clamp-2 text-base font-semibold text-text-dark transition group-hover:text-primary"
      >
        {d.title}
      </h3>
      <p class="model text-sm font-medium tracking-wide text-text">{model}</p>
    </div>

    <div class="mb-3 mt-3 flex min-h-[26px] flex-wrap gap-1.5">
      {
        d.region.map((r) => (
          <span class="rounded-full bg-body px-2 py-0.5 text-xs text-text">
            {r}
          </span>
        ))
      }
      {
        d.protocol.map((p) => (
          <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">
            {p}
          </span>
        ))
      }
    </div>

    <span class="inline-flex items-center text-sm font-medium text-primary">
      Inquire
      <svg
        class="ml-1 h-4 w-4"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </a>
</article>
