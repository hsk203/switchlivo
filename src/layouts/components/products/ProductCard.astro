---
import type { CollectionEntry } from "astro:content";
import { modelFromSlug } from "@/lib/productModel";
import { cdnImage } from "@/lib/cdnImage";

interface Props {
  product: CollectionEntry<"products">;
}
const { product } = Astro.props;
const d = product.data;
const url = `/products/${product.id}/`;
const regions = d.region.join(",");
const protocols = d.protocol.join(",");
const model = modelFromSlug(product.id);
---

<article
  class="product-card reveal group rounded-xl border border-border bg-white p-4 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg"
  data-category={d.category}
  data-region={regions}
  data-protocol={protocols}
  data-series={d.series ?? ""}
  data-title={d.title}
  data-model={model}
>
  <a href={url} class="product-item block">
    <div class="img relative mb-4 flex aspect-square w-full items-center justify-center overflow-hidden rounded-lg bg-body">
      <img
        src={cdnImage(d.featuredImage)}
        alt={d.title}
        loading="lazy"
        width="600"
        height="600"
        class="h-full w-full object-contain p-3 transition duration-500 group-hover:scale-105"
      />
    </div>

    <!-- bonke: .info = 标题 + 型号 -->
    <div class="info">
      <h3
        class="title mb-1 line-clamp-2 text-base font-semibold text-text-dark transition group-hover:text-primary"
      >
        {d.title}
      </h3>
      <p class="model text-sm font-medium tracking-wide text-text">{model}</p>
    </div>

    <div class="mb-3 mt-3 flex min-h-[26px] flex-wrap gap-1.5">
      {
        d.region.map((r) => (
          <span class="rounded-full bg-body px-2 py-0.5 text-xs text-text">
            {r}
          </span>
        ))
      }
      {
        d.protocol.map((p) => (
          <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">
            {p}
          </span>
        ))
      }
    </div>
  </a>
</article>
