          <circle class="smoke-led" cx="900" cy="443" r="2" fill="#F97316"/>
          <text x="900" y="482" text-anchor="middle" class="lbl">Smoke</text>
          <text x="900" y="495" text-anchor="middle" class="lbl">Alarm</text>
        </g>
        <!-- 12 motion sensor: the standard walking-man pictogram (Material
             Symbols "directions_walk"), static, with a human-shaped pulse
             expanding outwards like the smoke alarm's ring -->
        <g class="float" style="animation-delay:1.2s">
          <!-- the pulse: the same figure as a fat orange outline, growing and fading -->
          <g class="ms-ghost" aria-hidden="true">
            <path d="m280-40 112-564-72 28v136h-80v-188l202-86q14-6 29.5-7t29.5 4q14 5 26.5 14t20.5 23l40 64q26 42 70.5 69T760-520v80q-70 0-125-29t-94-74l-25 123 84 80v300h-80v-260l-84-64-72 324h-84Zm203.5-723.5Q460-787 460-820t23.5-56.5Q507-900 540-900t56.5 23.5Q620-853 620-820t-23.5 56.5Q573-740 540-740t-56.5-23.5Z" transform="translate(1002.68 464.86) scale(-0.0454 0.0454)" fill="none" stroke="#F97316" stroke-width="28" stroke-linejoin="round"/>
          </g>
          <!-- the person itself, still -->
          <g class="ms-person">
            <path d="m280-40 112-564-72 28v136h-80v-188l202-86q14-6 29.5-7t29.5 4q14 5 26.5 14t20.5 23l40 64q26 42 70.5 69T760-520v80q-70 0-125-29t-94-74l-25 123 84 80v300h-80v-260l-84-64-72 324h-84Zm203.5-723.5Q460-787 460-820t23.5-56.5Q507-900 540-900t56.5 23.5Q620-853 620-820t-23.5 56.5Q573-740 540-740t-56.5-23.5Z" transform="translate(1002.68 464.86) scale(-0.0454 0.0454)" fill="#CBD5E1"/>
          </g>
          <text x="980" y="482" text-anchor="middle" class="lbl">Motion</text>
          <text x="980" y="495" text-anchor="middle" class="lbl">Sensor</text>
        </g>
        <!-- 13 curtain motor: a window whose two panels part and meet again,
             driven by a tiny wheel spinning on the spot on the top rail -->
        <g class="float" style="animation-delay:1.3s">
          <!-- window frame: drawn open at the bottom, so no sill line -->
          <path d="M1044 460 V431 Q1044 428 1047 428 H1073 Q1076 428 1076 431 V460"
                fill="#fff" stroke="#CBD5E1" stroke-width="1.5" stroke-linejoin="round"/>
          <!-- glass -->
          <rect x="1046.5" y="430.5" width="27" height="29" rx="2" fill="#F1F5F9"/>
          <!-- left panel: wavy bottom edge, folds running top to bottom -->
          <g class="curtain-l">
            <path class="curtain-panel" d="M1046.5 431 H1060 V459.5 q-1.7 -2 -3.4 0 t-3.4 0 t-3.4 0 t-3.4 0 V431 Z"/>
            <line class="curtain-fold" x1="1050" y1="432" x2="1050" y2="457"/>
            <line class="curtain-fold" x1="1053.5" y1="432" x2="1053.5" y2="457"/>
            <line class="curtain-fold" x1="1057" y1="432" x2="1057" y2="457"/>
          </g>
          <!-- right panel: mirror of the left -->
          <g class="curtain-r">
            <path class="curtain-panel" d="M1060 431 H1073.5 V459.5 q-1.7 -2 -3.4 0 t-3.4 0 t-3.4 0 t-3.4 0 V431 Z"/>
            <line class="curtain-fold" x1="1063" y1="432" x2="1063" y2="457"/>
            <line class="curtain-fold" x1="1066.5" y1="432" x2="1066.5" y2="457"/>
            <line class="curtain-fold" x1="1070" y1="432" x2="1070" y2="457"/>
          </g>
          <!-- drive wheel: spins in place on the top rail -->
          <g class="curtain-drive">
            <circle cx="1060" cy="429.5" r="2.6" fill="#fff" stroke="#CBD5E1" stroke-width="1"/>
            <line x1="1060" y1="426.9" x2="1060" y2="432.1" stroke="#CBD5E1" stroke-width="1"/>
            <line x1="1057.4" y1="429.5" x2="1062.6" y2="429.5" stroke="#CBD5E1" stroke-width="1"/>
            <circle cx="1060" cy="429.5" r="0.7" fill="#F97316"/>
          </g>
          <text x="1060" y="482" text-anchor="middle" class="lbl">Curtain</text>
