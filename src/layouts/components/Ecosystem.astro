        </g>

        <defs>
          <linearGradient id="hubGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#FB923C"/>
            <stop offset="1" stop-color="#F97316"/>
          </linearGradient>
          <!-- the car is clipped at x=704, so driving left it vanishes edge-first
               but always keeps a sliver of its tail outside the wall -->
          <clipPath id="garageCarClip">
            <rect x="704" y="436" width="128" height="28"/>
          </clipPath>
          <!-- the shutter only exists inside the doorway; above the lintel bottom
               it is cut away, so the coil visually hides inside the lintel -->
          <clipPath id="garageDoorClip">
            <rect x="726" y="446" width="28" height="18"/>
          </clipPath>
        </defs>
      </svg>
    </div>
  </div>
</section>

<style>
  .eco {
    background: transparent;
  }

  /* heading: same family / size / orange gradient as the hero headline */
  .eco-heading {
    margin: 0 0 1.5rem;
    text-align: center;
    font-family: var(--font-secondary);
    font-weight: 700;
    line-height: 1.25;
    font-size: var(--text-h1-sm);
    background-image: linear-gradient(to left, #f97316, #fb923c, #fbbf24);
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  /* same, for nodes injected by the browser's page translator */
  :global(.eco-heading *) {
    background-image: linear-gradient(to left, #f97316, #fb923c, #fbbf24);
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  @media (min-width: 48rem) {
    .eco-heading {
      font-size: var(--text-h1);
    }
  }

  /* the diagram gets a wider track than the page grid so it reads bigger.
     the actual max-width lives in src/styles/components.css — it has to sit in
     the same cascade layer as .container for the !important to win. */
  .eco-figure {
    width: 100%;
    max-width: 100%;
  }
  .eco-figure svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* All diagram copy is navy blue — one deep tone for the primary labels,
     one lighter navy tint for the annotations, so hierarchy survives. */
  .lbl {
    font-size: 11.5px;
    fill: #1b3a6b;
  }
  .note {
    font-size: 12px;
    font-style: italic;
    fill: #4e6790;
  }
  .row-lbl {
    font-size: 14px;
    font-weight: 700;
    fill: #1b3a6b;
  }
  /* same size / weight / colour as the gateway labels */
  .box-head {
    font-size: 14px;
    font-weight: 700;
    fill: #1b3a6b;
  }
  .chip-lbl {
    font-size: 12.5px;
    font-weight: 600;
    fill: #1b3a6b;
  }
  .tuya-lbl {
    font-size: 14px;
    font-weight: 700;
    fill: #1b3a6b;
  }
  .gw-lbl {
    font-size: 14px;
    font-weight: 700;
    fill: #1b3a6b;
  }
  .gw-lbl2 {
    font-size: 14px;
    font-weight: 600;
    fill: #1b3a6b;
  }
  .zigbee-lbl {
    font-size: 14px;
    font-weight: 700;
    fill: #1b3a6b;
  }
  .matter-lbl {
    font-size: 15px;
    font-weight: 700;
    fill: #1b3a6b;
  }

  /* text knocked out over dashed lines */
  .halo {
    paint-order: stroke;
    stroke: #fafafa;
    stroke-width: 9px;
    stroke-linejoin: round;
  }

  /* flowing dashed links */
  .flow {
    stroke-dasharray: 5 7;
    animation: eco-dash 1.1s linear infinite;
  }
  @keyframes eco-dash {
    to {
      stroke-dashoffset: -24;
    }
  }

  /* floating disabled for now — the diagram reads calmer without it.
     to bring it back: animation: eco-bob 4.5s ease-in-out infinite; */
  .float {
    animation: none;
  }
  @keyframes eco-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  .pkt {
    offset-rotate: 0deg;
  }

  /* traveling packets blink while they move, staggered in three groups */
  .pkt {
    animation: pkt-pulse 0.9s ease-in-out infinite;
  }
  .pkts circle:nth-of-type(3n + 2) {
    animation-delay: 0.3s;
  }
  .pkts circle:nth-of-type(3n) {
    animation-delay: 0.6s;
  }
  @keyframes pkt-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.15;
    }
  }

  /* router LEDs fade out to nothing, then fade back in, in sequence */
  .eco-mod {
    animation: eco-mod 1.8s ease-in-out infinite;
  }
  @keyframes eco-mod {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.2;
    }
  }
  .led {
    animation: eco-blink 1.5s ease-in-out infinite;
  }
  @keyframes eco-blink {
    0%,
    100% {
      opacity: 1;
    }
    45%,
    55% {
      opacity: 0;
    }
  }

  /* thermostat mode dots pulse one after another */
  .tstat-led {
    animation: eco-tstat 1.6s ease-in-out infinite;
  }
  @keyframes eco-tstat {
    0%,
    100% {
      opacity: 0.2;
    }
    45% {
      opacity: 1;
    }
  }

  /* thermostat temperature climbs from 18.0 to 26.0: shows for a second,
     flashes twice, then the next value appears */
  .tstat-temp {
    opacity: 0;
    animation: tstat-temp 9s linear infinite;
  }
  @keyframes tstat-temp {
    0%,
    7.5% {
      opacity: 1;
    }
    8.5%,
    10.5% {
      opacity: 0.1;
    }
    9.5% {
      opacity: 1;
    }
    11%,
    100% {
      opacity: 0;
    }
  }

  /* level bars: 8s cycle — segment n appears at n * 1.25s, all six stay lit,
     then everything blanks out and the fill restarts */
  .bar-1 {
    animation: bar-1 8s linear infinite;
  }
  .bar-2 {
    animation: bar-2 8s linear infinite;
  }
  .bar-3 {
    animation: bar-3 8s linear infinite;
  }
  .bar-4 {
    animation: bar-4 8s linear infinite;
  }
  .bar-5 {
    animation: bar-5 8s linear infinite;
  }
  .bar-6 {
    animation: bar-6 8s linear infinite;
  }
  @keyframes bar-1 {
    0% {
      opacity: 0;
    }
    12.5%,
    100% {
      opacity: 1;
    }
  }
  @keyframes bar-2 {
    0%,
    12.5% {
      opacity: 0;
    }
    25%,
    100% {
      opacity: 1;
    }
  }
  @keyframes bar-3 {
    0%,
    25% {
      opacity: 0;
    }
    37.5%,
    100% {
      opacity: 1;
    }
  }
  @keyframes bar-4 {
    0%,
    37.5% {
      opacity: 0;
    }
    50%,
    100% {
      opacity: 1;
    }
  }
  @keyframes bar-5 {
    0%,
    50% {
      opacity: 0;
    }
    62.5%,
    100% {
      opacity: 1;
    }
  }
  @keyframes bar-6 {
    0%,
    62.5% {
      opacity: 0;
    }
    75%,
    100% {
      opacity: 1;
    }
  }

  /* smoke alarm: expanding detection ping + blinking status led */
  .smoke-pulse {
    transform-origin: 900px 443px;
    animation: eco-smoke 2.4s ease-out infinite;
  }
  @keyframes eco-smoke {
    0% {
      transform: scale(0.72);
      opacity: 0.85;
    }
    70%,
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }
  .smoke-led {
    animation: eco-blink 1.6s ease-in-out infinite;
  }
  .vac-led {
    animation: vac-blink 1.2s ease-in-out infinite;
    transform-origin: 419.8px 439px;
  }
  @keyframes vac-blink {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(1.5);
    }
  }

  /* motion sensor: the walking man is still; a human-shaped ghost behind it
     grows outwards and fades — same beat as the smoke alarm's ring */
  .ms-ghost {
    transform-origin: 980px 443px;
    animation: ms-ghost 2.4s ease-out infinite;
  }
  @keyframes ms-ghost {
    0% {
      transform: scale(0.82);
      opacity: 0.5;
    }
    45% {
      transform: scale(1.12);
      opacity: 0.28;
    }
    78%,
    100% {
      transform: scale(1.38);
      opacity: 0;
    }
  }

  /* mobile fingerprint reader: ring expands outwards while the inner ring blinks */
  .fp-ring {
    transform-origin: 1040px 57px;
    animation: fp-smoke 2.4s ease-out infinite;
  }
  @keyframes fp-smoke {
    0% {
      transform: scale(0.85);
      opacity: 0.85;
    }
    70%,
    100% {
      transform: scale(1.18);
      opacity: 0;
    }
  }
  .fp-core {
    animation: eco-blink 1.6s ease-in-out infinite;
  }

  /* curtain motor: the two panels part and meet again (narrowing as they
     draw back, like fabric gathering), while the little drive wheel turns
     on the spot on the top rail */
  .curtain-panel {
    fill: #ffedd5;
    stroke: #f97316;
    stroke-width: 1.2;
  }

  .curtain-fold {
    stroke: #fdba74;
    stroke-width: 0.9;
  }

  .curtain-l {
    transform-origin: 1046.5px 445px;
    animation: curtain-open-l 7s ease-in-out infinite;
  }

  .curtain-r {
    transform-origin: 1073.5px 445px;
    animation: curtain-open-r 7s ease-in-out infinite;
  }

  @keyframes curtain-open-l {
    0%,
    12% {
      transform: scaleX(1);
    }
    40%,
    68% {
      transform: scaleX(0.52);
    }
    100% {
      transform: scaleX(1);
    }
  }

  @keyframes curtain-open-r {
    0%,
    12% {
      transform: scaleX(1);
    }
    40%,
    68% {
      transform: scaleX(0.52);
    }
    100% {
      transform: scaleX(1);
    }
  }

  .curtain-drive {
    transform-origin: 1060px 429.5px;
    animation: eco-spin 2.8s linear infinite;
  }

  /* smart door lock: keypad wave, fingerprint scan, handle release */
  .lock-key {
    animation: lock-key 3s linear infinite;
  }
  @keyframes lock-key {
    0%,
    25%,
    100% {
      fill: #94a3b8;
    }
    12% {
      fill: #f97316;
    }
  }
  .lock-fp-ring {
    transform-origin: 506.5px 448px;
    animation: eco-smoke 2.2s ease-out infinite;
  }
  .lock-handle {
    transform-origin: 506.5px 448px;
    animation: lock-turn 4.4s ease-in-out infinite;
  }
  @keyframes lock-turn {
    0%,
    50%,
    100% {
      transform: rotate(0deg);
    }
    58%,
    72% {
      transform: rotate(14deg);
    }
    82% {
      transform: rotate(0deg);
    }
  }

  /* rf remote: the centre button presses as the signal wave goes out */
  .rf-btn {
    transform-origin: 820px 455.5px;
    animation: rf-press 2.6s linear infinite;
  }
  @keyframes rf-press {
    0%,
    42% {
      transform: scale(1);
    }
    47% {
      transform: scale(0.7);
    }
    55%,
    100% {
      transform: scale(1);
    }
  }

  /* ptz camera: the head stays put, the face turns left / right inside it —
     narrowest at the extremes, full width when facing front */
  .cam-lens {
    transform-origin: 580px 437px;
    animation: cam-pan 4s ease-in-out infinite;
  }
  /* status strip on the base: slow breathing blink */
  .cam-strip {
    animation: eco-blink 2s ease-in-out infinite;
  }
  @keyframes cam-pan {
    0%,
    100% {
      transform: translateX(-3px) scaleX(0.85);
    }
    25%,
    75% {
      transform: translateX(0) scaleX(1);
    }
    50% {
      transform: translateX(3px) scaleX(0.85);
    }
  }

  /* robot vacuum: mirrored robot slides in/out of its dock notch */
  .eco-vac {
    animation: eco-vac 4.6s ease-in-out infinite;
  }
  @keyframes eco-vac {
    0%,
    18% {
      transform: translateX(0);
    }
    52%,
    82% {
      transform: translateX(-38px);
    }
    100% {
      transform: translateX(0);
    }
  }

  /* circulation fan: the ring head sways left/right, the blades spin inside it */
  .fan-head {
    transform-origin: 660px 447px;
    animation: eco-fan-sway 3.4s ease-in-out infinite;
  }
  @keyframes eco-fan-sway {
    0%,
    100% {
      transform: rotate(-15deg);
    }
    50% {
      transform: rotate(15deg);
    }
  }

  /* fan blades spin around the hub */
  .fan-blades {
    transform-origin: 660px 436px;
    animation: eco-spin 1.4s linear infinite;
  }
  @keyframes eco-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* garage: one shared 14s loop —
       1.7-4.0s  shutter rolls up slowly into the lintel
       4.0-6.6s  car drives out and is swallowed by the wall
       6.6-8.6s  shutter closes again while the car is away
       8.6-10.6s shutter opens a second time
      10.6-12.4s car backs out of the wall into the garage
      12.4-14.0s shutter closes, car parked inside */
  .garage-door {
    transform: translateY(0);
    animation: garage-door 14s ease-in-out infinite;
  }
  @keyframes garage-door {
    0%,
    12% {
      transform: translateY(0);
    }
    28%,
    47% {
      transform: translateY(-20px);
    }
    61%,
    68% {
      transform: translateY(0);
    }
    76%,
    86% {
      transform: translateY(-20px);
    }
    98%,
    100% {
      transform: translateY(0);
    }
  }
  .eco-car {
    transform: translateX(0);
    animation: eco-car 14s ease-in-out infinite;
  }
  @keyframes eco-car {
    0%,
    28% {
      transform: translateX(0);
    }
    47% {
      transform: translateX(-66px);
    }
    68% {
      transform: translateX(-66px);
    }
    86% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(0);
    }
  }

  /* Wi-Fi signal fills up from the dot outwards, then resets */
  .wifi-dot,
  .wifi-a1,
  .wifi-a2,
  .wifi-a3 {
    animation-duration: 2.6s;
    animation-iteration-count: infinite;
    animation-timing-function: linear;
  }
  .wifi-dot {
    animation-name: eco-wifi-0;
  }
  .wifi-a1 {
    animation-name: eco-wifi-1;
  }
  .wifi-a2 {
    animation-name: eco-wifi-2;
  }
  .wifi-a3 {
    animation-name: eco-wifi-3;
  }
  @keyframes eco-wifi-0 {
    0%,
    3% {
      opacity: 0;
    }
    9%,
    93% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes eco-wifi-1 {
    0%,
    21% {
      opacity: 0;
    }
    27%,
    93% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes eco-wifi-2 {
    0%,
    41% {
      opacity: 0;
    }
    47%,
    93% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes eco-wifi-3 {
    0%,
    61% {
      opacity: 0;
    }
    67%,
    93% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow,
    .float,
    .fan-blades,
    .fan-head,
    .eco-car,
    .garage-door,
    .led,
    .tstat-led,
    .tstat-temp,
    .smoke-pulse,
    .smoke-led,
    .vac-led,
    .ms-ghost,
    .fp-ring,
    .fp-core,
    .curtain-l,
    .curtain-r,
    .curtain-drive,
    .lock-key,
    .lock-fp-ring,
    .lock-handle,
    .rf-btn,
    .cam-lens,
    .cam-strip,
    .eco-vac,
    .wifi-dot,
    .wifi-a1,
    .wifi-a2,
    .wifi-a3,
    .eco-mod,
    .tstat-bar {
      animation: none;
    }
    .eco-car {
      transform: translateX(-66px);
    }
    .garage-door {
      transform: translateY(-20px);
    }
    .eco-vac {
      transform: translateX(-38px);
    }
    .tstat-led {
      opacity: 0.7;
    }
    .tstat-temp-hold {
      opacity: 1;
    }
    .pkts {
      display: none;
    }
  }
</style>
