        <!-- 11 smoke alarm -->
        <g class="float" style="animation-delay:.8s">
          <!-- pulsing detection ring -->
          <circle class="smoke-pulse" cx="900" cy="443" r="16" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <!-- body -->
          <circle cx="900" cy="443" r="16" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <!-- perforation ring -->
          <circle cx="900" cy="443" r="12" fill="none" stroke="#CBD5E1" stroke-width="1.2" stroke-dasharray="2 2.4"/>
          <!-- centre button + led -->
