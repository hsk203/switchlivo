---
// Connectivity — replaces the old 13-device animated SVG diagram
// ("Designed For Your Real Life"), which crammed Cloud, Voice, Zigbee /
// BLE-mesh, Matter, Robot Vacuum, DoorLock, Garage and more into tiny
// unreadable text. What remains is three plain statements and the six
// protocols the product files actually list. No diagram, no tiny text.
const protocols = ["Wi-Fi", "Zigbee", "Matter", "KNX", "RS485", "Tuya"];
---

<section class="connect" aria-labelledby="connect-title">
  <div class="connect-shell">
    <span class="connect-kicker">CONNECTIVITY</span>
    <h2 id="connect-title">Your panels, connected your way.</h2>
    <p class="connect-lede">
      Every panel connects through the protocols your project already uses —
      app, voice, wireless or wired.
    </p>
    <ul class="connect-lines">
      <li>
        <strong>App control</strong>
        <span>Control lighting, scenes and climate from the Tuya app.</span>
      </li>
      <li>
        <strong>Voice and automation</strong>
        <span>Matter, Zigbee and KNX link panels into the wider smart home.</span>
      </li>
      <li>
        <strong>Wired where it matters</strong>
        <span>RS485 for projects that need a wired bus instead of wireless.</span>
      </li>
    </ul>
    <ul class="connect-chips" aria-label="Supported protocols">
      {
        protocols.map((p) => (
          <li>{p}</li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .connect {
    padding: clamp(64px, 8vw, 104px) 0;
    background: #fff;
    color: #1a202c;
  }
  .connect-shell {
    width: min(860px, calc(100% - 48px));
    margin-inline: auto;
    text-align: center;
  }
  .connect-kicker {
    display: block;
    color: #b84311;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }
  .connect h2 {
    margin: 16px 0 0;
    color: #1a202c;
    font-family: var(--font-primary);
    font-size: clamp(32px, 4.4vw, 52px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .connect-lede {
    max-width: 620px;
    margin: 18px auto 0;
    color: #4b5563;
    font-size: 15px;
    line-height: 1.75;
  }
  .connect-lines {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    list-style: none;
    margin: 44px 0 0;
    padding: 0;
    text-align: left;
  }
  .connect-lines li {
    border-top: 2px solid #1a202c;
    padding-top: 16px;
  }
  .connect-lines strong {
    display: block;
    color: #1a202c;
    font-size: 15px;
    font-weight: 750;
    letter-spacing: -0.01em;
  }
  .connect-lines span {
    display: block;
    margin-top: 6px;
    color: #6b7280;
    font-size: 13px;
    line-height: 1.65;
  }
  .connect-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
  }
  .connect-chips li {
    border: 1px solid #d9d6d0;
    border-radius: 999px;
    padding: 8px 16px;
    color: #1a202c;
    font-size: 13px;
    font-weight: 700;
  }
  @media (max-width: 700px) {
    .connect-lines {
      grid-template-columns: 1fr;
      gap: 24px;
      text-align: left;
    }
  }
</style>
