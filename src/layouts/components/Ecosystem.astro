---
// "Designed For Your Real Life" — full-width, wide/short ecosystem diagram.
// Orthogonal (right-angle) dashed routing like the reference material.
// All devices from the source diagram are included. Zero dependencies.
---

<section class="section eco">
  <div class="container eco-wide">
    <h2 class="eco-heading">Designed For Your Real Life</h2>
  </div>

  <div class="container eco-wide">
    <div class="eco-figure">
      <svg viewBox="45 11 1115 501" role="img" aria-label="Smart home communication diagram: cloud, router and mobile phone outside the home; Wi-Fi branches to voice assistants and the Tuya platform gateways (Zigbee / BLE-mesh); Matter over Wi-Fi and Thread; a single-row device bus connects free posting switch, smart switches 1-4, control panel, thermostat, robot vacuum, smart door lock, camera, fan, garage, RF remote, smoke alarm, motion sensor and curtain motor.">
        <!-- decorations -->
        <g>
          <circle cx="330" cy="118" r="3" fill="#F97316" opacity=".45"/>
          <circle cx="880" cy="128" r="3" fill="#22C55E" opacity=".45"/>
          <circle cx="75" cy="190" r="3" fill="#3B82F6" opacity=".4"/>
          <circle cx="1160" cy="220" r="3" fill="#F97316" opacity=".4"/>
          <circle cx="905" cy="500" r="3" fill="#22C55E" opacity=".4"/>
        </g>

        <!-- ============ orthogonal links ============ -->
        <g fill="none" stroke="rgba(249,115,22,.45)" stroke-width="1.6">
          <!-- cloud <-> mobile -->
          <path class="flow" d="M645 45 H1020"/>
          <!-- cloud -> router -->
          <path class="flow" d="M600 67 V106"/>
          <!-- router -> branch bus -->
          <path class="flow" d="M600 144 V174"/>
          <!-- branch bus -->
          <path class="flow" d="M180 174 H1020"/>
          <!-- branches down to boxes -->
          <path class="flow" d="M180 174 V212"/>
          <path class="flow" d="M1020 174 V212"/>
          <!-- branch drops to gateways -->
          <path class="flow" d="M490 174 V242"/>
          <path class="flow" d="M710 174 V242"/>
          <!-- voice box -> tuya zone -->
          <path class="flow" d="M300 272 H330"/>
          <!-- right box -> matter -> bus -->
          <path class="flow" d="M1020 337 V352"/>
          <path class="flow" d="M1020 392 V411"/>
          <!-- gateways -> device bus -->
          <path class="flow" d="M490 318 V411"/>
          <path class="flow" d="M710 318 V411"/>
          <!-- device bus (ends flush with the first / last stub) -->
          <path class="flow" d="M100 411 H1060"/>
          <!-- device stubs -->
          <path class="flow" d="M100 411 V423"/>
          <path class="flow" d="M180 411 V423"/>
          <path class="flow" d="M260 411 V423"/>
          <path class="flow" d="M340 411 V423"/>
          <path class="flow" d="M420 411 V434"/>
          <path class="flow" d="M500 411 V423"/>
          <path class="flow" d="M580 411 V423"/>
          <path class="flow" d="M660 411 V426"/>
          <path class="flow" d="M740 411 V436"/>
          <path class="flow" d="M820 411 V423"/>
          <path class="flow" d="M900 411 V423"/>
          <path class="flow" d="M980 411 V423"/>
          <path class="flow" d="M1060 411 V430"/>
        </g>

        <!-- ============ traveling packets ============ -->
        <g class="pkts">
          <!-- cloud -> router -->
          <circle class="pkt" r="3.2" fill="#F97316">
            <animateMotion dur="1.6s" repeatCount="indefinite" path="M600 67 L600 106"/>
          </circle>
          <!-- router -> branch bus -> left gateway -->
          <circle class="pkt" r="3.2" fill="#FB923C">
            <animateMotion dur="2.6s" repeatCount="indefinite" path="M600 144 L600 174 L490 174 L490 242"/>
          </circle>
          <!-- router -> branch bus -> right gateway -->
          <circle class="pkt" r="3" fill="#FBBF24">
            <animateMotion dur="2s" begin="0.9s" repeatCount="indefinite" path="M600 174 L710 174 L710 242"/>
          </circle>
          <!-- right gateway -> device bus -> matter -->
          <circle class="pkt" r="3" fill="#FB923C">
            <animateMotion dur="3.4s" repeatCount="indefinite" path="M710 318 L710 411 L1020 411 L1020 393"/>
          </circle>
          <!-- cloud -> mobile phone -->
          <circle class="pkt" r="3" fill="#F97316">
            <animateMotion dur="3s" repeatCount="indefinite" path="M645 45 L1020 45"/>
          </circle>
          <!-- mobile phone -> cloud (return) -->
          <circle class="pkt" r="2.8" fill="#FBBF24">
            <animateMotion dur="3s" begin="1.5s" repeatCount="indefinite" path="M1020 45 L645 45"/>
          </circle>
          <!-- branch bus -> voice control box -->
          <circle class="pkt" r="2.8" fill="#FB923C">
            <animateMotion dur="2.2s" begin="1.1s" repeatCount="indefinite" path="M600 174 L180 174 L180 212"/>
          </circle>
          <!-- branch bus -> ecosystem box -->
          <circle class="pkt" r="2.8" fill="#FBBF24">
            <animateMotion dur="2.2s" begin="0.4s" repeatCount="indefinite" path="M600 174 L1020 174 L1020 212"/>
          </circle>
          <!-- voice control box -> tuya zone -->
          <circle class="pkt" r="2.6" fill="#F97316">
            <animateMotion dur="1.2s" repeatCount="indefinite" path="M300 272 L330 272"/>
          </circle>
          <!-- left gateway -> device bus -> wire-free switch -->
          <circle class="pkt" r="2.8" fill="#FB923C">
            <animateMotion dur="3.2s" begin="0.6s" repeatCount="indefinite" path="M490 318 L490 411 L100 411 L100 423"/>
          </circle>
          <!-- device bus sweep to the control panel -->
          <circle class="pkt" r="2.8" fill="#F97316">
            <animateMotion dur="3s" begin="1.8s" repeatCount="indefinite" path="M710 411 L1060 411 L1060 430"/>
          </circle>
          <!-- device bus -> fan branch -->
          <circle class="pkt" r="2.8" fill="#FBBF24">
            <animateMotion dur="2.4s" begin="0.8s" repeatCount="indefinite" path="M490 411 L660 411 L660 424"/>
          </circle>
        </g>

        <!-- ============ junction dots ============ -->
        <g>
          <circle cx="490" cy="174" r="3" fill="#F97316" opacity=".7"/>
          <circle cx="710" cy="174" r="3" fill="#F97316" opacity=".7"/>
          <circle cx="490" cy="411" r="3" fill="#F97316" opacity=".7"/>
          <circle cx="710" cy="411" r="3" fill="#F97316" opacity=".7"/>
          <circle cx="1020" cy="411" r="3" fill="#F97316" opacity=".7"/>
        </g>

        <!-- ============ cloud ============ -->
        <g class="float" style="animation-delay:0s">
          <path d="M626.34 44.59C623.9 36.83 613.04 31 600 31C589.64 31 580.65 34.69 576.17 40.09C565.38 40.81 557 46.55 557 53.5c0 7.45 9.64 13.5 21.5 13.5h46.58c9.89 0 17.92-5.04 17.92-11.25c0-5.94-7.35-10.76-16.66-11.16z"
                fill="#fff" stroke="#F97316" stroke-width="2"/>
          <text x="600" y="88" text-anchor="middle" class="lbl halo">Cloud</text>
        </g>

        <!-- ============ mobile ============ -->
        <g class="float" style="animation-delay:.6s">
          <!-- body -->
          <rect x="1024" y="18" width="32" height="56" rx="7" fill="#fff" stroke="#94A3B8" stroke-width="1.8"/>
          <!-- screen -->
          <rect x="1027.5" y="24.5" width="25" height="43" rx="3.5" fill="#CBD5E1"/>
          <!-- fingerprint reader: pulsing ring + static core, blinking in place -->
          <circle class="fp-ring" cx="1040" cy="57" r="5" fill="none" stroke="#F97316" stroke-width="1.2"/>
          <circle class="fp-core" cx="1040" cy="57" r="4.2" fill="none" stroke="#F97316" stroke-width="1" opacity=".85"/>
          <circle cx="1040" cy="57" r="1.6" fill="#F97316"/>
          <!-- notch: speaker slit + front camera -->
          <path d="M1034.5 24.5 V25.8 Q1034.5 28 1036.7 28 H1043.3 Q1045.5 28 1045.5 25.8 V24.5 Z" fill="#fff"/>
          <line x1="1037.4" y1="26.3" x2="1040.6" y2="26.3" stroke="#94A3B8" stroke-width="1" stroke-linecap="round"/>
          <circle cx="1042.3" cy="26.3" r="0.7" fill="#94A3B8"/>
          <!-- home indicator -->
          <line x1="1035.8" y1="64" x2="1044.2" y2="64" stroke="#94A3B8" stroke-width="1.3" stroke-linecap="round"/>
          <text x="1040" y="88" text-anchor="middle" class="lbl">Mobile Phone</text>
        </g>
        <text x="832" y="35" text-anchor="middle" class="lbl">Outside the home</text>

        <!-- ============ router ============ -->
        <g class="float" style="animation-delay:.3s">
          <line x1="578" y1="120" x2="572" y2="106" stroke="#94A3B8" stroke-width="2" stroke-linecap="round"/>
          <line x1="622" y1="120" x2="628" y2="106" stroke="#94A3B8" stroke-width="2" stroke-linecap="round"/>
          <rect x="558" y="120" width="84" height="24" rx="7" fill="#fff" stroke="#94A3B8" stroke-width="1.8"/>
          <circle class="led" cx="572" cy="132" r="2.4" fill="#F97316" style="animation-delay:0s"/>
          <circle class="led" cx="583" cy="132" r="2.4" fill="#FBBF24" style="animation-delay:.25s"/>
          <circle class="led" cx="594" cy="132" r="2.4" fill="#22C55E" style="animation-delay:.5s"/>
          <!-- internal module slot / cabinet -->
          <rect class="eco-mod" x="606" y="127" width="32" height="10" rx="3" fill="#fff" stroke="#CBD5E1" stroke-width="1.4"/>
          <text x="600" y="160" text-anchor="middle" class="lbl halo">Router</text>
        </g>

        <!-- wi-fi chips on the branch bus -->
        <g class="float" style="animation-delay:.9s">
          <rect x="348" y="164" width="64" height="20" rx="10" fill="#FFF7ED" stroke="#F97316" stroke-width="1.4"/>
          <g fill="none" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round">
            <path class="wifi-a3" d="M353.5 171.5 a13 13 0 0 1 17 0"/>
            <path class="wifi-a2" d="M356.5 174.5 a9 9 0 0 1 11 0"/>
            <path class="wifi-a1" d="M359.5 177.5 a5 5 0 0 1 5 0"/>
          </g>
          <circle class="wifi-dot" cx="362" cy="181" r="1.4" fill="#EA580C"/>
          <text x="376" y="178" class="chip-lbl">Wi-Fi</text>
        </g>
        <g class="float" style="animation-delay:1.5s">
          <rect x="788" y="164" width="64" height="20" rx="10" fill="#FFF7ED" stroke="#F97316" stroke-width="1.4"/>
          <g fill="none" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round">
            <path class="wifi-a3" d="M793.5 171.5 a13 13 0 0 1 17 0"/>
            <path class="wifi-a2" d="M796.5 174.5 a9 9 0 0 1 11 0"/>
            <path class="wifi-a1" d="M799.5 177.5 a5 5 0 0 1 5 0"/>
          </g>
          <circle class="wifi-dot" cx="802" cy="181" r="1.4" fill="#EA580C"/>
          <text x="816" y="178" class="chip-lbl">Wi-Fi</text>
        </g>

        <!-- ============ left box : voice control ============ -->
        <g>
          <rect x="60" y="212" width="240" height="120" rx="14" fill="none" stroke="#CBD5E1" stroke-width="1.6"/>
          <text x="180" y="237" text-anchor="middle" class="box-head">Voice Control</text>
          <circle cx="100" cy="264" r="11" fill="#FFF7ED" stroke="#F97316" stroke-width="1.4"/>
          <circle cx="100" cy="264" r="4" fill="#F97316"/>
          <text x="122" y="269" class="row-lbl">Amazon Alexa</text>
          <circle cx="100" cy="302" r="11" fill="#FFF7ED" stroke="#F97316" stroke-width="1.4"/>
          <circle cx="100" cy="302" r="4" fill="#F97316"/>
          <text x="122" y="307" class="row-lbl">Hey Google</text>
        </g>

        <!-- ============ right box : ecosystems ============ -->
        <g>
          <rect x="900" y="212" width="240" height="125" rx="14" fill="none" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="935" cy="243" r="11" fill="#FFF7ED" stroke="#F97316" stroke-width="1.4"/>
          <circle cx="935" cy="243" r="4" fill="#F97316"/>
          <text x="957" y="248" class="row-lbl">Apple HomePod</text>
          <circle cx="935" cy="276" r="11" fill="#FFF7ED" stroke="#F97316" stroke-width="1.4"/>
          <circle cx="935" cy="276" r="4" fill="#F97316"/>
          <text x="957" y="281" class="row-lbl">Amazon Echo</text>
          <circle cx="935" cy="309" r="11" fill="#FFF7ED" stroke="#F97316" stroke-width="1.4"/>
          <circle cx="935" cy="309" r="4" fill="#F97316"/>
          <text x="957" y="314" class="row-lbl">Google Nest</text>
        </g>

        <!-- ============ tuya platform zone ============ -->
        <rect x="330" y="212" width="540" height="165" rx="18" fill="none"
              stroke="#F87171" stroke-width="1.6" stroke-dasharray="7 6"/>
        <!-- tuya logo badge, straddling the top border of the tuya zone
             (square top-left / bottom-right, rounded top-right / bottom-left) -->
        <g>
          <path d="M568.5 198.5 H617.5 A7 7 0 0 1 624.5 205.5 V225.5 H575.5 A7 7 0 0 1 568.5 218.5 Z" fill="#F0512D"/>
          <text x="594" y="217" text-anchor="middle" style="font-family:'Nunito','Quicksand','Varela Round',var(--font-primary),sans-serif; font-size:14px; font-weight:800; letter-spacing:.2px; fill:#fff;">tuya</text>
          <!-- wifi arcs over the a, pulsing in sequence -->
          <g fill="none" stroke="#fff" stroke-width="1.3" stroke-linecap="round">
            <path class="wifi-a1" d="M609.5 204.8 a3.2 3.2 0 0 1 4.4 0"/>
            <path class="wifi-a2" d="M608 202.5 a5.5 5.5 0 0 1 7.4 0"/>
          </g>
          <circle class="wifi-dot" cx="611.5" cy="206.5" r="1" fill="#fff"/>
        </g>

        <!-- gateway 1 (main) -->
        <g class="float" style="animation-delay:.2s">
          <rect x="452" y="242" width="76" height="76" rx="16" fill="url(#hubGrad)" stroke="#EA580C" stroke-width="1.6"/>
          <rect x="472" y="258" width="14" height="14" rx="3" fill="none" stroke="#fff" stroke-width="2"/>
          <rect x="494" y="258" width="14" height="14" rx="3" fill="none" stroke="#fff" stroke-width="2" opacity=".65"/>
          <line x1="476" y1="286" x2="504" y2="286" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".8"/>
          <line x1="476" y1="294" x2="496" y2="294" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".5"/>
          <text x="444" y="276" text-anchor="end" class="gw-lbl">Smart Gateway</text>
          <text x="490" y="358" text-anchor="middle" class="zigbee-lbl halo">Zigbee / BLE-mesh</text>
        </g>

        <!-- gateway 2 (bridge) -->
        <g class="float" style="animation-delay:1.1s">
          <rect x="672" y="242" width="76" height="76" rx="16" fill="#fff" stroke="#F97316" stroke-width="1.8"/>
          <rect x="692" y="258" width="14" height="14" rx="3" fill="none" stroke="#F97316" stroke-width="2"/>
          <rect x="714" y="258" width="14" height="14" rx="3" fill="none" stroke="#F97316" stroke-width="2" opacity=".6"/>
          <line x1="696" y1="286" x2="724" y2="286" stroke="#F97316" stroke-width="2" stroke-linecap="round" opacity=".7"/>
          <text x="756" y="276" class="gw-lbl2">Bridge Gateway</text>
          <text x="710" y="358" text-anchor="middle" class="zigbee-lbl halo">Zigbee / BLE-mesh</text>
        </g>

        <!-- ============ matter chip ============ -->
        <g class="float" style="animation-delay:.7s">
          <rect x="915" y="352" width="210" height="40" rx="12" fill="#fff" stroke="#F97316" stroke-width="1.4" stroke-dasharray="4 4"/>
          <text x="1020" y="369" text-anchor="middle" class="matter-lbl">Matter</text>
          <text x="1020" y="385" text-anchor="middle" class="note">over Wi-Fi · over Thread</text>
        </g>

        <!-- ============ device row (single row, x = 100 .. 1060, step 80) ============ -->
        <!-- 1 wire-free switch -->
        <g class="float" style="animation-delay:.1s">
          <rect x="80" y="423" width="40" height="40" rx="8" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <rect x="90" y="431" width="20" height="14" rx="3" fill="none" stroke="#F97316" stroke-width="1.5"/>
          <circle cx="100" cy="454" r="3" fill="#F97316"/>
          <text x="100" y="482" text-anchor="middle" class="lbl">Free</text>
          <text x="100" y="495" text-anchor="middle" class="lbl">posting</text>
        </g>
        <!-- 2 smart switch 1/2/3/4 -->
        <g class="float" style="animation-delay:.5s">
          <rect x="160" y="423" width="40" height="40" rx="8" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <rect x="168" y="431" width="10" height="10" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <rect x="182" y="431" width="10" height="10" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <rect x="168" y="445" width="10" height="10" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <rect x="182" y="445" width="10" height="10" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <text x="180" y="482" text-anchor="middle" class="lbl">Smart Switch</text>
          <text x="180" y="495" text-anchor="middle" class="lbl">1 / 2 / 3 / 4</text>
        </g>
        <!-- 3 control panel -->
        <g class="float" style="animation-delay:2s">
          <rect x="236" y="423" width="48" height="38" rx="6" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <rect x="244" y="430" width="22" height="16" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <circle cx="276" cy="436" r="2.5" fill="#F97316"/>
          <circle cx="276" cy="444" r="2.5" fill="#CBD5E1"/>
          <line x1="244" y1="453" x2="274" y2="453" stroke="#CBD5E1" stroke-width="1.3"/>
          <text x="260" y="482" text-anchor="middle" class="lbl">Control</text>
          <text x="260" y="495" text-anchor="middle" class="lbl">Panel</text>
        </g>
        <!-- 4 thermostat -->
        <g class="float" style="animation-delay:.9s">
          <!-- white panel, consistent with the other device icons -->
          <rect x="320" y="421" width="40" height="44" rx="6" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <!-- level bars: fill up segment by segment, hold, then all reset -->
          <g>
            <rect class="tstat-bar bar-1" x="328" y="424" width="3" height="6.5" rx="1" fill="#F97316"/>
            <rect class="tstat-bar bar-2" x="333" y="424" width="3" height="6.5" rx="1" fill="#F97316"/>
            <rect class="tstat-bar bar-3" x="338" y="424" width="3" height="6.5" rx="1" fill="#F97316"/>
            <rect class="tstat-bar bar-4" x="343" y="424" width="3" height="6.5" rx="1" fill="#F97316"/>
            <rect class="tstat-bar bar-5" x="348" y="424" width="3" height="6.5" rx="1" fill="#F97316"/>
            <rect class="tstat-bar bar-6" x="353" y="424" width="3" height="6.5" rx="1" fill="#F97316"/>
          </g>
          <!-- temperature climbs 18 -> 26 ℃ (whole degrees, no decimal point) -->
          <g style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:13px; font-weight:700; fill:#F97316;">
            <text class="tstat-temp" x="337" y="444" text-anchor="middle" style="animation-delay:0s">18</text>
            <text class="tstat-temp" x="337" y="444" text-anchor="middle" style="animation-delay:1s">19</text>
            <text class="tstat-temp" x="337" y="444" text-anchor="middle" style="animation-delay:2s">20</text>
            <text class="tstat-temp" x="337" y="444" text-anchor="middle" style="animation-delay:3s">21</text>
            <text class="tstat-temp" x="337" y="444" text-anchor="middle" style="animation-delay:4s">22</text>
            <text class="tstat-temp" x="337" y="444" text-anchor="middle" style="animation-delay:5s">23</text>
            <text class="tstat-temp" x="337" y="444" text-anchor="middle" style="animation-delay:6s">24</text>
            <text class="tstat-temp" x="337" y="444" text-anchor="middle" style="animation-delay:7s">25</text>
            <text class="tstat-temp tstat-temp-hold" x="337" y="444" text-anchor="middle" style="animation-delay:8s">26</text>
          </g>
          <!-- degree mark: ring + C so it never renders tilted -->
          <circle cx="347.6" cy="436.4" r="1.6" fill="none" stroke="#F97316" stroke-width="1.1"/>
          <text x="349.4" y="444" style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:10px; font-weight:700; fill:#F97316;">C</text>
          <!-- bottom mode indicators (blink in sequence) -->
          <circle class="tstat-led" cx="331" cy="455" r="1.8" fill="#F97316" style="animation-delay:0s"/>
          <circle class="tstat-led" cx="340" cy="455" r="1.8" fill="#F97316" style="animation-delay:.35s"/>
          <circle class="tstat-led" cx="349" cy="455" r="1.8" fill="#F97316" style="animation-delay:.7s"/>
          <text x="340" y="482" text-anchor="middle" class="lbl">Thermostat</text>
        </g>
        <!-- 5 robot vacuum: robot slides out of its base dock and returns -->
        <g class="float" style="animation-delay:1.6s">
          <!-- robot: LDS turret, wheel, body, bumper line, front sensor (mirrored left-right) -->
          <g class="eco-vac">
            <rect x="417.4" y="449.5" width="7.4" height="3" rx="1.5" fill="#fff" stroke="#CBD5E1" stroke-width="1.15"/>
            <circle cx="428.2" cy="461.7" r="1.9" fill="#475569"/>
            <rect x="406.6" y="452.4" width="26.4" height="10.2" rx="5.1" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
            <line x1="413.3" y1="453.3" x2="413.3" y2="461.6" stroke="#CBD5E1" stroke-width="1"/>
            <circle cx="410.6" cy="455.6" r="1.4" fill="#F97316"/>
          </g>
          <!-- base dock: short unit with a left-side notch; mirrored robot shows through -->
          <path d="M409.8 433.6 h20 a5 5 0 0 1 5 5 v21.2 a5 5 0 0 1 -5 5 h-20 a5 5 0 0 1 -5 -5 v-21.2 a5 5 0 0 1 5 -5 z
                   M413.8 462 L404.8 462 L404.8 448 L413.8 448 Z" fill="#fff" stroke="#CBD5E1" stroke-width="1.7" fill-rule="evenodd"/>
          <!-- panel seam + side vents -->
          <line x1="407.8" y1="443.4" x2="431.8" y2="443.4" stroke="#CBD5E1" stroke-width="1"/>
          <line x1="410.2" y1="447.4" x2="419.6" y2="447.4" stroke="#CBD5E1" stroke-width="1"/>
          <line x1="412.6" y1="451" x2="419.6" y2="451" stroke="#CBD5E1" stroke-width="1"/>
          <!-- charging led + floor plate -->
          <circle class="vac-led" cx="419.8" cy="439" r="1.5" fill="#F97316"/>
