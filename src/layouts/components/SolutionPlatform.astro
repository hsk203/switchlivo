---
// Rotating-headline strip placed directly under the hero banner.
// Static "frame" lines stay fixed; the middle two lines cycle through pairs,
// mirroring the reference site's animated headline block.
---

<section class="section platform-strip" aria-label="Our solution platform">
  <div class="container">
    <div class="platform-text">
      <p class="platform-static">Our solution platform works with</p>

      <div class="platform-rotor">
        <div class="platform-pair">
          <span class="platform-line">
            Hotels, Residences &amp; Offices — any business type
          </span>
        </div>
        <div class="platform-pair">
          <span class="platform-line">
            Tuya, Matter, HarmonyOS Connect, Xiaomi Mijia, KNX &amp; BLE Mesh
          </span>
        </div>
      </div>

      <p class="platform-static">— All in one ecosystem.</p>

      <p class="platform-sub">
        One complete ecosystem for smart hotels, homes, and offices — with full OEM &amp; ODM flexibility.<br>
        Covering certifications, eco standards, and technical parameters.
      </p>
    </div>
  </div>
</section>

<style>
  .platform-strip {
    background: transparent;
  }

  /* this strip only: a bit more room so the longest rotating line never clips.
     the max-width itself lives in src/styles/components.css — a rule in this
     scoped <style> can never outrank the layered !important .container. */

  .platform-text {
    max-width: none;
    margin-inline: auto;
    text-align: center;
  }

  .platform-static {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #1f2937;
  }

  /* stacked grid: all pairs share one cell, container sizes to the tallest */
  .platform-rotor {
    display: grid;
    margin: 0.3em 0;
  }

  .platform-pair {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.08em;
    opacity: 0;
    animation: platform-rotor 5s ease-in-out infinite;
    will-change: opacity, transform;
  }
  .platform-pair:nth-child(1) {
    animation-delay: 0s;
  }
  .platform-pair:nth-child(2) {
    animation-delay: 2.5s;
  }

  .platform-line {
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.02em;
    background-image: linear-gradient(to left, #f97316, #fb923c, #fbbf24);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* desktop: one sentence, one line, never wraps */
  @media (min-width: 1024px) {
    .platform-line {
      white-space: nowrap;
    }
  }

  .platform-sub {
    max-width: 46rem;
    margin: 1.6rem auto 0;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.7;
    color: #374151;
  }

  @keyframes platform-rotor {
    0% {
      opacity: 0;
      transform: translateY(0.5em);
    }
    7% {
      opacity: 1;
      transform: translateY(0);
    }
    43% {
      opacity: 1;
      transform: translateY(0);
    }
    50% {
      opacity: 0;
      transform: translateY(-0.5em);
    }
    100% {
      opacity: 0;
      transform: translateY(-0.5em);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .platform-pair {
      animation: none;
      opacity: 0;
    }
    .platform-pair:nth-child(1) {
      opacity: 1;
      transform: none;
    }
  }
</style>
