---
// Static platform statement directly under the hero.
// Was a rotating gradient headline; replaced with one fixed statement
// in solid colors. Protocols listed are the ones in the product files
// (Tuya / Zigbee / Matter / KNX / RS485). No certification claims.
---

<section class="platform" aria-label="Our solution platform">
  <div class="platform-shell">
    <h2 class="platform-title">One platform for homes, hotels and offices.</h2>
    <p class="platform-protocols">
      Panels, thermostats, sockets and gateways that work with
      <strong>Tuya</strong>, <strong>Zigbee</strong>, <strong>Matter</strong>,
      <strong>KNX</strong> and <strong>RS485</strong>.
    </p>
    <p class="platform-sub">
      One complete ecosystem for smart hotels, homes and offices — with full
      OEM &amp; ODM flexibility.
    </p>
  </div>
</section>

<style>
  .platform {
    padding: clamp(56px, 7vw, 84px) 0;
    background: #f7f6f3;
    color: #1a202c;
    text-align: center;
  }
  .platform-shell {
    width: min(860px, calc(100% - 48px));
    margin-inline: auto;
  }
  .platform-title {
    margin: 0;
    color: #1a202c;
    font-family: var(--font-primary);
    font-size: clamp(28px, 3.6vw, 44px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }
  .platform-protocols {
    margin: 20px 0 0;
    color: #4b5563;
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.7;
  }
  .platform-protocols strong {
    color: #1a202c;
    font-weight: 700;
  }
  .platform-sub {
    margin: 14px 0 0;
    color: #6b7280;
    font-size: 14px;
    line-height: 1.7;
  }
</style>
