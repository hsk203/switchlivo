---
// Why Switchlivo — a positive statement of what the factory offers.
// The previous version compared "FROM SWITCHLIVO" against "FROM A TRADING
// COMPANY"; that negative comparison is removed. Every point below is a
// fact already stated elsewhere on the site.
const points = [
  {
    n: "01",
    t: "Factory-direct pricing",
    d: "You talk to the team that builds the panels. No trading-company markup between you and the production line.",
  },
  {
    n: "02",
    t: "OEM / ODM customization",
    d: "Logo, colors, finish, packaging and firmware — customized where the product is made, for your brand and your market.",
  },
  {
    n: "03",
    t: "Samples before volume",
    d: "Test the build quality, finish and app experience before you commit to an order.",
  },
  {
    n: "04",
    t: "Export support",
    d: "English-speaking sales, export packing and shipping support to Saudi Arabia, UAE, India and Southeast Asia.",
  },
];
---

<section class="home-why" aria-labelledby="home-why-title">
  <div class="home-shell">
    <div class="home-why-header">
      <span class="home-why-kicker"><span>04</span> WHY SWITCHLIVO</span>
      <h2 id="home-why-title">Direct from the factory<br /><em>in Shunde, Foshan.</em></h2>
      <p>One team designs, builds and ships your panels — and answers your questions along the way.</p>
    </div>
    <ul class="home-why-grid">
      {
        points.map((p) => (
          <li>
            <span class="home-why-num" aria-hidden="true">{p.n}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .home-why{padding:clamp(76px,9vw,118px) 0;background:#10161b;color:#fff}
  .home-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}
  .home-why-header{max-width:720px;margin-bottom:46px}
  .home-why-kicker{display:inline-flex;align-items:center;gap:11px;color:#f0a17f;font-size:10px;font-weight:800;letter-spacing:.16em}
  .home-why-kicker>span{color:rgba(255,255,255,.4)}
  .home-why h2{margin:16px 0 18px;color:#fff;font-family:var(--font-primary);font-size:clamp(34px,4.6vw,56px);font-weight:700;line-height:1.07;letter-spacing:-.045em}
  .home-why h2 em{font-style:normal;color:#FE6019}
  .home-why-header>p{margin:0;color:rgba(255,255,255,.6);font-size:15px;line-height:1.75}
  .home-why-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;list-style:none;margin:0;padding:0;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.12);border-radius:15px;overflow:hidden}
  .home-why-grid li{margin:0;background:#151c22;padding:30px 32px 32px}
  .home-why-num{display:block;color:#FE6019;font-size:13px;font-weight:800;letter-spacing:.1em}
  .home-why-grid h3{margin:14px 0 0;color:#fff;font-family:var(--font-primary);font-size:19px;font-weight:700;letter-spacing:-.02em}
  .home-why-grid p{margin:8px 0 0;color:rgba(255,255,255,.6);font-size:13.5px;line-height:1.7}
  @media(max-width:760px){.home-why-grid{grid-template-columns:1fr}.home-why-grid li{padding:26px 24px 28px}}
</style>
