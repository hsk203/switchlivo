---
// Why Switchlivo — the four reasons project buyers work factory-direct.
const reasons = [
  {
    n: "01",
    t: "Factory-Direct Pricing",
    d: "You talk to the team that builds the panels. No trading-company markup between you and the production line.",
  },
  {
    n: "02",
    t: "OEM / ODM Customization",
    d: "Your logo, colors, packaging and documentation. Custom finishes and firmware options to fit your brand.",
  },
  {
    n: "03",
    t: "Samples Available",
    d: "Test the build quality, finish and app experience before you commit to a volume order.",
  },
  {
    n: "04",
    t: "Export-Ready Support",
    d: "English-speaking sales, export packing and shipping support to Saudi Arabia, UAE, India and Southeast Asia.",
  },
];
---

<section class="home-why" aria-labelledby="home-why-title">
  <div class="home-shell">
    <div class="home-why-header">
      <div>
        <span class="home-why-kicker"><span>04</span> WHY SWITCHLIVO</span>
        <h2 id="home-why-title">Buy from the factory,<br /><em>not the middleman.</em></h2>
      </div>
    </div>
    <div class="home-why-grid">
      {
        reasons.map((r) => (
          <article>
            <span class="home-why-num">{r.n}</span>
            <h3>{r.t}</h3>
            <p>{r.d}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .home-why{padding:clamp(76px,9vw,118px) 0;background:#10161b;color:#fff}
  .home-why-header{margin-bottom:46px}
  .home-why-kicker{display:inline-flex;align-items:center;gap:11px;color:#f0a17f;font-size:10px;font-weight:800;letter-spacing:.16em}
  .home-why-kicker>span{color:rgba(255,255,255,.4)}
  .home-why h2{margin:16px 0 0;color:#fff;font-size:clamp(34px,4.6vw,56px);line-height:1.07;letter-spacing:-.045em}
  .home-why h2 em{font-style:normal;color:#FE6019}
  .home-why-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.12);border-radius:15px;overflow:hidden}
  .home-why-grid article{background:#151c22;padding:30px 26px 32px}
  .home-why-num{display:block;color:#FE6019;font-size:12px;font-weight:800;letter-spacing:.14em;margin-bottom:16px}
  .home-why-grid h3{margin:0 0 10px;color:#fff;font-size:18px;letter-spacing:-.02em}
  .home-why-grid p{margin:0;color:rgba(255,255,255,.58);font-size:13px;line-height:1.7}
  @media(max-width:1000px){.home-why-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.home-why-grid{grid-template-columns:1fr}.home-why-grid article{padding:24px 22px 26px}}
</style>
