---
// Why Switchlivo — factory-direct vs. trading company, stated plainly.
// Left column: what buying direct means. Right column: what a middleman adds.
// These are structural facts about the two routes, not claims about a named competitor.
const direct = [
  { t: "You talk to the team that builds the panels", d: "Questions go straight to engineering and production — no relay, no guessing." },
  { t: "Your brand, customized at the source", d: "Logo, colors, finish, packaging and firmware — set where the product is made." },
  { t: "Samples before volume", d: "Test the build quality, finish and app experience before you commit to an order." },
  { t: "Export support in English", d: "Export packing and shipping support to your market, handled by the team that ships it." },
];
const middleman = [
  { t: "Its own markup", d: "A margin added between you and the production line, on every unit." },
  { t: "Slower answers", d: "Every question passes through a middleman before it reaches the factory." },
  { t: "No line access", d: "You never speak to the people who actually build your panels." },
  { t: "Limited customization", d: "Changes are limited to whatever the trader can arrange second-hand." },
];
---

<section class="home-why" aria-labelledby="home-why-title">
  <div class="home-shell">
    <div class="home-why-header">
      <span class="home-why-kicker"><span>04</span> WHY SWITCHLIVO</span>
      <h2 id="home-why-title">Buy from the factory,<br /><em>not the middleman.</em></h2>
      <p>Same panels, two routes to get them. Here is what changes when the factory is the one you talk to.</p>
    </div>
    <div class="home-why-compare">
      <div class="home-why-col is-direct">
        <span class="home-why-col-label">FROM SWITCHLIVO — FACTORY DIRECT</span>
        <ul>
          {
            direct.map((r) => (
              <li>
                <span class="home-why-mark" aria-hidden="true">✓</span>
                <div>
                  <strong>{r.t}</strong>
                  <p>{r.d}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="home-why-col is-middle">
        <span class="home-why-col-label">FROM A TRADING COMPANY</span>
        <ul>
          {
            middleman.map((r) => (
              <li>
                <span class="home-why-mark" aria-hidden="true">—</span>
                <div>
                  <strong>{r.t}</strong>
                  <p>{r.d}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .home-why{padding:clamp(76px,9vw,118px) 0;background:#10161b;color:#fff}
  .home-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}
  .home-why-header{max-width:720px;margin-bottom:46px}
  .home-why-kicker{display:inline-flex;align-items:center;gap:11px;color:#f0a17f;font-size:10px;font-weight:800;letter-spacing:.16em}
  .home-why-kicker>span{color:rgba(255,255,255,.4)}
  .home-why h2{margin:16px 0 18px;color:#fff;font-size:clamp(34px,4.6vw,56px);line-height:1.07;letter-spacing:-.045em}
  .home-why h2 em{font-style:normal;color:#FE6019}
  .home-why-header>p{margin:0;color:rgba(255,255,255,.6);font-size:15px;line-height:1.75}
  .home-why-compare{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.12);border-radius:15px;overflow:hidden}
  .home-why-col{padding:32px 32px 34px}
  .home-why-col.is-direct{background:#151c22}
  .home-why-col.is-middle{background:#10161b}
  .home-why-col-label{display:block;margin-bottom:24px;font-size:9px;font-weight:800;letter-spacing:.16em}
  .home-why-col.is-direct .home-why-col-label{color:#FE6019}
  .home-why-col.is-middle .home-why-col-label{color:rgba(255,255,255,.4)}
  .home-why-col ul{list-style:none;margin:0;padding:0}
  .home-why-col li{display:flex;gap:14px;margin:0;padding:15px 0;border-top:1px solid rgba(255,255,255,.09)}
  .home-why-col li:first-child{border-top:0;padding-top:0}
  .home-why-col li:last-child{padding-bottom:0}
  .home-why-mark{flex:none;width:24px;height:24px;display:grid;place-items:center;border-radius:50%;font-size:12px;font-weight:800}
  .home-why-col.is-direct .home-why-mark{background:#FE6019;color:#fff}
  .home-why-col.is-middle .home-why-mark{background:rgba(255,255,255,.12);color:rgba(255,255,255,.55)}
  .home-why-col strong{display:block;color:#fff;font-size:15px;font-weight:750;letter-spacing:-.01em}
  .home-why-col.is-middle strong{color:rgba(255,255,255,.6)}
  .home-why-col p{margin:5px 0 0;color:rgba(255,255,255,.55);font-size:12.5px;line-height:1.65}
  .home-why-col.is-middle p{color:rgba(255,255,255,.38)}
  @media(max-width:820px){.home-why-compare{grid-template-columns:1fr}.home-why-col{padding:26px 24px 28px}}
</style>
