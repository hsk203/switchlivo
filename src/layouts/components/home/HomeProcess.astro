---
// How it works — four steps from first email to first order.
const steps = [
  {
    n: "1",
    t: "Send Inquiry",
    d: "Tell us the models, quantities and target market you have in mind.",
  },
  {
    n: "2",
    t: "Quotation in 24 Hours",
    d: "A clear factory-direct quote with OEM/ODM options, within one working day.",
  },
  {
    n: "3",
    t: "Sample",
    d: "Evaluate real samples — finish, feel and functionality — before deciding.",
  },
  {
    n: "4",
    t: "Order",
    d: "Confirm your order and we schedule production, packing and shipment.",
  },
];
---

<section class="home-process" aria-labelledby="home-process-title">
  <div class="home-shell">
    <div class="home-process-header">
      <span class="home-kicker"><span>05</span> HOW IT WORKS</span>
      <h2 id="home-process-title">From first email<br /><em>to first container.</em></h2>
    </div>
    <ol class="home-process-grid">
      {
        steps.map((s, i) => (
          <li>
            <span class:list={["home-step-dot", i === steps.length - 1 && "is-final"]}>{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .home-kicker{display:inline-flex;align-items:center;gap:11px;color:#B84311;font-size:10px;font-weight:800;letter-spacing:.16em}
  .home-kicker>span{color:#899198}
  .home-process{padding:clamp(76px,9vw,118px) 0;background:#fff;color:#1a202c}
  .home-process-header{text-align:center;max-width:640px;margin:0 auto 56px}
  .home-process h2{margin:16px 0 0;color:#1a202c;font-size:clamp(34px,4.6vw,56px);line-height:1.07;letter-spacing:-.045em}
  .home-process h2 em{font-style:normal;color:#FE6019}
  .home-process-grid{position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:30px;list-style:none;margin:0;padding:0}
  .home-process-grid:before{content:"";position:absolute;top:25px;left:12%;right:12%;height:1px;background:#e3ded6}
  .home-process-grid li{position:relative;margin:0;padding:0;text-align:center}
  .home-step-dot{position:relative;z-index:1;display:grid;place-items:center;width:52px;height:52px;margin:0 auto;border-radius:50%;background:#1a202c;color:#fff;font-size:19px;font-weight:800;transition:background .25s ease,box-shadow .25s ease}
  .home-step-dot.is-final{background:#FE6019}
  .home-process-grid li:hover .home-step-dot{box-shadow:0 0 0 9px rgba(254,96,25,.13)}
  .home-process-grid h3{margin:20px 0 9px;color:#1a202c;font-size:17px;letter-spacing:-.02em}
  .home-process-grid p{margin:0 auto;max-width:250px;color:#717b82;font-size:13px;line-height:1.7}
  @media(prefers-reduced-motion:reduce){.home-step-dot{transition:none}.home-process-grid li:hover .home-step-dot{box-shadow:none}}
  @media(max-width:850px){.home-process-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:34px}.home-process-grid:before{display:none}}
  @media(max-width:520px){.home-process-grid{grid-template-columns:1fr;gap:26px}.home-process-grid p{max-width:320px}}
</style>
