---
import { getCollection } from "astro:content";
import { cdnImage } from "@/lib/cdnImage";

const curatedProducts = [
  { slug: "x20-1-fan-1-light-smart-fan-switch", family: "switches", familyLabel: "Switches & Panels", name: "X20 Fan + Light Smart Switch", summary: "Fan-speed and light control combined in one wall switch." },
  { slug: "x20-3-gang-3-scene-smart-light-switch", family: "switches", familyLabel: "Switches & Panels", name: "X20 3-Gang 3-Scene Switch", summary: "Three-gang lighting control with scene options." },
  { slug: "x26a-4-gang-2-scene-smart-touch-switch", family: "switches", familyLabel: "Switches & Panels", name: "X26A 4-Gang Touch Switch", summary: "Four-gang touch control with two scene functions." },
  { slug: "x39uag-1-fan1-gang2-scene-smart-fan-switch", family: "switches", familyLabel: "Switches & Panels", name: "X39UAG Fan + Light Scene Switch", summary: "Fan, light and scene functions in one wall control." },
  { slug: "x39uag-4-gang-4-scene-smart-light-switch", family: "switches", familyLabel: "Switches & Panels", name: "X39UAG 4-Gang 4-Scene Switch", summary: "Four-gang lighting control with four scene functions." },
  { slug: "4-modular-switch-socket", family: "power", familyLabel: "Power & Sockets", name: "4-Module Smart Socket", summary: "A modular socket layout with region-specific outlets and optional charging modules." },
  { slug: "6-modular-switch-socket", family: "power", familyLabel: "Power & Sockets", name: "6-Module Smart Socket", summary: "A larger modular layout with socket, switch and optional USB-C modules." },
  { slug: "x20-20a-smart-power-switch", family: "power", familyLabel: "Power & Sockets", name: "X20 20A Smart Power Switch", summary: "A 20A smart power switching option from the X20 range." },
  { slug: "nh04-smart-thermostat-touchscreen-for-heating-water-electric-boiler-systems", family: "climate", familyLabel: "Climate Control", name: "NH04 Touchscreen Thermostat", summary: "Touchscreen temperature control for water, electric and boiler heating systems." },
  { slug: "x20-air-conditioning-smart-thermostat-panel", family: "climate", familyLabel: "Climate Control", name: "X20 Air-Conditioning Thermostat", summary: "A wall-mounted thermostat panel for compatible air-conditioning systems." },
] as const;

const allProducts = await getCollection("products");
const products = curatedProducts.flatMap((item) => {
  const product = allProducts.find((entry) => entry.id === item.slug);
  return product ? [{ ...item, product }] : [];
});
if (products.length !== curatedProducts.length) {
  throw new Error("Homepage product showcase could not resolve all 10 curated product entries.");
}
const filters = [
  { id: "all", label: "All products", count: products.length },
  { id: "switches", label: "Switches & panels", count: products.filter((item) => item.family === "switches").length },
  { id: "power", label: "Power & sockets", count: products.filter((item) => item.family === "power").length },
  { id: "climate", label: "Climate control", count: products.filter((item) => item.family === "climate").length },
];
---
<section id="representative-products" class="home-products" data-home-products aria-labelledby="home-products-title">
  <div class="home-products-shell">
    <div class="home-products-header">
      <div>
        <span class="home-products-kicker"><span>02</span> REPRESENTATIVE PRODUCTS</span>
        <h2 id="home-products-title">Real products.<br /><em>Ready for real projects.</em></h2>
      </div>
      <div class="home-products-intro">
        <p>Explore ten representative products across wall controls, power and climate. Each item links to its product page for specifications and inquiry details.</p>
        <a class="home-products-all" href="/products">Browse the full product range <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="home-product-filters" role="group" aria-label="Filter products by family">
      {filters.map((filter, index) => (
        <button type="button" data-home-filter={filter.id} aria-pressed={index === 0 ? "true" : "false"} class:list={["home-product-filter", index === 0 && "active"]}>
          {filter.label}<span>{String(filter.count).padStart(2, "0")}</span>
        </button>
      ))}
    </div>
    <p class="home-product-filter-status" data-home-filter-status aria-live="polite">Showing all {products.length} products</p>

    <div class="home-product-grid">
      {products.map((item) => {
        const href = `/products/${item.product.id}`;
        return (
          <article class="home-product-card" data-home-product-card data-home-category={item.family}>
            <a class="home-product-image" href={href} aria-label={`View ${item.product.data.title}`}>
              <span class="home-product-family">{item.familyLabel}</span>
              <img
                src={cdnImage(item.product.data.featuredImage)}
                alt={item.product.data.title}
                width="600"
                height="600"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="home-product-info">
              <span class="home-product-series">{item.product.data.series ?? "SWITCHLIVO"} SERIES</span>
              <h3><a href={href}>{item.product.data.title}</a></h3>
              <p>{item.summary}</p>
              <a class="home-product-link" href={href}>View product <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-home-products]");
  if (root && root.dataset.filtersReady !== "true") {
    root.dataset.filtersReady = "true";
    const filters = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-home-filter]"));
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-home-product-card]"));
    const status = root.querySelector<HTMLElement>("[data-home-filter-status]");

    filters.forEach((filter) => {
      filter.addEventListener("click", () => {
        const selected = filter.dataset.homeFilter ?? "all";
        let visibleCount = 0;
        filters.forEach((button) => {
          const active = button === filter;
          button.classList.toggle("active", active);
          button.setAttribute("aria-pressed", String(active));
        });
        cards.forEach((card) => {
          const visible = selected === "all" || card.dataset.homeCategory === selected;
          card.hidden = !visible;
          if (visible) visibleCount += 1;
        });
        if (status) status.textContent = `Showing ${visibleCount} ${selected === "all" ? "products" : "products in this family"}`;
      });
    });
  }
</script>

<style>
  .home-products{padding:58px 0 clamp(78px,9vw,120px);background:#fff;color:#1a202c}
  .home-products-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}
  .home-products-header{display:grid;grid-template-columns:1fr .72fr;gap:68px;align-items:end;margin-bottom:34px}
  .home-products-kicker{display:inline-flex;gap:11px;align-items:center;color:#B84311;font-size:10px;font-weight:800;letter-spacing:.16em}
  .home-products-kicker>span{color:#899198}
  .home-products h2{margin:17px 0 0;color:#1a202c;font-size:clamp(34px,4.6vw,57px);line-height:1.07;letter-spacing:-.045em}
  .home-products h2 em{font-style:normal;color:#FE6019}
  .home-products-intro{max-width:440px;padding-bottom:4px}
  .home-products-intro p{margin:0 0 17px;color:#68737b;font-size:14px;line-height:1.8}
  .home-products-all{display:inline-flex;align-items:center;gap:10px;color:#1a202c;font-size:13px;font-weight:750;text-decoration:none}
  .home-products-all span{color:#FE6019;font-size:17px;transition:transform .2s}
  .home-products-all:hover span{transform:translate(2px,-2px)}
  .home-product-filters{display:flex;flex-wrap:wrap;gap:8px;padding:15px 0 10px;border-top:1px solid #e8e7e4}
  .home-product-filter{display:inline-flex;align-items:center;gap:9px;border:1px solid #e5e4e1;border-radius:999px;background:#fff;padding:9px 14px;color:#59646d;font:inherit;font-size:12px;font-weight:700;cursor:pointer;transition:background .2s,color .2s,border-color .2s}
  .home-product-filter span{color:#9ba1a5;font-size:10px;font-weight:800}
  .home-product-filter:hover{border-color:#FE6019;color:#1a202c}
  .home-product-filter.active{border-color:#B84311;background:#B84311;color:#fff}
  .home-product-filter.active span{color:#fff}
  .home-product-filter:focus-visible,.home-products a:focus-visible{outline:2px solid #FE6019;outline-offset:3px}
  .home-product-filter-status{min-height:18px;margin:5px 0 17px;color:#92999e;font-size:11px}
  .home-product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
  .home-product-card{display:flex;min-width:0;flex-direction:column;overflow:hidden;border:1px solid #e8e7e4;border-radius:14px;background:#fff;transition:transform .22s ease,border-color .22s ease,box-shadow .22s ease}
  .home-product-card:hover{transform:translateY(-3px);border-color:#dedbd5;box-shadow:0 13px 32px rgba(24,35,44,.08)}
  .home-product-card[hidden]{display:none!important}
  .home-product-image{position:relative;display:grid;aspect-ratio:1/1;place-items:center;overflow:hidden;background:#f5f3ef;text-decoration:none}
  .home-product-image img{display:block;width:100%;height:100%;object-fit:contain;padding:11%;transition:transform .35s ease}
  .home-product-card:hover .home-product-image img{transform:scale(1.04)}
  .home-product-family{position:absolute;z-index:1;top:12px;left:12px;border:1px solid #ffffffaa;border-radius:999px;background:#ffffffdd;padding:6px 9px;color:#68737b;font-size:9px;font-weight:750;letter-spacing:.06em;backdrop-filter:blur(8px)}
  .home-product-info{display:flex;flex:1;flex-direction:column;padding:15px 16px 16px}
  .home-product-series{color:#B84311;font-size:9px;font-weight:800;letter-spacing:.15em;text-transform:uppercase}
  .home-product-info h3{margin:8px 0 7px;color:#1a202c;font-size:16px;line-height:1.3;letter-spacing:-.02em}
  .home-product-info h3 a{color:inherit;text-decoration:none}
  .home-product-info p{margin:0 0 15px;color:#788188;font-size:12px;line-height:1.65}
  .home-product-link{display:flex;align-items:center;justify-content:space-between;margin-top:auto;border-top:1px solid #efeeeb;padding-top:12px;color:#1a202c;font-size:11px;font-weight:750;text-decoration:none}
  .home-product-link span{color:#FE6019;font-size:15px}
  @media(prefers-reduced-motion:reduce){.home-product-card:hover{transform:none}.home-product-card:hover .home-product-image img{transform:none}.home-products-all:hover span{transform:none}}
  @media(max-width:1020px){.home-products-header{grid-template-columns:1fr .8fr;gap:36px}.home-product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:720px){.home-products-shell{width:min(100% - 36px,580px)}.home-products-header{grid-template-columns:1fr;gap:17px;margin-bottom:25px}.home-products h2{font-size:clamp(34px,9vw,48px)}.home-product-filters{gap:7px}.home-product-filter{padding:8px 11px;font-size:11px}.home-product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.home-product-info{padding:12px 12px 13px}.home-product-info h3{font-size:14px}.home-product-info p{font-size:11px}.home-product-family{top:8px;left:8px;padding:5px 7px;font-size:8px}}
  @media(max-width:390px){.home-product-grid{gap:8px}.home-product-info{padding:10px}.home-product-info h3{font-size:13px}.home-product-info p{font-size:10px}}
  @media(prefers-reduced-motion:reduce){.home-product-card,.home-product-image img,.home-products-all span{transition:none}}
</style>
