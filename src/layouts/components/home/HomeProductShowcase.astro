---
// Product showcase — one hero panel + three supporting panels, real catalog images.
// No invented specs: each panel gets one plain-language benefit.
import { cdnImage } from "@/lib/cdnImage";

const hero = {
  slug: "x10-3-gang-smart-light-switch",
  series: "X10 Series",
  name: "3-Gang Smart Light Switch",
  benefit: "Three lighting circuits on one clean glass panel — less wall clutter, easier scenes.",
};

const products = [
  {
    slug: "x10-smart-thermostat-knob-switch",
    series: "X10 Series",
    name: "Smart Thermostat Panel",
    benefit: "Climate control with a knob guests understand instantly — ideal for hotel rooms.",
  },
  {
    slug: "x10-fan-knob-switch-1-gang-light-switch-smart-fan-switch",
    series: "X10 Series",
    name: "Smart Fan Switch",
    benefit: "Fan and light control in a single panel — one less switch on every wall.",
  },
  {
    slug: "6-modular-switch-and-socket",
    series: "Modular Series",
    name: "Modular Switch Socket",
    benefit: "Mix switches, sockets and controls on one frame — configured to your market.",
  },
];
---

<section class="home-products" aria-labelledby="home-products-title">
  <div class="home-shell">
    <div class="home-products-header">
      <div>
        <span class="home-kicker"><span>02</span> PRODUCT SHOWCASE</span>
        <h2 id="home-products-title">Four panels buyers<br /><em>keep coming back for.</em></h2>
      </div>
      <p>Every model can be rebranded, re-colored and re-packaged for your market. These four are the ones project buyers ask for first.</p>
    </div>

    <div class="home-products-feature">
      <article class="home-product-hero">
        <a class="home-product-image" href={`/products/${hero.slug}`} aria-label={`View ${hero.name}`}>
          <img
            src={cdnImage(`https://cdn.switchlivo.com/products/${hero.slug}.webp`)}
            alt={`${hero.name} — Switchlivo smart switch panel`}
            width="600"
            height="600"
            loading="lazy"
            decoding="async"
          />
        </a>
        <div class="home-product-info">
          <span class="home-product-series">{hero.series}</span>
          <h3><a href={`/products/${hero.slug}`}>{hero.name}</a></h3>
          <p>{hero.benefit}</p>
          <a class="home-product-link" href={`/products/${hero.slug}`}>View product <span aria-hidden="true">↗</span></a>
        </div>
      </article>

      <div class="home-products-side">
        {
          products.map((p) => (
            <article class="home-product-row">
              <a class="home-product-thumb" href={`/products/${p.slug}`} aria-label={`View ${p.name}`}>
                <img
                  src={cdnImage(`https://cdn.switchlivo.com/products/${p.slug}.webp`)}
                  alt={`${p.name} — Switchlivo smart switch panel`}
                  width="300"
                  height="300"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="home-product-row-info">
                <span class="home-product-series">{p.series}</span>
                <h3><a href={`/products/${p.slug}`}>{p.name}</a></h3>
                <p>{p.benefit}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <p class="home-products-all">
      322+ models across 12 categories. <a href="/products">Browse the full catalog <span aria-hidden="true">↗</span></a>
    </p>
  </div>
</section>

<style>
  .home-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}
  .home-kicker{display:inline-flex;align-items:center;gap:11px;color:#B84311;font-size:10px;font-weight:800;letter-spacing:.16em}
  .home-kicker>span{color:#899198}
  .home-products{padding:clamp(76px,9vw,118px) 0;background:#f7f6f3;color:#1a202c}
  .home-products-header{display:flex;justify-content:space-between;align-items:end;gap:46px;margin-bottom:38px}
  .home-products h2{margin:16px 0 0;color:#1a202c;font-size:clamp(34px,4.6vw,56px);line-height:1.07;letter-spacing:-.045em}
  .home-products h2 em{font-style:normal;color:#FE6019}
  .home-products-header>p{max-width:390px;margin:0 0 5px;color:#68737b;font-size:14px;line-height:1.8}
  .home-products-feature{display:grid;grid-template-columns:1.05fr .95fr;gap:18px;align-items:stretch}
  .home-product-hero{display:flex;flex-direction:column;overflow:hidden;border:1px solid #e8e5df;border-radius:15px;background:#fff;box-shadow:0 5px 18px rgba(24,35,44,.035)}
  .home-product-hero .home-product-image{display:block;aspect-ratio:1.25;background:#efede8;padding:26px}
  .home-product-hero .home-product-image img{display:block;width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;transition:transform .45s ease}
  .home-product-hero:hover .home-product-image img{transform:scale(1.04)}
  .home-product-hero .home-product-info{padding:20px 22px 22px}
  .home-product-series{display:block;color:#B84311;font-size:9px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin-bottom:8px}
  .home-product-hero h3{margin:0 0 8px;color:#1a202c;font-size:21px;letter-spacing:-.02em}
  .home-product-hero h3 a{color:inherit;text-decoration:none}
  .home-product-hero p{margin:0 0 16px;color:#717b82;font-size:13px;line-height:1.65}
  .home-product-link{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #efeeeb;padding-top:12px;color:#1a202c;font-size:11px;font-weight:750;text-decoration:none}
  .home-product-link span{color:#FE6019;font-size:15px}
  .home-products-side{display:flex;flex-direction:column;gap:18px}
  .home-product-row{flex:1;display:grid;grid-template-columns:148px 1fr;gap:18px;align-items:center;overflow:hidden;border:1px solid #e8e5df;border-radius:15px;background:#fff;padding:14px 18px 14px 14px;box-shadow:0 5px 18px rgba(24,35,44,.035);transition:transform .3s ease,border-color .3s ease,box-shadow .3s ease}
  .home-product-row:hover{transform:translateY(-3px);border-color:#f3c8b8;box-shadow:0 14px 34px rgba(24,35,44,.08)}
  .home-product-thumb{display:block;aspect-ratio:1;background:#efede8;border-radius:10px;overflow:hidden}
  .home-product-thumb img{display:block;width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;padding:10%;transition:transform .45s ease}
  .home-product-row:hover .home-product-thumb img{transform:scale(1.06)}
  .home-product-row-info h3{margin:0 0 6px;color:#1a202c;font-size:16px;letter-spacing:-.02em}
  .home-product-row-info h3 a{color:inherit;text-decoration:none}
  .home-product-row-info p{margin:0;color:#717b82;font-size:12.5px;line-height:1.65}
  .home-products-all{margin:34px 0 0;text-align:center;color:#7b858c;font-size:13px}
  .home-products-all a{color:#FE6019;font-weight:750;text-decoration:none}
  .home-products-all a:hover{text-decoration:underline}
  .home-products-all a:focus-visible,.home-product-image:focus-visible,.home-product-thumb:focus-visible{outline:2px solid #FE6019;outline-offset:3px}
  @media(prefers-reduced-motion:reduce){.home-product-hero .home-product-image img,.home-product-thumb img,.home-product-row{transition:none}.home-product-hero:hover .home-product-image img,.home-product-row:hover .home-product-thumb img{transform:none}.home-product-row:hover{transform:none}}
  @media(max-width:900px){.home-products-feature{grid-template-columns:1fr}.home-product-hero .home-product-image{aspect-ratio:1.4}}
  @media(max-width:760px){.home-products-header{align-items:flex-start;flex-direction:column;gap:17px}}
  @media(max-width:600px){.home-product-row{grid-template-columns:110px 1fr;gap:13px;padding:11px 14px 11px 11px}.home-product-row-info h3{font-size:14px}.home-product-row-info p{font-size:11.5px}}
</style>
