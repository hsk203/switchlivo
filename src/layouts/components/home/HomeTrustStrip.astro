---
// Trust strip — a single editorial fact line under the dark intro.
// Facts only: manufacturer identity, OEM/ODM, real catalog size, shipping focus.
const items = [
  { t: "Manufacturer & Supplier", d: "Own factory in Shunde, Foshan" },
  { t: "OEM & ODM", d: "Your brand, our engineering" },
  { t: "322+ Products", d: "12 categories, project-ready" },
  { t: "Worldwide Shipping", d: "With a focus on Saudi Arabia, UAE, India & Southeast Asia" },
];
---

<section class="home-trust" aria-label="Why buyers trust Switchlivo">
  <div class="home-shell">
    <span class="home-trust-label">THE SHORT VERSION</span>
    <ul class="home-trust-grid">
      {
        items.map((it) => (
          <li>
            <strong>{it.t}</strong>
            <p>{it.d}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .home-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}
  .home-trust{padding:clamp(34px,4vw,48px) 0;background:#fff;color:#1a202c;border-bottom:1px solid #e8e7e4}
  .home-trust-label{display:block;margin-bottom:22px;color:#B84311;font-size:9px;font-weight:800;letter-spacing:.18em}
  .home-trust-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;list-style:none;margin:0;padding:0}
  .home-trust-grid li{margin:0;padding:0 26px;border-left:1px solid #e8e7e4}
  .home-trust-grid li:first-child{padding-left:0;border-left:0}
  .home-trust-grid strong{display:block;color:#1a202c;font-size:15px;font-weight:800;letter-spacing:-.01em}
  .home-trust-grid p{margin:6px 0 0;color:#717b82;font-size:12px;line-height:1.6}
  @media(max-width:960px){.home-trust-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 0}.home-trust-grid li{padding:0 22px}.home-trust-grid li:nth-child(odd){padding-left:0;border-left:0}}
  @media(max-width:520px){.home-trust-grid{grid-template-columns:1fr}.home-trust-grid li{padding:0 0 0 14px;border-left:2px solid #f3c8b8}}
</style>
