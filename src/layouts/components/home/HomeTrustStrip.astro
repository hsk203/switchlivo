---
// Factory trust — proof, not just words. Left: the production line in
// Shunde, Foshan. Right: the four facts that can be verified — one factory,
// catalog size, categories, OEM/ODM. No certifications, no customer names,
// no testimonials: none exist.
const facts = [
  { n: "01", t: "Factory", d: "Our own production line in Shunde, Foshan" },
  { n: "322+", t: "Models", d: "Switch panels, thermostats, sockets, gateways" },
  { n: "12", t: "Categories", d: "One catalog, project-ready" },
  { n: "OEM/ODM", t: "Branding", d: "Your brand, our engineering" },
];
---

<section class="home-factory" aria-label="Our factory">
  <div class="home-shell">
    <figure class="home-factory-photo">
      <img
        src="/images/production-line.webp"
        alt="Switchlivo production line — workers assembling smart switch panels"
        width="1920"
        height="1280"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="home-factory-copy">
      <span class="home-kicker">THE FACTORY</span>
      <h2>Built where it is made.</h2>
      <p>
        Every panel is assembled, tested and packed in our own factory in
        Shunde, Foshan — the same team answers your questions, builds your
        samples and ships your order.
      </p>
      <dl class="home-factory-facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.t}</dt>
              <dd>{f.n}</dd>
              <dd class="home-factory-fact-sub">{f.d}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .home-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}
  .home-factory{padding:clamp(64px,8vw,104px) 0;background:#fff;color:#1a202c}
  .home-factory .home-shell{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(36px,4.5vw,64px);align-items:center}
  .home-factory-photo{margin:0}
  .home-factory-photo img{display:block;width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:16px}
  .home-kicker{display:inline-flex;align-items:center;gap:11px;color:#B84311;font-size:10px;font-weight:800;letter-spacing:.16em}
  .home-factory h2{margin:16px 0 0;color:#1a202c;font-family:var(--font-primary);font-size:clamp(30px,3.8vw,44px);font-weight:700;line-height:1.12;letter-spacing:-.03em}
  .home-factory-copy>p{max-width:480px;margin:16px 0 0;color:#4b5563;font-size:15px;line-height:1.75}
  .home-factory-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:26px 28px;margin:36px 0 0;padding:0}
  .home-factory-facts div{border-top:2px solid #1a202c;padding-top:14px}
  .home-factory-facts dt{margin:0;color:#6b7280;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .home-factory-facts dd{margin:6px 0 0;color:#1a202c;font-size:30px;font-weight:800;line-height:1;letter-spacing:-.03em}
  .home-factory-facts .home-factory-fact-sub{margin:8px 0 0;color:#6b7280;font-size:12.5px;font-weight:500;line-height:1.55;letter-spacing:0}
  @media(max-width:860px){.home-factory .home-shell{grid-template-columns:1fr;gap:32px}}
  @media(max-width:520px){.home-factory-facts{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.home-factory-facts dd{font-size:25px}}
</style>
