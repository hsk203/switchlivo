---
// OEM & ODM — customization, answered before the factory proof.
// Sits between the dark intro (what we make) and the factory strip
// (where it is made). No invented claims: branding, finish, protocol
// and wall-box options are all "available on request" capabilities.
const features = [
  {
    t: "Your brand",
    d: "Your logo on the panel and the box — laser-engraved or printed.",
  },
  {
    t: "Finish & colour",
    d: "Tempered glass or brushed aluminum, in the colour your market wants.",
  },
  {
    t: "Protocol",
    d: "Tuya, Zigbee or Matter — available on request for your platform.",
  },
  {
    t: "Wall box & packing",
    d: "Multi-standard wall boxes; retail or project packing to your spec.",
  },
];
---

<section class="home-oem" aria-labelledby="home-oem-title">
  <div class="home-shell">
    <div class="home-oem-copy">
      <span class="home-kicker">OEM &amp; ODM</span>
      <h2 id="home-oem-title">Built to<br />your brand.</h2>
      <p class="home-oem-lede">
        Send us your spec, your logo and your market&rsquo;s wall-box
        standard. We build the panel to match &mdash; same factory, same
        line, your brand on the front.
      </p>
      <ul class="home-oem-features">
        {
          features.map((f) => (
            <li>
              <strong>{f.t}</strong>
              <span>{f.d}</span>
            </li>
          ))
        }
      </ul>
      <a class="home-oem-link" href="/contact">
        Tell us your spec <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
    <div class="home-oem-media">
      <figure class="home-oem-main">
        <img
          src="/images/oem-odm/oem-odm-finishes.webp"
          alt="Smart switch panels in three finishes — matte black glass, white glass and champagne-gold aluminum"
          width="1920"
          height="1280"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="home-oem-thumbs">
        <figure>
          <img
            src="/images/oem-odm/oem-odm-branding.webp"
            alt="Close-up of a black glass switch panel with a custom brand logo engraved in the corner"
            width="1920"
            height="1280"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure>
          <img
            src="/images/oem-odm/oem-odm-finish-range.webp"
            alt="Five smart switch panels in a row — black, white, champagne gold, silver grey and dark bronze finishes"
            width="1920"
            height="1280"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .home-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}
  .home-oem{padding:clamp(72px,8.5vw,112px) 0;background:#f7f6f3;color:#1a202c}
  .home-oem .home-shell{display:grid;grid-template-columns:.95fr 1.05fr;gap:clamp(36px,4.5vw,64px);align-items:center}
  .home-kicker{display:inline-flex;align-items:center;gap:11px;color:#B84311;font-size:10px;font-weight:800;letter-spacing:.16em}
  .home-oem h2{margin:16px 0 0;color:#1a202c;font-family:var(--font-primary);font-size:clamp(34px,4.4vw,54px);font-weight:700;line-height:1.08;letter-spacing:-.04em}
  .home-oem-lede{max-width:480px;margin:16px 0 0;color:#4b5563;font-size:15px;line-height:1.75}
  .home-oem-features{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 28px;list-style:none;margin:34px 0 0;padding:0}
  .home-oem-features li{border-top:2px solid #1a202c;padding-top:13px}
  .home-oem-features strong{display:block;color:#1a202c;font-size:14px;font-weight:750;letter-spacing:-.01em}
  .home-oem-features span{display:block;margin-top:6px;color:#6b7280;font-size:12.5px;font-weight:500;line-height:1.6}
  .home-oem-link{display:inline-flex;align-items:center;gap:10px;margin-top:32px;color:#1a202c;font-size:13px;font-weight:750;text-decoration:none}
  .home-oem-link span{color:#FE6019;font-size:17px;transition:transform .2s}
  .home-oem-link:hover span{transform:translateX(3px)}
  .home-oem-media figure{margin:0}
  .home-oem-media img{display:block;width:100%;height:100%;object-fit:cover;border-radius:16px}
  .home-oem-main{aspect-ratio:3/2;overflow:hidden;border-radius:16px}
  .home-oem-thumbs{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
  .home-oem-thumbs figure{aspect-ratio:3/2;overflow:hidden;border-radius:12px}
  @media(max-width:860px){.home-oem .home-shell{grid-template-columns:1fr;gap:34px}}
  @media(max-width:520px){.home-oem-features{grid-template-columns:1fr 1fr;gap:20px}.home-oem-thumbs{gap:10px;margin-top:10px}}
  @media(prefers-reduced-motion:reduce){.home-oem-link span{transition:none}.home-oem-link:hover span{transform:none}}
</style>
