---
import config from "@/config/config.json";

const whatsappNumber = config.params.whatsapp.number.replace(/\D/g, "");
const whatsappMessage = encodeURIComponent("Hi Switchlivo, I'd like to discuss a smart panel project.");
const whatsappHref = config.params.whatsapp.enable
  ? `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`
  : "/contact";
---
<section class="home-inquiry" aria-labelledby="home-inquiry-title">
  <div class="home-inquiry-shell">
    <span class="home-inquiry-kicker"><span>06</span> READY WHEN YOU ARE</span>
    <h2 id="home-inquiry-title">Tell us about your project.<br /><em>We'll take it from there.</em></h2>
    <p class="home-inquiry-lede">Send your product list or project brief today — a factory-direct quotation and sample plan will follow.</p>
    <div class="home-inquiry-actions">
      <a class="home-inquiry-button primary" href="/contact">
        <strong>Get a Quotation</strong>
        <b aria-hidden="true">↗</b>
      </a>
      <a class="home-inquiry-button ghost" href={whatsappHref} target={config.params.whatsapp.enable ? "_blank" : undefined} rel={config.params.whatsapp.enable ? "noreferrer" : undefined}>
        <strong>WhatsApp Us</strong>
        <b aria-hidden="true">↗</b>
      </a>
    </div>
    <div class="home-inquiry-contact">
      <a class="home-inquiry-line" href={`mailto:${config.params.email}`}>
        <small>EMAIL</small>
        <strong>{config.params.email}</strong>
      </a>
      <a class="home-inquiry-line" href={whatsappHref} target={config.params.whatsapp.enable ? "_blank" : undefined} rel={config.params.whatsapp.enable ? "noreferrer" : undefined}>
        <small>WHATSAPP</small>
        <strong>{config.params.phone}</strong>
      </a>
      <div class="home-inquiry-line static">
        <small>FACTORY</small>
        <strong>广东省佛山市顺德区伦教街道振华中路1号顺汇园</strong>
        <span class="home-inquiry-addr-en">Lunjiao, Shunde District, Foshan, Guangdong, China</span>
      </div>
    </div>
  </div>
</section>

<style>
  .home-inquiry{padding:clamp(84px,10vw,132px) 0;background:#10161b;color:#fff;text-align:center}
  .home-inquiry-shell{width:min(980px,calc(100% - 48px));margin-inline:auto}
  .home-inquiry-kicker{display:inline-flex;align-items:center;gap:11px;color:#f0a17f;font-size:10px;font-weight:800;letter-spacing:.16em}
  .home-inquiry-kicker>span{color:rgba(255,255,255,.4)}
  .home-inquiry h2{margin:20px 0 0;color:#fff;font-size:clamp(38px,5.4vw,66px);line-height:1.04;letter-spacing:-.05em}
  .home-inquiry h2 em{font-style:normal;color:#FE6019}
  .home-inquiry-lede{max-width:560px;margin:20px auto 0;color:rgba(255,255,255,.62);font-size:15px;line-height:1.75}
  .home-inquiry-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:32px}
  .home-inquiry-button{display:inline-flex;align-items:center;justify-content:space-between;gap:26px;border-radius:10px;padding:15px 22px;color:#fff;text-decoration:none;min-height:48px;transition:transform .2s,background .2s,border-color .2s}
  .home-inquiry-button strong{font-size:14px;font-weight:750;letter-spacing:.01em}
  .home-inquiry-button b{font-size:17px}
  .home-inquiry-button.primary{background:#B84311;border:1px solid #B84311}
  .home-inquiry-button.primary:hover{background:#AA3C0A;transform:translateY(-2px)}
  .home-inquiry-button.primary b{color:#fff}
  .home-inquiry-button.ghost{border:1px solid rgba(255,255,255,.35)}
  .home-inquiry-button.ghost:hover{transform:translateY(-2px);border-color:#f0a17f}
  .home-inquiry-button.ghost b{color:#f0a17f}
  .home-inquiry-contact{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;margin-top:64px;padding-top:34px;border-top:1px solid rgba(255,255,255,.14);text-align:left}
  .home-inquiry-line{display:block;color:#fff;text-decoration:none}
  .home-inquiry-line small{display:block;color:#f0a17f;font-size:9px;font-weight:800;letter-spacing:.16em;margin-bottom:8px}
  .home-inquiry-line strong{font-size:14px;font-weight:750;line-height:1.55;word-break:break-word}
  a.home-inquiry-line:hover strong{color:#f0a17f}
  .home-inquiry-addr-en{display:block;margin-top:4px;color:rgba(255,255,255,.55);font-size:12px;font-weight:500}
  .home-inquiry-button:focus-visible,a.home-inquiry-line:focus-visible{outline:2px solid #f0a17f;outline-offset:4px}
  @media(prefers-reduced-motion:reduce){.home-inquiry-button{transition:none}.home-inquiry-button:hover{transform:none}}
  @media(max-width:760px){.home-inquiry-shell{width:min(100% - 36px,580px)}.home-inquiry-contact{grid-template-columns:1fr;gap:22px;margin-top:48px}}
</style>
