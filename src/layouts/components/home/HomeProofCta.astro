---
import config from "@/config/config.json";

const whatsappNumber = config.params.whatsapp.number.replace(/\D/g, "");
const whatsappMessage = encodeURIComponent("Hi Switchlivo, I'd like to discuss a smart panel project.");
const whatsappHref = config.params.whatsapp.enable
  ? `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`
  : "/contact";
---
<section class="home-inquiry" aria-labelledby="home-inquiry-title">
  <div class="home-inquiry-shell">
    <div class="home-inquiry-panel">
      <div class="home-inquiry-copy">
        <span class="home-inquiry-kicker"><span>06</span> READY WHEN YOU ARE</span>
        <h2 id="home-inquiry-title">Tell us about your project.<br /><em>We'll take it from there.</em></h2>
        <p>Send your product list or project brief today — a factory-direct quotation and sample plan will follow.</p>
        <div class="home-inquiry-actions">
          <a class="home-inquiry-button primary" href="/contact">
            <strong>Get a Quotation</strong>
            <b aria-hidden="true">↗</b>
          </a>
          <a class="home-inquiry-button ghost" href={whatsappHref} target={config.params.whatsapp.enable ? "_blank" : undefined} rel={config.params.whatsapp.enable ? "noreferrer" : undefined}>
            <strong>WhatsApp Us</strong>
            <b aria-hidden="true">↗</b>
          </a>
        </div>
      </div>
      <div class="home-inquiry-contact">
        <span class="home-inquiry-contact-label">CONTACT · SWITCHLIVO</span>
        <a class="home-inquiry-line" href={`mailto:${config.params.email}`}>
          <small>EMAIL</small>
          <strong>{config.params.email}</strong>
        </a>
        <a class="home-inquiry-line" href={whatsappHref} target={config.params.whatsapp.enable ? "_blank" : undefined} rel={config.params.whatsapp.enable ? "noreferrer" : undefined}>
          <small>WHATSAPP</small>
          <strong>{config.params.phone}</strong>
        </a>
        <div class="home-inquiry-line static">
          <small>FACTORY ADDRESS</small>
          <strong>广东省佛山市顺德区伦教街道振华中路1号顺汇园</strong>
          <span class="home-inquiry-addr-en">Lunjiao, Shunde District, Foshan, Guangdong, China</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .home-inquiry{padding:18px 0 clamp(78px,9vw,116px);background:#fff;color:#1a202c}
  .home-inquiry-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}
  .home-inquiry-panel{display:grid;grid-template-columns:1.05fr .85fr;gap:60px;align-items:center;border-radius:18px;background:#17232c;padding:clamp(30px,5vw,62px);color:#fff}
  .home-inquiry-kicker{display:inline-flex;align-items:center;gap:11px;color:#f0a17f;font-size:10px;font-weight:800;letter-spacing:.16em}
  .home-inquiry-kicker>span{color:#ffffff80}
  .home-inquiry h2{margin:17px 0 13px;color:#fff;font-size:clamp(38px,4.6vw,58px);line-height:1.05;letter-spacing:-.045em}
  .home-inquiry h2 em{font-style:normal;color:#f0a17f}
  .home-inquiry-copy>p{max-width:460px;margin:0;color:#d1d7da;font-size:14px;line-height:1.75}
  .home-inquiry-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
  .home-inquiry-button{display:inline-flex;align-items:center;justify-content:space-between;gap:22px;border-radius:10px;padding:15px 20px;color:#fff;text-decoration:none;min-height:44px;transition:transform .2s,background .2s,border-color .2s}
  .home-inquiry-button strong{font-size:14px;font-weight:750;letter-spacing:.01em}
  .home-inquiry-button b{font-size:17px}
  .home-inquiry-button.primary{background:#B84311;border:1px solid #B84311}
  .home-inquiry-button.primary:hover{background:#AA3C0A;transform:translateY(-2px)}
  .home-inquiry-button.primary b{color:#fff}
  .home-inquiry-button.ghost{border:1px solid #ffffff35}
  .home-inquiry-button.ghost:hover{transform:translateY(-2px);border-color:#f0a17f}
  .home-inquiry-button.ghost b{color:#f0a17f}
  .home-inquiry-contact{border:1px solid #ffffff1f;border-radius:12px;background:rgba(255,255,255,.045);padding:22px 24px}
  .home-inquiry-contact-label{display:block;color:#f0a17f;font-size:9px;font-weight:800;letter-spacing:.16em;margin-bottom:6px}
  .home-inquiry-line{display:block;padding:14px 0;border-bottom:1px solid #ffffff1a;color:#fff;text-decoration:none}
  .home-inquiry-line:last-child{border-bottom:0}
  .home-inquiry-line small{display:block;color:#ffffff66;font-size:9px;font-weight:800;letter-spacing:.14em;margin-bottom:6px}
  .home-inquiry-line strong{font-size:15px;font-weight:750;line-height:1.5}
  a.home-inquiry-line:hover strong{color:#f0a17f}
  .home-inquiry-addr-en{display:block;margin-top:4px;color:#ffffff80;font-size:12px;font-weight:500}
  .home-inquiry-button:focus-visible,a.home-inquiry-line:focus-visible{outline:2px solid #f0a17f;outline-offset:4px}
  @media(prefers-reduced-motion:reduce){.home-inquiry-button{transition:none}.home-inquiry-button:hover{transform:none}}
  @media(max-width:860px){.home-inquiry-panel{grid-template-columns:1fr;gap:30px;padding:30px 22px}.home-inquiry h2{font-size:clamp(34px,9vw,48px)}}
  @media(max-width:760px){.home-inquiry-shell{width:min(100% - 36px,580px)}}
</style>
