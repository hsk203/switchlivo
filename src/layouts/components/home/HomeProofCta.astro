---
import config from "@/config/config.json";

const whatsappNumber = config.params.whatsapp.number.replace(/\D/g, "");
const catalogueMessage = encodeURIComponent("Hi Switchlivo, I'd like to request the product catalogue.");
const catalogueHref = config.params.whatsapp.enable
  ? `https://wa.me/${whatsappNumber}?text=${catalogueMessage}`
  : "/contact";
---
<section class="home-inquiry" aria-labelledby="home-inquiry-title">
  <div class="home-inquiry-shell">
    <div class="home-inquiry-panel">
      <div class="home-inquiry-copy">
        <span class="home-inquiry-kicker"><span>05</span> START A CONVERSATION</span>
        <h2 id="home-inquiry-title">What are you<br /><em>building next?</em></h2>
        <p>Tell us about your target market, product interests or project. We’ll help you start with the right conversation.</p>
        <a class="home-inquiry-email" href={`mailto:${config.params.email}`}>{config.params.email} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="home-inquiry-actions">
        <a class="home-inquiry-button primary" href={catalogueHref} target={config.params.whatsapp.enable ? "_blank" : undefined} rel={config.params.whatsapp.enable ? "noreferrer" : undefined}>
          <span><small>FOR PRODUCT SELECTION</small><strong>Request the product catalogue</strong></span>
          <b aria-hidden="true">↗</b>
        </a>
        <a class="home-inquiry-button secondary" href="/contact">
          <span><small>FOR BRANDS &amp; PROJECTS</small><strong>Discuss OEM / ODM</strong></span>
          <b aria-hidden="true">↗</b>
        </a>
        <p class="home-inquiry-note">Product options and compatibility are confirmed by model and project requirements.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .home-inquiry{padding:18px 0 clamp(78px,9vw,116px);background:#fff;color:#1a202c}
  .home-inquiry-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}
  .home-inquiry-panel{display:grid;grid-template-columns:1fr .75fr;gap:70px;align-items:center;border-radius:18px;background:#17232c;padding:clamp(30px,5vw,62px);color:#fff}
  .home-inquiry-kicker{display:inline-flex;align-items:center;gap:11px;color:#f0a17f;font-size:10px;font-weight:800;letter-spacing:.16em}
  .home-inquiry-kicker>span{color:#ffffff80}
  .home-inquiry h2{margin:17px 0 13px;color:#fff;font-size:clamp(38px,5vw,62px);line-height:1.03;letter-spacing:-.05em}
  .home-inquiry h2 em{font-style:normal;color:#f0a17f}
  .home-inquiry-copy>p{max-width:450px;margin:0;color:#d1d7da;font-size:14px;line-height:1.75}
  .home-inquiry-email{display:inline-flex;align-items:center;gap:9px;margin-top:23px;color:#fff;font-size:12px;font-weight:700;text-decoration:none}
  .home-inquiry-email span{color:#f0a17f}
  .home-inquiry-actions{display:flex;flex-direction:column;gap:10px}
  .home-inquiry-button{display:flex;align-items:center;justify-content:space-between;gap:18px;border:1px solid #ffffff35;border-radius:10px;padding:17px 18px;color:#fff;text-decoration:none;transition:transform .2s,border-color .2s,background .2s}
  .home-inquiry-button:hover{transform:translateY(-2px);border-color:#f0a17f}
  @media(prefers-reduced-motion:reduce){.home-inquiry-button:hover{transform:none}}
  .home-inquiry-button.primary{border-color:#B84311;background:#B84311}
  .home-inquiry-button.primary:hover{background:#AA3C0A}
  .home-inquiry-button span{display:flex;flex-direction:column;gap:5px}
  .home-inquiry-button small{color:#fff;font-size:8px;font-weight:800;letter-spacing:.14em}
  .home-inquiry-button strong{font-size:14px;line-height:1.3}
  .home-inquiry-button b{color:#f0a17f;font-size:19px}
  .home-inquiry-button.primary b{color:#fff}
  .home-inquiry-button:focus-visible,.home-inquiry-email:focus-visible{outline:2px solid #f0a17f;outline-offset:4px}
  .home-inquiry-note{margin:5px 0 0;color:#c0c8cc;font-size:10px;line-height:1.6}
  @media(max-width:760px){.home-inquiry-shell{width:min(100% - 36px,580px)}.home-inquiry-panel{grid-template-columns:1fr;gap:28px;padding:30px 22px}.home-inquiry h2{font-size:clamp(38px,10vw,52px)}}
  @media(prefers-reduced-motion:reduce){.home-inquiry-button{transition:none}}
</style>
