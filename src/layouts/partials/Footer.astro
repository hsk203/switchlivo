---
import Logo from "@/components/Logo.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
const { footer } = menu;
const { email, phone, footer_description, whatsapp } = config.params;
const year = new Date().getFullYear();
const phonePretty = "+852 6419 0941";
const whatsappUrl = `https://wa.me/${whatsapp.number}?text=${encodeURIComponent(whatsapp.message)}`;
---

<footer class="footer bg-light">
  <div class="container">
    <div class="gx-5 row pb-10 pt-[52px]">
      <div class="col-12 mt-12 md:col-6 lg:col-3">
        <Logo />
        <p class="mt-6">
          {footer_description}
        </p>
        <p class="mt-4 text-sm">Saudi Arabia · UAE · Southeast Asia</p>
      </div>
      <div class="col-12 mt-12 md:col-6 lg:col-3">
        <h6>Solutions</h6>
        <ul>
          <li class="mb-4">
            <a class="hover:text-primary hover:underline" href="/solutions">Whole-Home Solutions</a>
          </li>
          <li class="mb-4">
            <a class="hover:text-primary hover:underline" href="/solutions">Smart Hotel Solutions</a>
          </li>
          <li>
            <a class="hover:text-primary hover:underline" href="/products">Product Catalog</a>
          </li>
        </ul>
      </div>
      <div class="col-12 mt-12 md:col-6 lg:col-3">
        <h6>Quick Links</h6>
        <ul>
          {
            footer.map((item, i) => (
              <li class={footer.length - 1 === i ? "mb-0" : "mb-4"}>
                <a class="hover:text-primary hover:underline" href={item.url}>
                  {item.name}
                </a>
              </li>
            ))
          }
          <li class="mt-4">
            <a class="hover:text-primary hover:underline" href="/blog">Blog</a>
          </li>
        </ul>
      </div>
      <div class="col-12 mt-12 md:col-6 lg:col-3">
        <h6>Contact</h6>
        <ul>
          <li class="mb-2">
            <a class="hover:text-primary" href={`mailto:${email}`}>{email}</a>
          </li>
          <li class="mb-2">
            <a class="hover:text-primary hover:underline" href={`tel:${phone}`}>{phonePretty}</a>
          </li>
          <li>
            <a class="hover:text-primary hover:underline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
          </li>
        </ul>
      </div>
    </div>
  </div>
  <div class="container max-w-[1440px]">
    <div class="footer-copyright mx-auto border-t border-border pb-10 pt-7 text-center">
      <p class="content text-text">Copyright © {year} Switchlivo. All rights reserved.</p>
    </div>
  </div>
</footer>
