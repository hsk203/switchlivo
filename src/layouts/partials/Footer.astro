---
import config from "@/config/config.json";

const { email, phone, footer_description, whatsapp } = config.params;
const year = new Date().getFullYear();
const phonePretty = "+852 6419 0941";
const whatsappUrl = `https://wa.me/${whatsapp.number}?text=${encodeURIComponent(whatsapp.message)}`;

const productLinks = [
  { name: "Smart Light Switches", url: "/products" },
  { name: "Touch Control Panels", url: "/products" },
  { name: "Hotel Room Controls", url: "/solutions" },
  { name: "Product Catalog", url: "/products" },
];

const solutionLinks = [
  { name: "Smart Home Projects", url: "/solutions" },
  { name: "Smart Hotel Projects", url: "/solutions" },
  { name: "OEM & ODM", url: "/contact" },
  { name: "Distributor Support", url: "/contact" },
];

const companyLinks = [
  { name: "About Switchlivo", url: "/about" },
  { name: "Insights & Blog", url: "/blog" },
  { name: "Contact Us", url: "/contact" },
];
---

<footer class="switchlivo-footer">
  <div class="footer-shell">
    <div class="footer-intro">
      <div class="footer-intro-copy">
        <span class="footer-kicker"><span class="kicker-line"></span> LET'S BUILD BETTER SPACES</span>
        <h2>Make every space<br /><span>smarter by design.</span></h2>
        <p>Looking for a dependable smart switch partner? Tell us about your market, project or OEM / ODM requirements.</p>
      </div>
      <a class="footer-cta" href="/contact">
        <span>Start a conversation</span>
        <span class="cta-arrow" aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="footer-main">
      <section class="footer-brand" aria-label="About Switchlivo">
        <a href="/" class="footer-wordmark" aria-label="Switchlivo home">
          <span class="wordmark-symbol" aria-hidden="true"><span></span></span>
          <span>Switch<span class="wordmark-light">livo</span></span>
        </a>
        <p class="brand-description">{footer_description}</p>
        <div class="brand-focus">
          <span class="focus-dot" aria-hidden="true"></span>
          <p>Supporting distributors and project partners across the Middle East and Southeast Asia.</p>
        </div>
        <p class="brand-protocols">Wi-Fi&nbsp; · &nbsp;Zigbee&nbsp; · &nbsp;Matter&nbsp; · &nbsp;Tuya&nbsp; · &nbsp;KNX&nbsp; · &nbsp;BLE Mesh</p>
      </section>

      <nav class="footer-nav" aria-label="Products">
        <h3>Explore</h3>
        <ul>
          {productLinks.map((item) => <li><a href={item.url}>{item.name}<span aria-hidden="true">↗</span></a></li>)}
        </ul>
      </nav>

      <nav class="footer-nav" aria-label="Solutions">
        <h3>Solutions</h3>
        <ul>
          {solutionLinks.map((item) => <li><a href={item.url}>{item.name}<span aria-hidden="true">↗</span></a></li>)}
        </ul>
      </nav>

      <nav class="footer-nav" aria-label="Company">
        <h3>Company</h3>
        <ul>
          {companyLinks.map((item) => <li><a href={item.url}>{item.name}<span aria-hidden="true">↗</span></a></li>)}
        </ul>
      </nav>

      <section class="footer-contact" aria-label="Contact Switchlivo">
        <span class="contact-eyebrow">HAVE A PROJECT IN MIND?</span>
        <h3>Talk to our team.</h3>
        <a class="contact-detail" href={`mailto:${email}`}>{email}<span aria-hidden="true">↗</span></a>
        <a class="contact-detail" href={`tel:${phone}`}>{phonePretty}<span aria-hidden="true">↗</span></a>
        {whatsapp.enable && (
          <a class="whatsapp-link" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20.52 3.48A11.82 11.82 0 0 0 12.08 0C5.5 0 .15 5.34.15 11.92c0 2.1.55 4.16 1.6 5.97L.05 24l6.26-1.64a11.9 11.9 0 0 0 5.76 1.47h.01c6.57 0 11.92-5.35 11.92-11.92 0-3.19-1.24-6.19-3.48-8.43ZM12.08 21.8a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.72.98.99-3.63-.24-.37a9.83 9.83 0 0 1-1.52-5.27c0-5.47 4.45-9.92 9.92-9.92a9.86 9.86 0 0 1 7.02 2.91 9.86 9.86 0 0 1 2.9 7.02c0 5.47-4.45 9.92-9.92 9.92Zm5.45-7.43c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.96 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.18-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.08-.8.38-.28.3-1.05 1.02-1.05 2.49 0 1.47 1.07 2.89 1.22 3.09.15.2 2.1 3.21 5.09 4.5.71.31 1.27.5 1.7.64.72.23 1.37.2 1.88.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.18-1.42-.08-.13-.28-.2-.58-.35Z"/></svg>
            <span>{whatsapp.label}</span>
            <span class="whatsapp-arrow" aria-hidden="true">↗</span>
          </a>
        )}
      </section>
    </div>

    <div class="footer-bottom">
      <p>© {year} Switchlivo. All rights reserved.</p>
      <div class="footer-bottom-right">
        <span>SMART CONTROL. THOUGHTFUL DESIGN.</span>
        <a href="/contact">Contact <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</footer>

<style>
  .switchlivo-footer {
    --footer-bg: #111b24;
    --footer-panel: #17242e;
    --footer-text: #f3f1eb;
    --footer-muted: #aab5bd;
    --footer-dim: #71808a;
    --footer-accent: #e96b3a;
    background: var(--footer-bg);
    color: var(--footer-text);
    position: relative;
    overflow: hidden;
  }
  .switchlivo-footer::before {
    content: "";
    position: absolute;
    width: 520px;
    height: 520px;
    top: -340px;
    right: 8%;
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 50%;
    box-shadow: 0 0 0 55px rgba(255,255,255,.018), 0 0 0 110px rgba(255,255,255,.012);
    pointer-events: none;
  }
  .footer-shell { max-width: 1440px; margin: 0 auto; padding: 0 32px; position: relative; }
  .footer-intro { display:flex; align-items:flex-end; justify-content:space-between; gap:36px; padding:76px 0 58px; border-bottom:1px solid rgba(255,255,255,.12); }
  .footer-kicker,.contact-eyebrow { display:flex; align-items:center; gap:11px; color:#d6a18a; font-size:10px; font-weight:700; letter-spacing:.19em; }
  .kicker-line { width:25px; height:1px; background:var(--footer-accent); }
  .footer-intro h2 { margin:22px 0 14px; color:var(--footer-text); font-size:clamp(34px,4.2vw,58px); line-height:1.06; letter-spacing:-.045em; font-weight:600; }
  .footer-intro h2 span { color:#9eabb3; }
  .footer-intro-copy > p { max-width:570px; margin:0; color:var(--footer-muted); font-size:15px; line-height:1.8; }
  .footer-cta { display:inline-flex; align-items:center; gap:34px; flex-shrink:0; padding:17px 20px 17px 24px; border:1px solid rgba(233,107,58,.75); border-radius:3px; color:#fff; font-size:13px; font-weight:600; transition:background .2s ease,border-color .2s ease,transform .2s ease; }
  .footer-cta:hover { background:var(--footer-accent); border-color:var(--footer-accent); transform:translateY(-2px); }
  .cta-arrow { font-size:19px; line-height:1; color:#f29a76; }
  .footer-main { display:grid; grid-template-columns:minmax(230px,1.65fr) repeat(3,minmax(120px,.85fr)) minmax(210px,1.15fr); gap:38px; padding:58px 0 62px; }
  .footer-wordmark { display:inline-flex; align-items:center; gap:11px; color:#fff; font-size:27px; line-height:1; font-weight:750; letter-spacing:-1.2px; }
  .wordmark-light { color:#aeb9c0; font-weight:450; }
  .wordmark-symbol { width:25px; height:25px; border:1.7px solid var(--footer-accent); border-radius:8px; display:grid; place-items:center; transform:rotate(-8deg); }
  .wordmark-symbol span { width:9px; height:9px; border:1.5px solid var(--footer-accent); border-radius:50%; position:relative; }
  .wordmark-symbol span::after { content:""; position:absolute; width:1.5px; height:6px; background:var(--footer-accent); left:3px; top:-5px; }
  .brand-description { max-width:330px; margin:22px 0 20px; color:var(--footer-muted); font-size:13px; line-height:1.85; }
  .brand-focus { display:flex; align-items:flex-start; gap:10px; max-width:340px; }
  .brand-focus p { margin:0; color:#e1e5e7; font-size:12px; line-height:1.7; }
  .focus-dot { width:6px; height:6px; margin-top:7px; flex:0 0 6px; border-radius:50%; background:#83b9a2; box-shadow:0 0 0 4px rgba(131,185,162,.12); }
  .brand-protocols { margin:20px 0 0; color:var(--footer-dim); font-size:10px; line-height:1.8; letter-spacing:.035em; }
  .footer-nav h3,.footer-contact h3 { margin:3px 0 22px; color:#fff; font-size:11px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; }
  .footer-nav ul { display:grid; gap:15px; margin:0; padding:0; list-style:none; }
  .footer-nav a { display:flex; align-items:center; justify-content:space-between; gap:8px; color:var(--footer-muted); font-size:12px; line-height:1.5; transition:color .2s ease; }
  .footer-nav a span { opacity:0; color:var(--footer-accent); transition:opacity .2s ease,transform .2s ease; transform:translate(-3px,3px); }
  .footer-nav a:hover { color:#fff; }
  .footer-nav a:hover span { opacity:1; transform:translate(0,0); }
  .footer-contact { padding:22px 20px 20px; margin-top:-12px; background:var(--footer-panel); border:1px solid rgba(255,255,255,.07); }
  .contact-eyebrow { color:#aab5bd; font-size:9px; letter-spacing:.13em; }
  .footer-contact h3 { margin:12px 0 20px; font-size:20px; font-weight:550; letter-spacing:-.02em; text-transform:none; }
  .contact-detail { display:flex; justify-content:space-between; gap:10px; padding:10px 0; border-bottom:1px solid rgba(255,255,255,.08); color:var(--footer-muted); font-size:12px; transition:color .2s ease; }
  .contact-detail span { color:var(--footer-dim); }
  .contact-detail:hover { color:#fff; }
  .whatsapp-link { display:flex; align-items:center; gap:9px; margin-top:18px; padding:12px 13px; border:1px solid rgba(89,190,139,.42); color:#d9eee3; font-size:12px; font-weight:600; transition:background .2s ease,border-color .2s ease; }
  .whatsapp-link:hover { background:rgba(37,211,102,.09); border-color:#59be8b; }
  .whatsapp-link svg { width:16px; height:16px; fill:#59be8b; flex:0 0 16px; }
  .whatsapp-arrow { margin-left:auto; color:#8bbfa3; font-size:16px; }
  .footer-bottom { display:flex; justify-content:space-between; align-items:center; gap:20px; min-height:68px; border-top:1px solid rgba(255,255,255,.12); color:var(--footer-dim); font-size:11px; }
  .footer-bottom p { margin:0; }
  .footer-bottom-right { display:flex; align-items:center; gap:28px; }
  .footer-bottom-right > span { font-size:9px; letter-spacing:.15em; }
  .footer-bottom a { color:var(--footer-muted); transition:color .2s ease; }
  .footer-bottom a:hover { color:#fff; }
  @media (max-width:1100px) {
    .footer-main { grid-template-columns:1.4fr 1fr 1fr; gap:38px 30px; }
    .footer-brand { grid-column:span 3; }
    .footer-contact { margin-top:0; }
  }
  @media (max-width:700px) {
    .footer-shell { padding:0 22px; }
    .footer-intro { align-items:flex-start; flex-direction:column; padding:55px 0 42px; gap:26px; }
    .footer-intro h2 { font-size:39px; }
    .footer-intro-copy > p { font-size:13px; }
    .footer-cta { width:100%; justify-content:space-between; }
    .footer-main { grid-template-columns:1fr 1fr; gap:36px 22px; padding:42px 0; }
    .footer-brand { grid-column:span 2; }
    .footer-contact { grid-column:span 2; }
    .footer-bottom { align-items:flex-start; flex-direction:column; justify-content:center; padding:20px 0; gap:10px; }
    .footer-bottom-right { width:100%; justify-content:space-between; gap:12px; }
    .footer-bottom-right > span { font-size:8px; }
  }
  @media (prefers-reduced-motion:reduce) {
    .switchlivo-footer * { transition:none !important; }
  }
</style>
