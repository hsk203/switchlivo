---
import config from "@/config/config.json";

const { email, phone, footer_description, whatsapp } = config.params;
const year = new Date().getFullYear();
const phonePretty = "+852 6419 0941";
const whatsappUrl = `https://wa.me/${whatsapp.number}?text=${encodeURIComponent(whatsapp.message)}`;

const productLinks = [
  { name: "Smart Light Switches", url: "/products" },
  { name: "Touch Control Panels", url: "/products" },
  { name: "Hotel Room Controls", url: "/solutions" },
  { name: "Browse Product Catalog", url: "/products" },
];

const solutionLinks = [
  { name: "Smart Home Projects", url: "/solutions" },
  { name: "Smart Hotel Projects", url: "/solutions" },
  { name: "OEM & ODM", url: "/contact" },
  { name: "Distributor Support", url: "/contact" },
];

const companyLinks = [
  { name: "About Switchlivo", url: "/about" },
  { name: "Insights & Blog", url: "/blog" },
  { name: "Contact Us", url: "/contact" },
];

const linkClass =
  "text-sm text-[#595959] transition-colors hover:text-primary focus-visible:text-primary";
const headingClass =
  "mb-5 text-sm font-semibold uppercase tracking-[0.12em] text-text-dark";
---

<footer class="border-t border-border bg-light text-text-dark">
  <div class="container max-w-[1440px]">
    <div class="border-b border-border py-10 md:py-12">
      <div
        class="flex flex-col gap-6 rounded-2xl border border-border bg-body p-6 md:flex-row md:items-center md:justify-between md:p-8"
      >
        <div class="max-w-2xl">
          <p
            class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-primary"
          >
            For distributors &amp; projects
          </p>
          <h2
            class="mb-3 text-2xl font-bold leading-tight text-text-dark md:text-3xl"
          >
            Looking for a smart switch OEM/ODM partner?
          </h2>
          <p
            class="mb-0 max-w-xl text-sm leading-6 text-[#595959] md:text-base"
          >
            Explore our smart switch range or tell us about your market, project
            and customization needs.
          </p>
        </div>
        <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
          <a
            class="inline-flex min-h-12 items-center justify-center rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-[#e65312] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            href="/products">Browse Products</a
          >
          <a
            class="inline-flex min-h-12 items-center justify-center rounded-full border border-text-dark/20 px-6 py-3 text-sm font-semibold text-text-dark transition hover:border-primary hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            href="/contact">Request a Quote</a
          >
        </div>
      </div>
    </div>

    <div
      class="grid grid-cols-1 gap-x-8 gap-y-10 py-10 sm:grid-cols-2 lg:grid-cols-6 lg:py-12"
    >
      <div class="sm:col-span-2 lg:col-span-2">
        <a
          href="/"
          class="mb-5 inline-flex text-2xl font-bold tracking-tight text-text-dark transition-colors hover:text-primary"
          aria-label="Switchlivo home"
        >
          {config.site.logo_text || "Switchlivo"}
        </a>
        <p class="mb-5 max-w-sm text-sm leading-6 text-[#595959]">
          {footer_description}
        </p>
        <p class="mb-3 text-sm font-medium leading-6 text-text-dark">
          Serving distributors and projects worldwide, with a focus on Saudi
          Arabia, the UAE and Southeast Asia.
        </p>
        <p class="mb-0 max-w-sm text-xs leading-5 text-[#666666]">
          Protocol options include Wi-Fi, Zigbee, Matter, Tuya, KNX and BLE
          Mesh. Confirm model and market requirements with our team.
        </p>
      </div>

      <nav aria-label="Products">
        <h3 class={headingClass}>Products</h3>
        <ul class="space-y-3">
          {
            productLinks.map((item) => (
              <li>
                <a class={linkClass} href={item.url}>
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Solutions">
        <h3 class={headingClass}>Solutions</h3>
        <ul class="space-y-3">
          {
            solutionLinks.map((item) => (
              <li>
                <a class={linkClass} href={item.url}>
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Company">
        <h3 class={headingClass}>Company</h3>
        <ul class="space-y-3">
          {
            companyLinks.map((item) => (
              <li>
                <a class={linkClass} href={item.url}>
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h3 class={headingClass}>Talk to our team</h3>
        <ul class="mb-5 space-y-3">
          <li><a class={linkClass} href={`mailto:${email}`}>{email}</a></li>
          <li><a class={linkClass} href={`tel:${phone}`}>{phonePretty}</a></li>
        </ul>
        {
          whatsapp.enable && (
            <a
              class="inline-flex items-center gap-2 rounded-full border border-[#25D366]/50 px-4 py-2.5 text-sm font-semibold text-text-dark transition hover:border-[#25D366] hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                class="h-4 w-4 fill-current text-[#1c9c4b]"
              >
                <path d="M20.52 3.48A11.82 11.82 0 0 0 12.08 0C5.5 0 .15 5.34.15 11.92c0 2.1.55 4.16 1.6 5.97L.05 24l6.26-1.64a11.9 11.9 0 0 0 5.76 1.47h.01c6.57 0 11.92-5.35 11.92-11.92 0-3.19-1.24-6.19-3.48-8.43ZM12.08 21.8a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.72.98.99-3.63-.24-.37a9.83 9.83 0 0 1-1.52-5.27c0-5.47 4.45-9.92 9.92-9.92a9.86 9.86 0 0 1 7.02 2.91 9.86 9.86 0 0 1 2.9 7.02c0 5.47-4.45 9.92-9.92 9.92Zm5.45-7.43c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.96 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.18-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.08-.8.38-.28.3-1.05 1.02-1.05 2.49 0 1.47 1.07 2.89 1.22 3.09.15.2 2.1 3.21 5.09 4.5.71.31 1.27.5 1.7.64.72.23 1.37.2 1.88.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.18-1.42-.08-.13-.28-.2-.58-.35Z" />
              </svg>
              {whatsapp.label}
            </a>
          )
        }
      </div>
    </div>

    <div
      class="flex flex-col gap-3 border-t border-border py-6 text-xs text-[#666666] sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="mb-0">Copyright © {year} Switchlivo. All rights reserved.</p>
      <a class="w-fit transition-colors hover:text-primary" href="/contact"
        >Contact our team</a
      >
    </div>
  </div>
</footer>
