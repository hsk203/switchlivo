{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "page_title": {
      "type": "string"
    },
    "meta_title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "category_label": {
      "type": "string"
    },
    "region": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protocol": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "series": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "featuredImage": {
      "type": "string"
    },
    "gallery": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "features": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "specs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "value"
        ]
      }
    },
    "oemOptions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inquiryCta": {
      "default": true,
      "type": "boolean"
    },
    "draft": {
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category",
    "featuredImage"
  ]
}